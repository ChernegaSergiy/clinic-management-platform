{% extends "layouts/public.html.twig" %}

{% block title %}{{ 'department.public.title'|trans }} — {{ clinic_name }}{% endblock %}

{% block body %}
    <section id="departments" class="section">
        <div class="container">
            <header class="section__header">
                <div class="section__eyebrow">{{ 'department.public.section_eyebrow'|trans }}</div>
                <h1 class="section__title">{{ 'department.public.section_title'|trans }}</h1>
                <p class="section__description">{{ 'department.public.section_description'|trans }}</p>
            </header>

            <div class="departments-grid">
                <div class="dept-info-block">
                    <h3>{{ 'department.public.info_block_title'|trans }}</h3>
                    <p>{{ 'department.public.planned_hospitalization'|trans|raw }}</p>
                    <p>{{ 'department.public.emergency_care'|trans|raw }}</p>
                    <p style="font-weight: 700;">{{ 'department.public.phone_info'|trans }}</p>
                </div>

                <div class="departments-list">
                    <div class="dept-category">{{ 'department.public.category_clinical'|trans }}</div>
                    
                    <article class="department-item">
                        <div class="department-item__name">{{ 'department.public.departments.reception.name'|trans }}</div>
                        <div class="department-item__meta">{{ 'department.public.departments.reception.meta'|trans }}</div>
                        <div class="department-item__status" style="color: var(--color-ok);">{{ 'department.public.departments.reception.status'|trans }}</div>
                    </article>
                    
                    <article class="department-item">
                        <div class="department-item__name">{{ 'department.public.departments.therapy.name'|trans }}</div>
                        <div class="department-item__meta">{{ 'department.public.departments.therapy.meta'|trans }}</div>
                        <div class="department-item__status" style="color: var(--color-ok);">{{ 'department.public.departments.therapy.status'|trans }}</div>
                    </article>
                    
                    <article class="department-item">
                        <div class="department-item__name">{{ 'department.public.departments.surgery.name'|trans }}</div>
                        <div class="department-item__meta">{{ 'department.public.departments.surgery.meta'|trans }}</div>
                        <div class="department-item__status" style="color: var(--color-ok);">{{ 'department.public.departments.surgery.status'|trans }}</div>
                    </article>
                    
                    <article class="department-item">
                        <div class="department-item__name">{{ 'department.public.departments.traumatology.name'|trans }}</div>
                        <div class="department-item__meta">{{ 'department.public.departments.traumatology.meta'|trans }}</div>
                        <div class="department-item__status" style="color: var(--color-ok);">{{ 'department.public.departments.traumatology.status'|trans }}</div>
                    </article>

                    <article class="department-item">
                        <div class.="department-item__name">{{ 'department.public.departments.anesthesiology.name'|trans }}</div>
                        <div class="department-item__meta">{{ 'department.public.departments.anesthesiology.meta'|trans }}</div>
                        <div class="department-item__status" style="color: var(--color-ok);">{{ 'department.public.departments.anesthesiology.status'|trans }}</div>
                    </article>
                    
                    <div class="dept-category" style="border-top: var(--border-thin); margin-top: 0.4rem;">{{ 'department.public.category_diagnostic'|trans }}</div>

                    <article class="department-item">
                        <div class="department-item__name">{{ 'department.public.departments.polyclinic.name'|trans }}</div>
                        <div class="department-item__meta">{{ 'department.public.departments.polyclinic.meta'|trans }}</div>
                        <div class="department-item__status" style="color: var(--color-ok);">{{ 'department.public.departments.polyclinic.status'|trans }}</div>
                    </article>
                    
                    <article class="department-item">
                        <div class="department-item__name">{{ 'department.public.departments.ultrasound.name'|trans }}</div>
                        <div class="department-item__meta">{{ 'department.public.departments.ultrasound.meta'|trans }}</div>
                        <div class="department-item__status" style="color: var(--color-ok);">{{ 'department.public.departments.ultrasound.status'|trans }}</div>
                    </article>
                    
                    <article class="department-item">
                        <div class="department-item__name">{{ 'department.public.departments.laboratory.name'|trans }}</div>
                        <div class="department-item__meta">{{ 'department.public.departments.laboratory.meta'|trans }}</div>
                        <div class="department-item__status" style="color: var(--color-ok);">{{ 'department.public.departments.laboratory.status'|trans }}</div>
                    </article>
                    
                </div>
            </div>
        </section>
{% endblock %}