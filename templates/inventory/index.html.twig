{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'inventory.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'inventory.list.title'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="{{ path('inventory_new_create') }}" class="ui primary button">
                    <i class="plus icon"></i> {{ 'inventory.list.add_item'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        {% if lowStockItems is not empty %}
            <div class="ui warning message">
                <div class="header">{{ 'inventory.list.low_stock_warning'|trans }}</div>
                <p>{{ 'inventory.list.low_stock_message'|trans }}</p>
                <ul class="list">
                    {% for item in lowStockItems %}
                        <li>{{ item.name }} ({{ 'inventory.list.quantity'|trans }}: {{ item.quantity }}, {{ 'inventory.list.min_threshold'|trans }}: {{ item.min_stock_level }})</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if overStockedItems is not empty %}
            <div class="ui info message">
                <div class="header">{{ 'inventory.list.over_stock_info'|trans }}</div>
                <p>{{ 'inventory.list.over_stock_message'|trans }}</p>
                <ul class="list">
                    {% for item in overStockedItems %}
                        <li>{{ item.name }} ({{ 'inventory.list.quantity'|trans }}: {{ item.quantity }}, {{ 'inventory.list.max_threshold'|trans }}: {{ item.max_stock_level }})</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form class="ui form" method="get" action="/inventory">
            <div class="field">
                <div class="ui icon input">
                    <input type="text" name="search" value="{{ searchTerm|default('') }}" placeholder="{{ 'inventory.list.search_placeholder'|trans }}">
                    <i class="search icon"></i>
                </div>
            </div>
        </form>

        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>{{ 'inventory.list.table.id'|trans }}</th>
                    <th>{{ 'inventory.list.table.name'|trans }}</th>
                    <th>{{ 'inventory.list.table.inn'|trans }}</th>
                    <th>{{ 'inventory.list.table.quantity'|trans }}</th>
                    <th>{{ 'inventory.list.table.min_stock_level'|trans }}</th>
                    <th>{{ 'inventory.list.table.expiry_date'|trans }}</th>
                    <th>{{ 'inventory.list.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.id }}</td>
                        <td>{{ item.name }}</td>
                        <td>{{ item.inn }}</td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ item.min_stock_level }}</td>
                        <td>{{ item.expiry_date }}</td>
                        <td>
                            <a href="/inventory/show?id={{ item.id }}" class="ui icon button">
                                <i class="eye icon"></i>
                            </a>
                            <a href="/inventory/edit?id={{ item.id }}" class="ui icon button">
                                <i class="edit icon"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="center aligned">{{ 'inventory.list.no_items'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
