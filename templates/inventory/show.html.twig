{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'inventory.show.title'|trans({'%id%': item.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'inventory.show.title_full'|trans({'%id%': item.id}) }}</h2>
        <div class="ui divider"></div>

        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td>{{ 'inventory.show.table.id'|trans }}</td>
                    <td>{{ item.id }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.name'|trans }}</td>
                    <td>{{ item.name }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.description'|trans }}</td>
                    <td>{{ item.description|nl2br|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.inn'|trans }}</td>
                    <td>{{ item.inn|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.batch_number'|trans }}</td>
                    <td>{{ item.batch_number|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.expiry_date'|trans }}</td>
                    <td>{{ item.expiry_date }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.supplier'|trans }}</td>
                    <td>{{ item.supplier|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.cost'|trans }}</td>
                    <td>{{ item.cost|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.quantity'|trans }}</td>
                    <td>{{ item.quantity|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.min_stock_level'|trans }}</td>
                    <td>{{ item.min_stock_level|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.max_stock_level'|trans }}</td>
                    <td>{{ item.max_stock_level|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.location'|trans }}</td>
                    <td>{{ item.location|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.created_at'|trans }}</td>
                    <td>{{ item.created_at|date('Y-m-d H:i') }}</td>
                </tr>
                <tr>
                    <td>{{ 'inventory.show.table.updated_at'|trans }}</td>
                    <td>{{ item.updated_at|date('Y-m-d H:i') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>

        <a href="/inventory/edit?id={{ item.id }}" class="ui primary button">
            <i class="edit icon"></i> {{ 'inventory.show.edit'|trans }}
        </a>
        <a href="{{ path('inventory_index') }}" class="ui button">
            <i class="arrow left icon"></i> {{ 'inventory.show.back'|trans }}
        </a>
    </div>

    <div class="ui segment">
        <h3 class="ui header">{{ 'inventory.show.movement_history'|trans }}</h3>
        
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'inventory.show.movements_table.movement_type'|trans }}</th>
                        <th>{{ 'inventory.show.movements_table.quantity_change'|trans }}</th>
                        <th>{{ 'inventory.show.movements_table.new_quantity'|trans }}</th>
                        <th>{{ 'inventory.show.movements_table.reason'|trans }}</th>
                        <th>{{ 'inventory.show.movements_table.user'|trans }}</th>
                        <th>{{ 'inventory.show.movements_table.date'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for movement in movementHistory %}
                        <tr>
                            <td>{{ movement.movement_type }}</td>
                            <td>{{ movement.quantity_change }}</td>
                            <td>{{ movement.new_quantity }}</td>
                            <td>{{ movement.reason ?: 'inventory.show.movements_table.not_specified'|trans }}</td>
                            <td>{{ movement.user_name ?: 'inventory.show.movements_table.system'|trans }}</td>
                            <td>{{ movement.created_at|date('Y-m-d H:i') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="center aligned">{{ 'inventory.show.no_movements'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
