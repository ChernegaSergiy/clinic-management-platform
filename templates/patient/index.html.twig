{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'patient.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'patient.list.title'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="{{ path('patient_export_csv') }}" class="ui secondary button">
                    <i class="file alternate outline icon"></i> {{ 'patient.list.export_csv'|trans }}
                </a>
                <a href="{{ path('patient_export_json') }}" class="ui secondary button">
                    <i class="file alternate outline icon"></i> {{ 'patient.list.export_json'|trans }}
                </a>
                <a href="{{ path('patient_import_json') }}" class="ui positive button">
                    <i class="upload icon"></i> {{ 'patient.list.import_json'|trans }}
                </a>
                <a href="{{ path('patient_create') }}" class="ui primary button">
                    <i class="plus icon"></i> {{ 'patient.list.add'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        <form class="ui form" method="GET" action="/patients">
            <div class="field">
                <div class="ui icon input">
                    <input type="text" name="search" placeholder="{{ 'patient.list.search_placeholder'|trans }}" value="{{ searchTerm ?? '' }}">
                    <i class="search icon"></i>
                </div>
            </div>
        </form>

        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>{{ 'patient.list.table.id'|trans }}</th>
                    <th>{{ 'patient.list.table.name'|trans }}</th>
                    <th>{{ 'patient.list.table.birth_date'|trans }}</th>
                    <th>{{ 'patient.list.table.phone'|trans }}</th>
                    <th>{{ 'patient.list.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for patient in patients %}
                    <tr>
                        <td>{{ patient.id }}</td>
                        <td>{{ patient.last_name }} {{ patient.first_name }}</td>
                        <td>{{ patient.birth_date }}</td>
                        <td>{{ patient.phone }}</td>
                        <td>
                            <a href="/patients/show?id={{ patient.id }}" class="ui icon button">
                                <i class="eye icon"></i>
                            </a>
                            <a href="/patients/edit?id={{ patient.id }}" class="ui icon button">
                                <i class="edit icon"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="center aligned">{{ 'patient.list.no_patients'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
