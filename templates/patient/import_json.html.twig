{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'patient.import_json.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'patient.import_json.header'|trans }}</h2>
        <div class="ui divider"></div>

        {% if success_message is defined and success_message %}
            <div class="ui success message">
                <div class="header">{{ 'patient.import_json.success_header'|trans }}</div>
                <p>{{ success_message }}</p>
            </div>
        {% endif %}

        {% if errors %}
            <div class="ui error message">
                <div class="header">{{ 'patient.import_json.error_header'|trans }}</div>
                <ul class="list">
                    {% for error in errors %}
                        {% if error is iterable %}
                            {% for e in error %}
                                <li>{{ e }}</li>
                            {% endfor %}
                        {% else %}
                            <li>{{ error }}</li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form class="ui form" method="POST" action="/patients/import-json" enctype="multipart/form-data">
            <div class="field">
                <label>{{ 'patient.import_json.file_label'|trans }}</label>
                <div class="ui action input">
                    <input type="text" id="json-file-display" readonly placeholder="{{ 'patient.import_json.file_placeholder'|trans }}">
                    <label for="json-file-input" class="ui button">{{ 'patient.import_json.choose_file_button'|trans }}</label>
                </div>
                <input type="file" id="json-file-input" name="json_file" accept=".json" style="display: none;">
            </div>

            {{ ui.button('patient.import_json.import_button'|trans, 'primary', 'large', 'upload') }}
            <a href="/patients" class="ui button">
                <i class="arrow left icon"></i> {{ 'patient.import_json.cancel_button'|trans }}
            </a>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fileInput = document.getElementById('json-file-input');
            const display = document.getElementById('json-file-display');

            if (fileInput && display) {
                fileInput.addEventListener('change', function() {
                    display.value = fileInput.files.length ? fileInput.files[0].name : '{{ 'patient.import_json.file_placeholder'|trans }}';
                });
            }
        });
    </script>
{% endblock %}
