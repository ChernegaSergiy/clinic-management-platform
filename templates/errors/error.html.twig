{% extends "layouts/public.html.twig" %}

{% block title %}Помилка — Клініка{% endblock %}

{% block body %}
    <section class="section">
        <div class="container" style="max-width: 600px; text-align: center; padding: 3rem 0;">
            <div class="section__eyebrow">Помилка</div>
            <h2 class="section__title section__title--large" style="margin-bottom: 1rem;">Щось пішло не так</h2>
            <p class="section__description" style="margin: 0 auto 1.5rem; max-width: 400px;">Ми не змогли відобразити цю сторінку. Спробуйте оновити або поверніться пізніше.</p>
            
            {% if message %}
                <p style="font-size: 0.85rem; opacity: 0.7; margin-bottom: 0.5rem;">{{ message }}</p>
            {% endif %}
            
            {% if detail %}
                <div style="border: var(--border-thin); background: var(--color-bg-alt); padding: 1rem; margin: 1rem auto; text-align: left;">
                    <strong style="display: block; margin-bottom: 0.5rem;">Деталі:</strong>
                    <pre style="white-space: pre-wrap; word-break: break-all; font-size: 0.75rem;">{{ detail }}</pre>
                </div>
            {% endif %}
            
            <div class="hero__actions" style="justify-content: center; margin-top: 2rem;">
                <a class="btn btn--primary" href="/">Повернутися на головну</a>
                <a class="btn btn--ghost" href="/contact">Написати адміністратору</a>
            </div>
        </div>
    </section>
{% endblock %}