{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.dictionary_values.edit.title'|trans({'%id%': value.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.dictionary_values.edit.title_full'|trans({'%id%': value.id}) }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="{{ path('admin_dictionaries_values_edit_post', {'id': value.id}) }}">
            <input type="hidden" name="dictionary_id" value="{{ value.dictionary_id }}">
            {{ forms.input('label', 'admin.dictionary_values.edit.label'|trans, old.label ?? value.label, 'text', 'admin.dictionary_values.edit.label_placeholder'|trans, errors.label ?? null, {'required': 'required'}) }}
            {{ forms.input('value', 'admin.dictionary_values.edit.value'|trans, old.value ?? value.value, 'text', 'admin.dictionary_values.edit.value_placeholder'|trans, errors.value ?? null, {'required': 'required'}) }}
            {{ forms.input('order_num', 'admin.dictionary_values.edit.order_num'|trans, old.order_num ?? value.order_num, 'number', 'admin.dictionary_values.edit.order_num_placeholder'|trans, errors.order_num ?? null) }}

            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_active" {% if (old.is_active is defined and old.is_active) or (old.is_active is not defined and value.is_active) %}checked{% endif %} value="1">
                    <label>{{ 'admin.dictionary_values.edit.is_active'|trans }}</label>
                </div>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('admin.dictionary_values.edit.save'|trans, 'primary', '', 'save') }}
            <a href="{{ path('admin_dictionaries_show', {'id': value.dictionary_id}) }}" class="ui button"><i class="arrow left icon"></i> {{ 'admin.dictionary_values.edit.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}
