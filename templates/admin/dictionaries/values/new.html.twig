{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.dictionary_values.new.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.dictionary_values.new.header'|trans }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="{{ path('admin_dictionaries_values_new_post') }}">
            <input type="hidden" name="dictionary_id" value="{{ dictionary_id }}">
            {{ forms.input('label', 'admin.dictionary_values.new.label'|trans, old.label ?? '', 'text', 'admin.dictionary_values.new.label_placeholder'|trans, errors.label ?? null, {'required': 'required'}) }}
            {{ forms.input('value', 'admin.dictionary_values.new.value'|trans, old.value ?? '', 'text', 'admin.dictionary_values.new.value_placeholder'|trans, errors.value ?? null, {'required': 'required'}) }}
            {{ forms.input('order_num', 'admin.dictionary_values.new.order_num'|trans, old.order_num ?? 0, 'number', '0', errors.order_num ?? null) }}
            
            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_active" {% if old.is_active is defined and old.is_active %}checked{% else %}checked{% endif %} value="1">
                    <label>{{ 'admin.dictionary_values.new.is_active'|trans }}</label>
                </div>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('admin.dictionary_values.new.save_button'|trans, 'primary', '', 'save') }}
            <a href="{{ path('admin_dictionaries_show', {'id': dictionary_id}) }}" class="ui button"><i class="arrow left icon"></i> {{ 'admin.dictionary_values.new.cancel_button'|trans }}</a>
        </form>
    </div>
{% endblock %}