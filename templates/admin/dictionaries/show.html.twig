{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.dictionaries.show.title'|trans({'%id%': dictionary.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.dictionaries.show.title_full'|trans({'%id%': dictionary.id}) }}</h2>
        <p>{{ dictionary.description|default('—') }}</p>
        <p><strong>{{ 'admin.dictionaries.show.type'|trans }}:</strong> {{ dictionary.type }}</p>
        <div class="ui divider"></div>
        <a href="/admin/dictionaries" class="ui button">
            <i class="arrow left icon"></i> {{ 'admin.dictionaries.show.back'|trans }}
        </a>
        <a href="/admin/dictionaries/edit?id={{ dictionary.id }}" class="ui primary button">
            <i class="edit icon"></i> {{ 'admin.dictionaries.edit'|trans }}
        </a>
    </div>

    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h3 class="ui header">{{ 'admin.dictionaries.show.values_header'|trans }}</h3>
            </div>
            <div class="eight wide column right aligned">
                <a href="/admin/dictionaries/values/new?dictionary_id={{ dictionary.id }}" class="ui green button">
                    <i class="plus icon"></i> {{ 'admin.dictionaries.show.add_value'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'admin.dictionaries.show.table.id'|trans }}</th>
                        <th>{{ 'admin.dictionaries.show.table.value'|trans }}</th>
                        <th>{{ 'admin.dictionaries.show.table.label'|trans }}</th>
                        <th>{{ 'admin.dictionaries.show.table.order'|trans }}</th>
                        <th>{{ 'admin.dictionaries.show.table.active'|trans }}</th>
                        <th>{{ 'admin.dictionaries.show.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for value in values %}
                        <tr>
                            <td>{{ value.id }}</td>
                            <td>{{ value.value|default('—') }}</td>
                            <td>{{ value.label|default('—') }}</td>
                            <td>{{ value.order_num }}</td>
                            <td>
                                {% if value.is_active %}
                                    <i class="check circle icon green"></i> {{ 'admin.dictionaries.show.table.yes'|trans }}
                                {% else %}
                                    <i class="times circle icon red"></i> {{ 'admin.dictionaries.show.table.no'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                <a href="/admin/dictionaries/values/edit?id={{ value.id }}" class="ui icon button">
                                    <i class="edit icon"></i>
                                </a>
                                <form action="/admin/dictionaries/values/delete" method="POST" style="display: inline;" onsubmit="return confirm('{{ 'admin.dictionaries.show.delete_confirm'|trans }}');">
                                    <input type="hidden" name="id" value="{{ value.id }}">
                                    <button type="submit" class="ui icon button red">
                                        <i class="trash icon"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="center aligned">{{ 'admin.dictionaries.show.no_values'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
