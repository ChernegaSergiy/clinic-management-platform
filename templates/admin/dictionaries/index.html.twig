{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.dictionaries.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'admin.dictionaries.title'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="{{ path('admin_dictionaries_new_post') }}" class="ui primary button">
                    <i class="plus icon"></i> {{ 'admin.dictionaries.add'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'admin.dictionaries.table.id'|trans }}</th>
                        <th>{{ 'admin.dictionaries.table.name'|trans }}</th>
                        <th>{{ 'admin.dictionaries.table.description'|trans }}</th>
                        <th>{{ 'admin.dictionaries.table.type'|trans }}</th>
                        <th>{{ 'admin.dictionaries.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for dictionary in dictionaries %}
                        <tr>
                            <td>{{ dictionary.id }}</td>
                            <td>{{ dictionary.name }}</td>
                            <td>{{ dictionary.description }}</td>
                            <td>{{ dictionary.type }}</td>
                            <td>
                                <a href="{{ path('admin_dictionaries_show', {'id': dictionary.id}) }}" class="ui icon button">
                                    <i class="eye icon"></i>
                                </a>
                                <a href="{{ path('admin_dictionaries_edit_post', {'id': dictionary.id}) }}" class="ui icon button">
                                    <i class="edit icon"></i>
                                </a>
                                <form action="{{ path('admin_dictionaries_delete') }}" method="POST" style="display: inline;" onsubmit="return confirm('{{ 'admin.dictionaries.delete_confirm'|trans }}');">
                                    <input type="hidden" name="id" value="{{ dictionary.id }}">
                                    <button type="submit" class="ui icon button red">
                                        <i class="trash icon"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="center aligned">{{ 'admin.dictionaries.no_dictionaries'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
