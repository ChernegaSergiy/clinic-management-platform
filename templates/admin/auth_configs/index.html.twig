{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.auth_configs.list.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'admin.auth_configs.list.header'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="/admin/auth_configs/new" class="ui primary button">
                    <i class="plus icon"></i> {{ 'admin.auth_configs.list.add'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'admin.auth_configs.list.table.id'|trans }}</th>
                        <th>{{ 'admin.auth_configs.list.table.provider'|trans }}</th>
                        <th>{{ 'admin.auth_configs.list.table.client_id'|trans }}</th>
                        <th>{{ 'admin.auth_configs.list.table.active'|trans }}</th>
                        <th>{{ 'admin.auth_configs.list.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for config in configs %}
                        <tr>
                            <td>{{ config.id }}</td>
                            <td>{{ config.provider }}</td>
                            <td>{{ config.client_id ?: 'admin.auth_configs.list.not_specified'|trans }}</td>
                            <td>
                                {% if config.is_active %}
                                    <i class="check circle icon green"></i> {{ 'admin.auth_configs.list.yes'|trans }}
                                {% else %}
                                    <i class="times circle icon red"></i> {{ 'admin.auth_configs.list.no'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                <a href="/admin/auth_configs/show?id={{ config.id }}" class="ui icon button">
                                    <i class="eye icon"></i>
                                </a>
                                <a href="/admin/auth_configs/edit?id={{ config.id }}" class="ui icon button">
                                    <i class="edit icon"></i>
                                </a>
                                <form action="/admin/auth_configs/delete" method="POST" style="display: inline;" onsubmit="return confirm('{{ 'admin.auth_configs.list.delete_confirm'|trans }}');">
                                    <input type="hidden" name="id" value="{{ config.id }}">
                            <button type="submit" class="ui icon button red">
                                        <i class="trash icon"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="center aligned">{{ 'admin.auth_configs.list.no_configs'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
