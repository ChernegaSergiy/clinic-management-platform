{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'admin.auth_configs.show.title'|trans({'%id%': config.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.auth_configs.show.title_full'|trans({'%id%': config.id}) }}</h2>
        <div class="ui divider"></div>

        <div class="ui info message">
            <div class="header">{{ 'admin.auth_configs.show.redirect_uri_title'|trans }}</div>
            <p>{{ 'admin.auth_configs.show.redirect_uri_desc'|trans }}</p>
            <code>{{ redirectUri }}</code>
        </div>

        <table class="ui celled unstackable table">
            <tbody>
                <tr>
                    <td><strong>{{ 'admin.auth_configs.show.table.id'|trans }}</strong></td>
                    <td>{{ config.id }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'admin.auth_configs.show.table.provider'|trans }}</strong></td>
                    <td>{{ config.provider }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'admin.auth_configs.show.table.client_id'|trans }}</strong></td>
                    <td>{{ config.client_id|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'admin.auth_configs.show.table.client_secret'|trans }}</strong></td>
                    <td>{{ config.client_secret ? '********' : '—' }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'admin.auth_configs.show.table.active'|trans }}</strong></td>
                    <td>
                        {% if config.is_active %}
                            <i class="check circle icon green"></i> {{ 'admin.auth_configs.show.table.yes'|trans }}
                        {% else %}
                            <i class="times circle icon red"></i> {{ 'admin.auth_configs.show.table.no'|trans }}
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td><strong>{{ 'admin.auth_configs.show.table.config'|trans }}</strong></td>
                    <td><pre>{{ config.config ? config.config|json_encode(constant('JSON_PRETTY_PRINT')) : '—' }}</pre></td>
                </tr>
                <tr>
                    <td><strong>{{ 'admin.auth_configs.show.table.created_at'|trans }}</strong></td>
                    <td>{{ config.created_at }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'admin.auth_configs.show.table.updated_at'|trans }}</strong></td>
                    <td>{{ config.updated_at }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>

        <a href="/admin/auth_configs/edit?id={{ config.id }}" class="ui primary button">
            <i class="edit icon"></i> {{ 'admin.auth_configs.show.edit_button'|trans }}
        </a>
        <a href="/admin/auth_configs" class="ui button">
            <i class="arrow left icon"></i> {{ 'admin.auth_configs.show.back_button'|trans }}
        </a>
    </div>
{% endblock %}
