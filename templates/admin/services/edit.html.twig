{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.services.edit.title'|trans({'%id%': service.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.services.edit.header'|trans({'%id%': service.id}) }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/services/edit?id={{ service.id }}">
            {{ forms.input('name', 'admin.services.new.name'|trans, old.name ?? service.name, 'text', 'admin.services.new.name_placeholder'|trans, errors.name ?? null, {'required': 'required'}) }}
            {{ forms.textarea('description', 'admin.services.new.description'|trans, old.description ?? service.description, 'admin.services.new.description_placeholder'|trans, errors.description ?? null) }}
            <div class="two fields">
                {{ forms.input('price', 'admin.services.new.price'|trans, old.price ?? service.price, 'number', 'admin.services.new.price_placeholder'|trans, errors.price ?? null, {'required': 'required', 'step': '0.01'}) }}
                {{ forms.input('duration_minutes', 'admin.services.new.duration'|trans, old.duration_minutes ?? service.duration_minutes, 'number', 'admin.services.new.duration_placeholder'|trans, errors.duration_minutes ?? null, {'required': 'required', 'min': '1'}) }}
            </div>
            {{ forms.select('category_id', 'admin.services.new.category'|trans, categories, old.category_id ?? service.category_id, errors.category_id ?? null, {'empty_option': 'admin.services.new.select_category'|trans}) }}
            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_active" {{ (old.is_active is defined and old.is_active == 0) or (old.is_active is not defined and service.is_active == 0) ? '' : 'checked' }}>
                    <label>{{ 'admin.services.new.is_active'|trans }}</label>
                </div>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('admin.services.edit.save'|trans, 'primary', '', 'save') }}
            <a href="/admin/services" class="ui button"><i class="arrow left icon"></i> {{ 'admin.services.new.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('.ui.dropdown').dropdown();
        });
    </script>
{% endblock %}
