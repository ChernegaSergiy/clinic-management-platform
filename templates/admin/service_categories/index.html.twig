{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.service_categories.list.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'admin.service_categories.list.header'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="{{ path('admin_service_categories_new_post') }}" class="ui primary button">
                    <i class="plus icon"></i> {{ 'admin.service_categories.list.add_category'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>{{ 'admin.service_categories.list.table.id'|trans }}</th>
                    <th>{{ 'admin.service_categories.list.table.name'|trans }}</th>
                    <th>{{ 'admin.service_categories.list.table.description'|trans }}</th>
                    <th>{{ 'admin.service_categories.list.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td>{{ category.name }}</td>
                        <td>{{ category.description ?? '-' }}</td>
                        <td>
                            <a href="{{ path('admin_service_categories_edit_post', {'id': category.id}) }}" class="ui icon button">
                                <i class="edit icon"></i>
                            </a>
                            <form action="{{ path('admin_service_categories_delete') }}" method="POST" style="display: inline;" onsubmit="return confirm('{{ 'admin.service_categories.list.confirm_delete'|trans }}');">
                                <input type="hidden" name="id" value="{{ category.id }}">
                                <button type="submit" class="ui icon button red">
                                    <i class="trash icon"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="center aligned">{{ 'admin.service_categories.list.no_categories'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}