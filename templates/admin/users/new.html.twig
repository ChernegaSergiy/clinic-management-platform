{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.users.new.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.users.new.title'|trans }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="{{ path('admin_users_new_post') }}">
            <div class="two fields">
                {{ forms.input('first_name', 'admin.users.new.first_name'|trans, old.first_name ?? null, 'text', 'admin.users.new.first_name_placeholder'|trans, errors.first_name ?? null, {'required': 'required'})
 }}
                {{ forms.input('last_name', 'admin.users.new.last_name'|trans, old.last_name ?? null, 'text', 'admin.users.new.last_name_placeholder'|trans, errors.last_name ?? null, {'required': 'required'})
 }}
            </div>
            {{ forms.input('email', 'admin.users.new.email'|trans, old.email ?? null, 'email', 'admin.users.new.email_placeholder'|trans, errors.email ?? null, {'required': 'required'})
 }}
            {{ forms.input('password', 'admin.users.new.password'|trans, null, 'password', 'admin.users.new.password_placeholder'|trans, errors.password ?? null, {'required': 'required'})
 }}
            {{ forms.select('role_id', 'admin.users.new.role'|trans, roles, old.role_id ?? null, errors.role_id ?? null, {'required': 'required'})
  }}

            <div class="ui divider"></div>

            {{ ui.button('admin.users.new.save'|trans, 'primary', '', 'save') }}
            <a href="{{ path('admin_users') }}" class="ui button"><i class="arrow left icon"></i> {{ 'admin.users.new.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('.ui.dropdown').dropdown();
        });
    </script>
{% endblock %}
