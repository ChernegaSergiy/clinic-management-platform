{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'appointment.edit.title'|trans({'%id%': appointment.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'appointment.edit.title_full'|trans({'%id%': appointment.id}) }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/appointments/edit?id={{ appointment.id }}">
            <input type="hidden" name="id" value="{{ appointment.id }}">
            <div class="two fields">
                {{ forms.select('patient_id', 'appointment.edit.patient'|trans, patients, appointment.patient_id, errors.patient_id ?? null, {'required': 'required'}) }}
                {% set doctor_select_attrs = {'required': 'required'} %}
                {% if session.user.role_name == 'doctor' %}
                    {% set doctor_select_attrs = doctor_select_attrs|merge({'disabled': 'disabled'}) %}
                {% endif %}
                {{ forms.select('doctor_id', 'appointment.edit.doctor'|trans, doctors, appointment.doctor_id, errors.doctor_id ?? null, doctor_select_attrs) }}
            </div>
            <div class="two fields">
                {{ forms.input('start_time', 'appointment.edit.start_time'|trans, old.start_time ?? appointment.start_time|date('Y-m-d\\TH:i'), 'datetime-local', '', errors.start_time ?? null, {'required': 'required'}) }}
                {{ forms.input('end_time', 'appointment.edit.end_time'|trans, old.end_time ?? appointment.end_time|date('Y-m-d\\TH:i'), 'datetime-local', '', errors.end_time ?? null, {'required': 'required'}) }}
            </div>
            <div class="two fields">
                {{ forms.select('room_id', 'appointment.edit.room'|trans, rooms, old.room_id ?? appointment.room_id, errors.room_id ?? null, {}) }}
                {{ forms.select('status', 'appointment.edit.status'|trans, {'scheduled': 'appointment.edit.statuses.scheduled'|trans, 'completed': 'appointment.edit.statuses.completed'|trans, 'cancelled': 'appointment.edit.statuses.cancelled'|trans, 'no-show': 'appointment.edit.statuses.no_show'|trans}, old.status ?? appointment.status, errors.status ?? null, {'required': 'required'}) }}
            </div>
            {{ forms.textarea('notes', 'appointment.edit.notes'|trans, old.notes ?? appointment.notes, 'appointment.edit.notes_placeholder'|trans) }}

            <div class="ui divider"></div>

            {{ ui.button('appointment.edit.save'|trans, 'primary', '', 'save') }}
            <a href="/appointments/show?id={{ appointment.id }}" class="ui button"><i class="arrow left icon"></i> {{ 'appointment.edit.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('.ui.dropdown').dropdown();
        });
    </script>
{% endblock %}
