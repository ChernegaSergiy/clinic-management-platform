{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'appointment.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'appointment.calendar.title'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="{{ path('appointment_waitlist') }}" class="ui orange button" style="margin-right: 0.5rem;">
                    <i class="list icon"></i> {{ 'appointment.calendar.waitlist'|trans }} ({{ waitlist|length }})
                </a>
                <a href="{{ path('appointment_create') }}" class="ui primary button">
                    <i class="plus icon"></i> {{ 'appointment.calendar.create'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        <div id='calendar'></div>

        <div class="ui divider"></div>
        <h3 class="ui header">{{ 'appointment.calendar.legend'|trans }}</h3>
        <div class="ui labels">
            <div class="ui header">{{ 'appointment.calendar.status_legend'|trans }}</div>
            <a class="ui label blue">{{ 'appointment.statuses.scheduled'|trans }}</a>
            <a class="ui label green">{{ 'appointment.statuses.completed'|trans }}</a>
            <a class="ui label red">{{ 'appointment.statuses.cancelled'|trans }}</a>
            <a class="ui label yellow">{{ 'appointment.statuses.no_show'|trans }}</a>
            <a class="ui label grey">{{ 'appointment.statuses.other'|trans }}</a>
        </div>


        <div class="ui segment">
            <h3 class="ui header">{{ 'appointment.list.title'|trans }}</h3>
                <table class="ui celled unstackable table">
                    <thead>
                        <tr>
                            <th>{{ 'appointment.table.id'|trans }}</th>
                            <th>{{ 'appointment.table.patient'|trans }}</th>
                            <th>{{ 'appointment.table.doctor'|trans }}</th>
                            <th>{{ 'appointment.table.start'|trans }}</th>
                            <th>{{ 'appointment.table.status'|trans }}</th>
                            <th>{{ 'appointment.table.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for appt in appointments %}
                            <tr>
                                <td>{{ appt.id }}</td>
                                <td>{{ appt.patient_name }}</td>
                                <td>{{ appt.doctor_name }}</td>
                                <td>{{ appt.start_time|date('Y-m-d H:i') }}</td>
                                <td>{{ appt.status }}</td>
                                <td>
                                    <a class="ui icon button" href="/appointments/show?id={{ appt.id }}">
                                        <i class="eye icon"></i>
                                    </a>
                                    <a class="ui icon button" href="/appointments/edit?id={{ appt.id }}">
                                        <i class="edit icon"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="center aligned">{{ 'appointment.no_appointments'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar-scheduler@6.1.15/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            
            // Load rooms via API
            fetch('/api/calendar/rooms')
                .then(response => response.json())
                .then(rooms => {
                    // Combine doctors and rooms as resources
                    var doctorResources = {{ doctors|map(d => {'id': d.id, 'title': d.title, 'type': 'doctor'})|json_encode|raw }} || [];
                    var roomResources = rooms || [];
                    var allResources = doctorResources.concat(roomResources);
                    
                    var calendar = new FullCalendar.Calendar(calendarEl, {
                        schedulerLicenseKey: 'CC-Attribution-NonCommercial-NoDerivatives',
                        initialView: 'resourceTimelineDay',
                        headerToolbar: {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'resourceTimelineDay,resourceTimelineWeek,resourceTimelineMonth'
                        },
                        resourceAreaHeaderContent: '{{ 'appointment.resources'|trans }}',
                        resources: allResources,
                        events: '/api/appointments',

                        resourceGroupField: 'type',
                        resourceAreaWidth: '250px'
                    });
                    calendar.render();
                })
                .catch(error => console.error('Error loading rooms:', error));
        });
    </script>
{% endblock %}
