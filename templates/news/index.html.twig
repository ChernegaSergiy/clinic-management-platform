{% extends "layouts/public.html.twig" %}

{% block title %}Новини та Оголошення — Міська клінічна лікарня №1{% endblock %}

{% block body %}
    <section id="news" class="section">
        <div class="container">
            <header class="section__header">
                <div class="section__eyebrow">Оперативна інформація</div>
                <h1 class="section__title">Новини та Офіційні Оголошення</h1>
                <p class="section__description">Важливі повідомлення про графік роботи, зміни в прийомі, державні програми, закупівлі та внутрішні зміни в роботі відділень. Хронологічна стрічка без зображень.</p>
            </header>

            <div id="news-container">
                <ul class="news-list" id="main-news-list">
                    {% for newsItem in newsArticles %}
                        <li class="news-item" data-id="{{ newsItem.id }}">
                            <div class="news-item__header">
                                <span class="news-item__date">{{ newsItem.published_at|date("d.m.Y") }}</span>
                                <div class="news-item__title">{{ newsItem.title }}</div>
                            </div>
                            <div class="news-item__meta">{{ newsItem.meta }}</div>
                        </li>
                    {% else %}
                        <li class="news-item">
                            <div class="news-item__header">
                                <div class="news-item__title">Наразі новин немає.</div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }} {# Include parent javascripts from public.html.twig #}
    <script>
        const mainNewsList = document.getElementById('main-news-list');
        if (mainNewsList) {
            mainNewsList.addEventListener('click', (e) => {
                const item = e.target.closest('.news-item');
                if (item) {
                    const newsId = item.dataset.id;
                    if (newsId) {
                        window.location.href = `/news/${newsId}`; // Navigate to the detail page
                    }
                }
            });
        }
    </script>
{% endblock %}