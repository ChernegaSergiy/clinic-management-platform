{% extends 'layouts/base.html.twig' %}

{% block title %}{{ 'hrm.show.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="sixteen wide column">
                <h2 class="ui header">{{ 'hrm.show.title_full'|trans({'%first_name%': employee.first_name, '%last_name%': employee.last_name}) }}</h2>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td><strong>{{ 'hrm.show.table.id'|trans }}</strong></td>
                    <td>{{ employee.id }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'hrm.show.table.full_name'|trans }}</strong></td>
                    <td>{{ employee.last_name }} {{ employee.first_name }} {{ employee.middle_name|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'hrm.show.table.position'|trans }}</strong></td>
                    <td>{{ employee.position }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'hrm.show.table.department'|trans }}</strong></td>
                    <td>{{ employee.department_name|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'hrm.show.table.hire_date'|trans }}</strong></td>
                    <td>{{ employee.hire_date }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'hrm.show.table.contact_phone'|trans }}</strong></td>
                    <td>{{ employee.contact_phone|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'hrm.show.table.salary'|trans }}</strong></td>
                    <td>{{ employee.salary ? employee.salary|number_format(2, ',', ' ') : '—' }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'hrm.show.table.status'|trans }}</strong></td>
                    <td>{{ employee.status }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'hrm.show.table.fire_date'|trans }}</strong></td>
                    <td>{{ employee.fire_date|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'hrm.show.table.linked_user'|trans }}</strong></td>
                    <td>{{ employee.user_id|default('—') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>

        <form action="/hrm/toggle-status" method="POST" style="display: inline-block;">
            <input type="hidden" name="id" value="{{ employee.id }}">
            <button class="ui {{ employee.status == 'active' ? 'negative' : 'positive' }} button" type="submit">
                <i class="user {{ employee.status == 'active' ? 'times' : 'check' }} icon"></i>
                {{ employee.status == 'active' ? 'hrm.show.deactivate'|trans : 'hrm.show.activate'|trans }}
            </button>
        </form>
        <a href="/hrm/edit?id={{ employee.id }}" class="ui primary button">
            <i class="edit icon"></i> {{ 'hrm.show.edit'|trans }}
        </a>
        <a href="{{ path('hrm_index') }}" class="ui button">
            <i class="arrow left icon"></i> {{ 'hrm.show.back'|trans }}
        </a>
    </div>
{% endblock %}
