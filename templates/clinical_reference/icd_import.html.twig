{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'clinical_reference.icd_import.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'clinical_reference.icd_import.header'|trans }}</h2>
        <div class="ui divider"></div>

        {% if errors.import is defined %}
            <div class="ui negative message">{{ errors.import }}</div>
        {% endif %}
        {% if success_message is defined and success_message %}
            <div class="ui positive message">{{ success_message }}</div>
        {% endif %}

        <p>{{ 'clinical_reference.icd_import.current_count'|trans }} <strong>{{ count }}</strong></p>
        <p>{{ 'clinical_reference.icd_import.data_source'|trans }} <code>NK-025-2021</code> (meddata.pp.ua) {{ 'clinical_reference.icd_import.package'|trans }} <code>medcore-ua/nk-025-2021-parser</code>.</p>

        <form class="ui form" method="POST" action="{{ path('clinical_icd_import_run') }}">
            <button type="submit" class="ui primary button">{{ 'clinical_reference.icd_import.update_button'|trans }}</button>
            <a href="{{ path('clinical_index') }}" class="ui button">{{ 'clinical_reference.icd_import.back'|trans }}</a>
        </form>
    </div>
{% endblock %}
