{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'clinical_reference.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'clinical_reference.title_full'|trans }}</h2>
        <div class="ui divider"></div>

        <div class="ui two column very relaxed grid">
            <div class="column">
                <h3 class="ui header">{{ 'clinical_reference.icd_title'|trans }}</h3>
                <p>{{ 'clinical_reference.icd_description'|trans }}</p>
                <p>{{ 'clinical_reference.icd_records_count'|trans }}: <strong>{{ icdCount }}</strong></p>
                <a href="{{ path('clinical_icd_import_run') }}" class="ui primary button">{{ 'clinical_reference.icd_manage_import'|trans }}</a>
            </div>
            <div class="column">
                <h3 class="ui header">{{ 'clinical_reference.intervention_title'|trans }}</h3>
                <p>{{ 'clinical_reference.intervention_description'|trans }}</p>
                <p>{{ 'clinical_reference.icd_records_count'|trans }}: <strong>{{ interventionCount }}</strong></p>
                <a href="{{ path('clinical_intervention_import_run') }}" class="ui primary button">{{ 'clinical_reference.intervention_manage_import'|trans }}</a>
            </div>
        </div>

        {% if success_message is defined and success_message %}
            <div class="ui success message">
                <i class="close icon"></i>
                <div class="header">{{ 'clinical_reference.success'|trans }}</div>
                <p>{{ success_message }}</p>
            </div>
        {% endif %}
        {% if errors.import ?? null %}
            <div class="ui error message">
                <i class="close icon"></i>
                <div class="header">Помилка!</div>
                <p>{{ errors.import }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
