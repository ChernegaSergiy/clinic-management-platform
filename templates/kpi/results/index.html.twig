{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'kpi.results.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'kpi.results.header'|trans }}</h2>
        <div class="ui divider"></div>

        
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'kpi.results.table.id'|trans }}</th>
                        <th>{{ 'kpi.results.table.kpi'|trans }}</th>
                        <th>{{ 'kpi.results.table.period'|trans }}</th>
                        <th>{{ 'kpi.results.table.value'|trans }}</th>
                        <th>{{ 'kpi.results.table.unit'|trans }}</th>
                        <th>{{ 'kpi.results.table.notes'|trans }}</th>
                        <th>{{ 'kpi.results.table.calculated_at'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for result in results %}
                        <tr>
                            <td>{{ result.id }}</td>
                            <td>{{ result.kpi_name }}</td>
                            <td>{{ result.period_start|date('Y-m-d') }} - {{ result.period_end|date('Y-m-d') }}</td>
                            <td>{{ result.calculated_value | number_format(2) }}</td>
                            <td>{{ result.unit ?: 'kpi.results.n_a'|trans }}</td>
                            <td>{{ result.notes ?: 'kpi.results.no_notes'|trans }}</td>
                            <td>{{ result.created_at|date('Y-m-d H:i') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="center aligned">{{ 'kpi.results.no_results'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
