{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'kpi.definitions.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'kpi.definitions.list_title'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="{{ path('admin_kpi_definitions_new') }}" class="ui primary button">
                    <i class="plus icon"></i> {{ 'kpi.definitions.add_definition'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'kpi.definitions.table.id'|trans }}</th>
                        <th>{{ 'kpi.definitions.table.name'|trans }}</th>
                        <th>{{ 'kpi.definitions.table.description'|trans }}</th>
                        <th>{{ 'kpi.definitions.table.type'|trans }}</th>
                        <th>{{ 'kpi.definitions.table.target_value'|trans }}</th>
                        <th>{{ 'kpi.definitions.table.unit'|trans }}</th>
                        <th>{{ 'kpi.definitions.table.active'|trans }}</th>
                        <th>{{ 'kpi.definitions.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for definition in definitions %}
                        <tr>
                            <td>{{ definition.id }}</td>
                            <td>{{ definition.name }}</td>
                            <td>{{ definition.description ?: 'kpi.definitions.not_specified'|trans }}</td>
                            <td>{{ definition.kpi_type }}</td>
                            <td>{{ definition.target_value }}</td>
                            <td>{{ definition.unit }}</td>
                            <td>
                                {% if definition.is_active %}
                                    <i class="check circle icon green"></i> {{ 'kpi.definitions.yes'|trans }}
                                {% else %}
                                    <i class="times circle icon red"></i> {{ 'kpi.definitions.no'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                <a href="/kpi/definitions/edit?id={{ definition.id }}" class="ui icon button">
                                    <i class="edit icon"></i>
                                </a>
                                <form action="/kpi/definitions/delete" method="POST" style="display: inline;" onsubmit="return confirm('{{ 'kpi.definitions.delete_confirm'|trans }}');">
                                    <input type="hidden" name="id" value="{{ definition.id }}">
                                    <button type="submit" class="ui icon button red">
                                        <i class="trash icon"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="center aligned">{{ 'kpi.definitions.no_definitions'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}