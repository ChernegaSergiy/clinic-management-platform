<!DOCTYPE html>
<html lang="{{ app.request.locale|default('uk') }}">
<head>
    <meta charset="utf-8">
    <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=2, user-scalable=no">
    <meta name="description" content="{{ 'admin.title'|trans }} на базі Semantic UI.">
    <meta name="keywords" content="Semantic-UI, Dashboard, Admin">
    <meta name="author" content="Clinic Management Platform">
    <meta name="theme-color" content="#ffffff">
    <title>{% block title %}{{ 'admin.title'|trans }}{% endblock %}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.4.1/semantic.min.css" type="text/css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/css/dashboard.css" type="text/css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    {% block stylesheets %}{% endblock %}
</head>
<body id="root">
    <div class="ui tablet computer only padded grid">
        <div class="ui inverted borderless top fixed fluid menu">
            <a class="header item" href="#">{% block brand %}Clinic Admin{% endblock %}</a>
            <div class="right menu">
                {% block top_menu %}
                    <a class="item" href="{{ path('dashboard') }}">Панель</a>
                    <a class="item" href="{{ path('admin_settings_post') }}">Налаштування</a>
                    <a class="item" href="{{ path('user_profile') }}">Профіль</a>
                    <a class="item">Довідка</a>
                {% endblock %}
            </div>
        </div>
    </div>
    <div class="ui mobile only padded grid">
        <div class="ui top fixed borderless fluid inverted menu">
            <a class="header item" href="#">{% block mobile_brand %}Clinic Admin{% endblock %}</a>
            <div class="right menu">
                <div class="ui dropdown item" id="notificationDropdownMobile">
                    <i class="bell icon"></i>
                    <span class="ui red circular mini label notification-badge" style="display: none;"></span>
                    <div class="menu notification-menu" id="notificationMenuMobile">
                        <div class="header">Сповіщення</div>
                        <div class="item notification-mark-all" id="notificationMarkAllMobile"><i class="check icon"></i> Позначити всі як прочитані</div>
                        <div class="ui divider"></div>
                        <div class="item">Завантаження...</div>
                    </div>
                </div>
                <div class="item">
                    <button class="ui icon toggle basic inverted button">
                        <i class="content icon"></i>
                    </button>
                </div>
            </div>
            <div class="ui vertical borderless inverted fluid menu mobile-nav-menu">
                {% block mobile_menu %}
                    <a class="item" href="{{ path('dashboard') }}">Панель</a>
                    <a class="item" href="{{ path('admin_settings_post') }}">Налаштування</a>
                    <a class="item" href="{{ path('user_profile') }}">Профіль</a>
                    <a class="item">Довідка</a>
                    <div class="ui fitted divider"></div>
                {% endblock %}
            </div>
        </div>
    </div>
    <div class="ui padded grid">
        <div class="three wide tablet only three wide computer only column" id="sidebar">
            <div class="ui vertical borderless fluid text menu">
                {% block sidebar %}
                    <a class="active item">Огляд</a>
                    <a class="item">Звіти</a>
                    <a class="item">Аналітика</a>
                    <a class="item">Експорт</a>
                    <div class="ui hidden divider"></div>
                    <a class="item">Навігація</a>
                    <a class="item">Ще пункт</a>
                    <a class="item" href="{{ path('admin_settings_post') }}">Налаштування</a>
                    <div class="ui hidden divider"></div>
                    <a class="item">Macintosh</a>
                    <a class="item">Linux</a>
                    <a class="item">Windows</a>
                {% endblock %}
            </div>
        </div>
        <div class="sixteen wide mobile thirteen wide tablet thirteen wide computer right floated column" id="content">
            {% for message in app.flashes('success') %}
                <div class="ui success message" data-flash="success">
                    <i class="close icon"></i>
                    <div class="header">Успіх!</div>
                    <p>{{ message }}</p>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="ui error message" data-flash="error">
                    <i class="close icon"></i>
                    <div class="header">Помилка!</div>
                    <p>{{ message }}</p>
                </div>
            {% endfor %}
            {% block body %}{% endblock %}
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.4.1/semantic.min.js"></script>
    {% block javascripts %}
        <script>
            $(document).ready(function() {
                $('.ui.toggle.button').click(function() {
                    $('.ui.mobile.only.grid .mobile-nav-menu').toggle(100);
                });

                var flashMessages = document.querySelectorAll('[data-flash]');
                if (flashMessages.length > 0) {
                    setTimeout(function() {
                        flashMessages.forEach(function(el) {
                            $(el).transition({
                                animation: 'fade',
                                duration: 300,
                                onComplete: function() {
                                    $(this).remove();
                                }
                            });
                        });
                        fetch('/user/clear-messages', {method: 'POST'});
                    }, 5000);
                }
                $('.message .close.icon').click(function() {
                    $(this).closest('.message').transition({
                        animation: 'fade',
                        duration: 300,
                        onComplete: function() {
                            $(this).remove();
                        }
                    });
                    fetch('/user/clear-messages', {method: 'POST'});
                });
            });
        </script>
    {% endblock %}
</body>
</html>
