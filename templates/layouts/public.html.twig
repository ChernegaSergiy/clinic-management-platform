<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Клініка — турбота без зайвого{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/framework.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<div class="page">
    <div class="top-strip">
        <div class="top-strip__emergency">Невідкладна допомога: 103</div>
        <div class="top-strip__status">Статус приймального: <span class="badge badge--ok">ВІДКРИТО</span></div>
    </div>

    <header>
        <div class="header-inner">
            <div class="logo-block">
                <div class="logo-mark" aria-hidden="true">+</div>
                <div class="logo-text">
                    <div class="logo-text__title">{{ clinic_name }}</div>
                    <div class="logo-text__subtitle">Комунальний заклад охорони здоров’я</div>
                </div>
            </div>

            <button class="nav-toggle" id="navToggle" aria-expanded="false">МЕНЮ <span></span></button>

            <nav id="mainNav" aria-label="Основна навігація">
                <ul class="nav-list">
                    <li><a class="nav-link" href="/">Головна</a></li>
                    <li><a class="nav-link" href="/about">Про лікарню</a></li>
                    <li><a class="nav-link" href="/departments">Відділення</a></li>
                    <li><a class="nav-link" href="/doctors">Лікарі</a></li>
                    <li><a class="nav-link" href="/our-team">Команда розробників</a></li>
                    <li><a class="nav-link" href="/book-appointment">Запис</a></li>
                    <li><a class="nav-link" href="/contact">Контакти</a></li>

                </ul>
            </nav>
        </div>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer>
        <div class="container">
            <div class="footer-row">
                <div>
                    <div style="margin-bottom: 0.5rem;">{{ clinic_name }}</div>
                    <div style="font-size: 0.75rem; display: flex; gap: 1rem;">
                        <a href="/privacy">Приватність</a>
                        <a href="/sitemap">Карта сайту</a>
                    </div>
                </div>
                <div>Офіційний інформаційний ресурс (макет)</div>
            </div>
            <div class="footer-row" style="opacity: 0.7; border-top: 1px solid #000; padding-top: 0.5rem; margin-top: 0.5rem;">
                <div>Мінімалістичний бруталізм · Чорне / біле · Без зайвих ефектів</div>
                <div>У демо-версії не зберігаються персональні дані користувачів</div>
            </div>
        </div>
    </footer>
</div>

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Тогл меню
            const navToggle = document.getElementById('navToggle');
            const mainNav = document.getElementById('mainNav');
            if (navToggle && mainNav) {
                navToggle.addEventListener('click', () => {
                    mainNav.classList.toggle('open');
                });
            }
        
        // Скрол
        document.addEventListener('click', (e) => {
            const target = e.target.closest('[data-scroll-target]');
            if(target) {
                e.preventDefault();
                document.querySelector(target.getAttribute('data-scroll-target'))?.scrollIntoView({behavior:'smooth'});
            }
        });

        // FAQ
        const faqList = document.getElementById('faqList');
        if(faqList) {
            faqList.addEventListener('click', (e) => {
                const btn = e.target.closest('.faq-question');
                if(btn) {
                    const ans = btn.nextElementSibling;
                    ans.classList.toggle('open');
                    btn.querySelector('span:last-child').textContent = ans.classList.contains('open') ? '−' : '+';
                }
            });
        }

        // === ОНОВЛЕНИЙ ОБРОБНИК ФОРМИ ===
        // Простий обробник форми запису
        const bookingForm = document.getElementById('bookingForm');
        const bookingResult = document.getElementById('bookingResult');

        if (bookingForm && bookingResult) {
            bookingForm.addEventListener('submit', (event) => {
                event.preventDefault();

                // Зчитуємо дані через іменовані поля, які я додав у HTML
                const name = bookingForm.patientName.value.trim();
                const dept = bookingForm.department.value;
                const date = bookingForm.preferredDate.value;

                if (!name || !dept || !date) {
                    bookingResult.textContent = 'Перевірте, будь ласка, заповнення обов’язкових полів.';
                    bookingResult.style.display = 'block'; // Використовуємо inline style, як у HTML
                    return;
                }

                bookingResult.innerHTML =
                    'Запит сформовано. Реєстратура зв’яжеться з вами для підтвердження ' +
                    'дати та часу. <br><br>' +
                    '<strong>ПІБ:</strong> ' + name + '<br>' +
                    '<strong>Відділення:</strong> ' + dept + '<br>' +
                    '<strong>Бажана дата:</strong> ' + date;

                bookingResult.style.display = 'block';
            });
        }
        });
    </script>
{% endblock %}
