{% extends "layouts/dashboard.html.twig" %}

{% block title %}Clinic Management Platform{% endblock %}

{% block brand %}Clinic Admin{% endblock %}

{% block top_menu %}
    {% if app.user is not null %}
        {% set role = app.user.role.name|default('') %}
        {% set canPatients = role in ['admin','medical_manager','registrar','doctor','nurse'] %}
        {% set canAppointments = role in ['admin','medical_manager','registrar','doctor','nurse'] %}
        {% set canMedical = role in ['admin','medical_manager','doctor','nurse'] %}
        {% set canPrescriptions = role in ['admin','doctor'] %}
        {% set canInventory = role in ['admin','inventory_manager'] %}
        {% set canBilling = role in ['admin','billing'] %}
        {% set canAdminNav = role in ['admin'] %}
        {% set canHrm = role in ['admin', 'hr_manager', 'medical_manager'] %}
        {% set canSchedule = role in ['admin', 'doctor'] %}

        <a class="item" href="{{ path('dashboard') }}">Панель</a>
        {% if canPatients %}<a class="item" href="{{ path('patient_index') }}">Пацієнти</a>{% endif %}
        {% if canAppointments %}<a class="item" href="{{ path('appointment_index') }}">Записи</a>{% endif %}
        {% if canMedical %}<a class="item" href="{{ path('medical_records_index') }}">Медичні записи</a>{% endif %}
        {% if canPrescriptions %}<a class="item" href="{{ path('prescription_index') }}">Рецепти</a>{% endif %}
        {% if canInventory %}<a class="item" href="{{ path('inventory_index') }}">Склад</a>{% endif %}
        {% if canBilling %}<a class="item" href="{{ path('billing_index') }}">Рахунки</a>{% endif %}
        {% if canHrm %}<a class="item" href="{{ path('hrm_index') }}">Співробітники</a>{% endif %}
        {% if canAdminNav %}<a class="item" href="{{ path('admin_users') }}">Користувачі</a>{% endif %}
        <div class="ui dropdown item" id="notificationDropdown">
            <i class="bell icon"></i> Сповіщення
            <span class="ui red circular mini label notification-badge" style="display: none;"></span>
            <div class="menu notification-menu" id="notificationMenu">
                <div class="header">Сповіщення</div>
                <div class="item notification-mark-all" id="notificationMarkAll"><i class="check icon"></i> Позначити всі як прочитані</div>
                <div class="ui divider"></div>
                <div class="item">Завантаження...</div>
            </div>
        </div>
        <div class="item">Вітаю,&nbsp;<a href="{{ path('user_profile') }}">{{ app.user.firstName }}</a></div>
        <a class="item" href="{{ path('logout') }}">Вихід</a>
    {% else %}
        <a class="item" href="{{ path('login_post') }}">Вхід</a>
    {% endif %}
{% endblock %}

