{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'billing.bundles.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'billing.bundles.list_title'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="{{ path('billing_bundles_new_get') }}" class="ui primary button">
                    <i class="plus icon"></i> {{ 'billing.bundles.add_bundle'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'billing.bundles.table.id'|trans }}</th>
                        <th>{{ 'billing.bundles.table.name'|trans }}</th>
                        <th>{{ 'billing.bundles.table.price'|trans }}</th>
                        <th>{{ 'billing.bundles.table.active'|trans }}</th>
                        <th>{{ 'billing.bundles.table.services'|trans }}</th>
                        <th>{{ 'billing.bundles.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for bundle in bundles %}
                        <tr>
                            <td>{{ bundle.id }}</td>
                            <td>{{ bundle.name }}</td>
                            <td>{{ bundle.price | number_format(2) }}</td>
                            <td>
                                {% if bundle.is_active %}
                                    <i class="check circle icon green"></i> {{ 'billing.services.yes'|trans }}
                                {% else %}
                                    <i class="times circle icon red"></i> {{ 'billing.services.no'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                {% if bundle.services is not empty %}
                                    <ul class="ui list">
                                        {% for service in bundle.services %}
                                            <li>{{ service.name }} ({{ service.price | number_format(2) }})</li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
{{ 'billing.bundles.no_services_in_bundle'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                <a href="/billing/bundles/edit?id={{ bundle.id }}" class="ui icon button">
                                    <i class="edit icon"></i>
                                </a>
                                {# <a href="/billing/bundles/delete?id={{ bundle.id }}" class="ui icon button red">
                                    <i class="trash icon"></i>
                                </a> #}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="center aligned">{{ 'billing.bundles.no_bundles'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
