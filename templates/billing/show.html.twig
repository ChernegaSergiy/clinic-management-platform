{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'billing.show.title'|trans({'%id%': invoice.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'billing.show.title_full'|trans({'%id%': invoice.id}) }}</h2>
        <div class="ui divider"></div>

        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td>{{ 'billing.show.table.id'|trans }}</td>
                    <td>{{ invoice.id }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.patient'|trans }}</td>
                    <td><a href="/patients/show?id={{ invoice.patient_id }}">{{ invoice.patient_name }}</a></td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.amount'|trans }}</td>
                    <td>{{ invoice.amount }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.insurance_due'|trans }}</td>
                    <td>{{ invoice.insurance_due | number_format(2) }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.patient_due'|trans }}</td>
                    <td>{{ invoice.patient_due | number_format(2) }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.status'|trans }}</td>
                    <td>{{ invoice.status }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.issued_date'|trans }}</td>
                    <td>{{ invoice.issued_date|date('Y-m-d H:i') }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.paid_date'|trans }}</td>
                    <td>{{ invoice.paid_date ? invoice.paid_date|date('Y-m-d H:i') : 'billing.show.table.not_paid'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.notes'|trans }}</td>
                    <td>{{ invoice.notes|nl2br|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.created_at'|trans }}</td>
                    <td>{{ invoice.created_at|date('Y-m-d H:i') }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.updated_at'|trans }}</td>
                    <td>{{ invoice.updated_at|date('Y-m-d H:i') }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.total_paid'|trans }}</td>
                    <td>{{ invoice.total_paid | number_format(2) }}</td>
                </tr>
                <tr>
                    <td>{{ 'billing.show.table.remaining_amount'|trans }}</td>
                    <td>{{ invoice.remaining_amount | number_format(2) }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>

        <a href="/billing/edit?id={{ invoice.id }}" class="ui primary button">
            <i class="edit icon"></i> {{ 'billing.show.edit'|trans }}
        </a>
        <a href="/billing" class="ui button">
            <i class="arrow left icon"></i> {{ 'billing.show.back'|trans }}
        </a>
    </div>

    <div class="ui segment">
        <h3 class="ui header">{{ 'billing.show.payments_history'|trans }}</h3>

        {% if errors is not empty %}
            <div class="ui error message">
                <ul class="list">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'billing.show.payments_table.id'|trans }}</th>
                        <th>{{ 'billing.show.payments_table.amount'|trans }}</th>
                        <th>{{ 'billing.show.payments_table.payment_method'|trans }}</th>
                        <th>{{ 'billing.show.payments_table.transaction_id'|trans }}</th>
                        <th>{{ 'billing.show.payments_table.payment_date'|trans }}</th>
                        <th>{{ 'billing.show.payments_table.notes'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payment in invoice.payments %}
                        <tr>
                            <td>{{ payment.id }}</td>
                            <td>{{ payment.amount | number_format(2) }}</td>
                            <td>{{ payment.payment_method }}</td>
                            <td>{{ payment.transaction_id ?: 'billing.show.payments_table.not_specified'|trans }}</td>
                            <td>{{ payment.payment_date|date('Y-m-d H:i') }}</td>
                            <td>{{ payment.notes ?: 'billing.show.payments_table.no_notes'|trans }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="center aligned">{{ 'billing.show.no_payments'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

        <div class="ui divider"></div>

        <h3 class="ui header">{{ 'billing.show.add_payment'|trans }}</h3>
        <form class="ui form" action="/billing/add-payment" method="POST">
            <input type="hidden" name="invoice_id" value="{{ invoice.id }}">
            <div class="two fields">
                <div class="field {% if errors.amount ?? null %}error{% endif %}">
                    <label>{{ 'billing.show.payment_amount'|trans }}</label>
                    <input type="number" name="amount" placeholder="0.00" step="0.01" min="0.01" value="{{ old.amount ?? '' }}">
                    {% if errors.amount ?? null %}<div class="ui red basic pointing label">{{ (errors.amount ?? null) | first }}</div>{% endif %}
                </div>
                <div class="field {% if errors.payment_method ?? null %}error{% endif %}">
                    <label>{{ 'billing.show.payment_method'|trans }}</label>
                    <select class="ui dropdown" name="payment_method">
                        <option value="">{{ 'billing.show.select_method'|trans }}</option>
                        <option value="cash" {% if (old.payment_method ?? null) == 'cash' %}selected{% endif %}>{{ 'billing.show.payment_methods.cash'|trans }}</option>
                        <option value="card" {% if (old.payment_method ?? null) == 'card' %}selected{% endif %}>{{ 'billing.show.payment_methods.card'|trans }}</option>
                        <option value="bank_transfer" {% if (old.payment_method ?? null) == 'bank_transfer' %}selected{% endif %}>{{ 'billing.show.payment_methods.bank_transfer'|trans }}</option>
                    </select>
                    {% if errors.payment_method ?? null %}<div class="ui red basic pointing label">{{ (errors.payment_method ?? null) | first }}</div>{% endif %}
                </div>
            </div>
            <div class="two fields">
                <div class="field {% if errors.transaction_id ?? null %}error{% endif %}">
                    <label>{{ 'billing.show.transaction_id'|trans }}</label>
                    <input type="text" name="transaction_id" value="{{ old.transaction_id ?? '' }}">
                    {% if errors.transaction_id ?? null %}<div class="ui red basic pointing label">{{ (errors.transaction_id ?? null) | first }}</div>{% endif %}
                </div>
                <div class="field {% if errors.notes ?? null %}error{% endif %}">
                    <label>{{ 'billing.show.payment_notes'|trans }}</label>
                    <textarea name="notes" rows="2">{{ old.notes ?? '' }}</textarea>
                    {% if errors.notes ?? null %}<div class="ui red basic pointing label">{{ (errors.notes ?? null) | first }}</div>{% endif %}
                </div>
            </div>
            <button class="ui green button" type="submit">{{ 'billing.show.add_payment_button'|trans }}</button>
        </form>
    </div>
{% endblock %}

