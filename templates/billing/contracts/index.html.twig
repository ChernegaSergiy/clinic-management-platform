{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'billing.contracts.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'billing.contracts.list_title'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="/billing/contracts/new" class="ui primary button">
                    <i class="plus icon"></i> {{ 'billing.contracts.add_contract'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'billing.contracts.table.id'|trans }}</th>
                        <th>{{ 'billing.contracts.table.title'|trans }}</th>
                        <th>{{ 'billing.contracts.table.party_a'|trans }}</th>
                        <th>{{ 'billing.contracts.table.party_b'|trans }}</th>
                        <th>{{ 'billing.contracts.table.start_date'|trans }}</th>
                        <th>{{ 'billing.contracts.table.end_date'|trans }}</th>
                        <th>{{ 'billing.contracts.table.status'|trans }}</th>
                        <th>{{ 'billing.contracts.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for contract in contracts %}
                        <tr>
                            <td>{{ contract.id }}</td>
                            <td>{{ contract.title }}</td>
                            <td>{{ contract.party_a }}</td>
                            <td>{{ contract.party_b }}</td>
                            <td>{{ contract.start_date|date('Y-m-d') }}</td>
                            <td>{{ contract.end_date ? contract.end_date|date('Y-m-d') : 'billing.contracts.not_specified'|trans }}</td>
                            <td>{{ contract.status }}</td>
                            <td>
                                <a href="/billing/contracts/show?id={{ contract.id }}" class="ui icon button">
                                    <i class="eye icon"></i>
                                </a>
                                <a href="/billing/contracts/edit?id={{ contract.id }}" class="ui icon button">
                                    <i class="edit icon"></i>
                                </a>
                                <a href="/billing/contracts/delete?id={{ contract.id }}" class="ui icon button red">
                                    <i class="trash icon"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="center aligned">{{ 'billing.contracts.no_contracts'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
