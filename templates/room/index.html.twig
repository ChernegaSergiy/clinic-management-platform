{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'room.list.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'room.list.header'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="/admin/rooms/new" class="ui primary button">
                    <i class="plus icon"></i> {{ 'room.list.add_room'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>{{ 'room.list.table.id'|trans }}</th>
                    <th>{{ 'room.list.table.name'|trans }}</th>
                    <th>{{ 'room.list.table.type'|trans }}</th>
                    <th>{{ 'room.list.table.capacity'|trans }}</th>
                    <th>{{ 'room.list.table.location'|trans }}</th>
                    <th>{{ 'room.list.table.available'|trans }}</th>
                    <th>{{ 'room.list.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for room in rooms %}
                    <tr>
                        <td>{{ room.id }}</td>
                        <td>{{ room.name }}</td>
                        <td>{{ room.type }}</td>
                        <td>{{ room.capacity }}</td>
                        <td>{{ room.location ?? '-' }}</td>
                        <td>
                            {% if room.is_available %}
                                <i class="check icon green"></i> {{ 'room.list.yes'|trans }}
                            {% else %}
                                <i class="times icon red"></i> {{ 'room.list.no'|trans }}
                            {% endif %}
                        </td>
                        <td>
                            <a href="/admin/rooms/show?id={{ room.id }}" class="ui icon button">
                                <i class="eye icon"></i>
                            </a>
                            <a href="/admin/rooms/edit?id={{ room.id }}" class="ui icon button">
                                <i class="edit icon"></i>
                            </a>
                            <form action="/admin/rooms/delete" method="POST" style="display: inline;" onsubmit="return confirm('{{ 'room.list.confirm_delete'|trans }}');">
                                <input type="hidden" name="id" value="{{ room.id }}">
                                <button type="submit" class="ui icon button red">
                                    <i class="trash icon"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="center aligned">{{ 'room.list.no_rooms'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}