{% extends "layouts/public.html.twig" %}

{% block title %}{{ 'user.login.title'|trans({'%clinic_name%': clinic_name}) }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container" style="max-width: 400px; padding: 2rem 0;">
            <div style="border: var(--border-medium); background: var(--color-bg-alt); padding: 1.5rem;">
                <header class="section__header" style="text-align: center; margin-bottom: 1.5rem;">
                    <div class="section__eyebrow">{{ 'user.login.title_full'|trans }}</div>
                    <h1 class="section__title section__title--compact" style="margin-bottom: 0.5rem;">{{ 'user.login.subtitle'|trans }}</h1>
                    <p class="section__description" style="font-size: 0.75rem; opacity: 0.8;">{{ 'user.login.description'|trans }}</p>
                </header>

                {% if errors.login ?? null %}
                    <div style="border: var(--border-medium); background: #ffe6e6; padding: 0.8rem; margin-bottom: 1.5rem; color: var(--color-alert); font-weight: 700; font-size: 0.85rem; text-align: center;">
                        <strong>{{ 'user.login.login_error'|trans }}</strong> {{ errors.login ?? '' }}
                    </div>
                {% endif %}
                {% if (errors.email ?? null) or (errors.password ?? null) %}
                    <div style="border: var(--border-medium); background: #ffe6e6; padding: 0.8rem; margin-bottom: 1.5rem; color: var(--color-alert); font-weight: 700; font-size: 0.85rem;">
                        <ul style="list-style: none; margin: 0; padding: 0;">
                            {% if errors.email ?? null %}<li style="margin-bottom: 0.2rem;">{{ errors.email ?? '' }}</li>{% endif %}
                            {% if errors.password ?? null %}<li>{{ errors.password ?? '' }}</li>{% endif %}
                        </ul>
                    </div>
                {% endif %}

                <form method="POST" action="{{ path('login_post') }}" style="display: grid; gap: 1rem;" autocomplete="on">
                    <div>
                        <label class="booking-label">{{ 'user.login.email'|trans }}</label>
                        <input class="booking-input" type="email" name="email" value="{{ old.email ?? '' }}" placeholder="{{ 'user.login.email_placeholder'|trans }}" required autocomplete="email">
                    </div>
                    <div>
                        <label class="booking-label">{{ 'user.login.password'|trans }}</label>
                        <input class="booking-input" type="password" name="password" placeholder="{{ 'user.login.password_placeholder'|trans }}" required autocomplete="current-password">
                    </div>
                    <div style="margin-top: 1rem;">
                        <button type="submit" class="btn btn--primary" style="width: 100%;">{{ 'user.login.login_button'|trans }}</button>
                    </div>
                </form>

                {% if authConfigs is defined and authConfigs|length %}
                    <div style="text-align: center; margin: 1.5rem 0; font-size: 0.75rem; text-transform: uppercase; border-top: var(--border-thin); padding-top: 1.5rem; position: relative;">
                        <span style="background: var(--color-bg-alt); padding: 0 0.5rem; position: absolute; top: -0.75rem; left: 50%; transform: translateX(-50%);">{{ 'user.login.or'|trans }}</span>
                    </div>
                    <div style="display: grid; gap: 0.8rem;">
                        {% for config in authConfigs %}
                            <a href="/oauth/redirect/{{ config.provider }}" class="btn btn--ghost" style="width: 100%;">
                                {# <i class="fab fa-{{ config.provider }}"></i> #} {{ 'user.login.login_via'|trans({'%provider%': config.provider|capitalize}) }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

                <p style="text-align: center; font-size: 0.75rem; opacity: 0.8; margin-top: 1.5rem;">{{ 'user.login.no_access'|trans }}</p>
            </div>
        </div>
    </section>
{% endblock %}