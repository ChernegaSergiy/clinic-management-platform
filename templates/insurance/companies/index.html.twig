{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'insurance.companies.list.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'insurance.companies.list.header'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="/insurance/companies/new" class="ui primary button">
                    <i class="plus icon"></i> {{ 'insurance.companies.list.add_company'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>{{ 'insurance.companies.list.table.id'|trans }}</th>
                    <th>{{ 'insurance.companies.list.table.name'|trans }}</th>
                    <th>{{ 'insurance.companies.list.table.contact_person'|trans }}</th>
                    <th>{{ 'insurance.companies.list.table.phone'|trans }}</th>
                    <th>{{ 'insurance.companies.list.table.email'|trans }}</th>
                    <th>{{ 'insurance.companies.list.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for company in companies %}
                    <tr>
                        <td>{{ company.id }}</td>
                        <td>{{ company.name }}</td>
                        <td>{{ company.contact_person }}</td>
                        <td>{{ company.phone }}</td>
                        <td>{{ company.email }}</td>
                        <td>
                            <a href="/insurance/companies/show?id={{ company.id }}" class="ui icon button">
                                <i class="eye icon"></i>
                            </a>
                            <a href="/insurance/companies/edit?id={{ company.id }}" class="ui icon button">
                                <i class="edit icon"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="center aligned">{{ 'insurance.companies.list.no_companies'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
