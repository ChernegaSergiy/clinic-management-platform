{% extends "layouts/public.html.twig" %}

{% block title %}Встановлення системи — Клініка{% endblock %}

{% block body %}
    <section id="installer" class="section">
        <div class="container">
            <header class="section__header">
                <div class="section__eyebrow">Інсталятор</div>
                <h1 class="section__title">Перевірка готовності системи</h1>
                <p class="section__description">Ця сторінка аналізує ваше середовище та дає інструкції для запуску платформи.</p>
            </header>

            <div class="departments-grid" style="grid-template-columns: minmax(0, 1fr);">
                <div class="departments-list">
                    <div class="dept-category">Крок 1: Перевірка середовища</div>
                    
                    <article class="department-item">
                        <div class="department-item__name">{% if checks.env_file.status %}✓{% else %}✗{% endif %} .env Файл</div>
                        <div class="department-item__meta">{{ checks.env_file.message|raw }}</div>
                    </article>
                    
                    <article class="department-item">
                        <div class="department-item__name">{% if checks.php_version.status %}✓{% else %}✗{% endif %} Версія PHP</div>
                        <div class="department-item__meta">{{ checks.php_version.message|raw }}</div>
                    </article>
                    
                    <article class="department-item">
                        <div class="department-item__name">{% if checks.php_extensions|reduce((carry, item) => carry and item.status, true) %}✓{% else %}✗{% endif %} Розширення PHP</div>
                        {% for ext_name, ext_check in checks.php_extensions %}
                            <div class="department-item__meta" style="padding-left: 1rem;">{% if ext_check.status %}✓{% else %}✗{% endif %} {{ ext_check.message|raw }}</div>
                        {% endfor %}
                    </article>

                    <article class="department-item">
                        <div class="department-item__name">{% if checks.dir_permissions|reduce((carry, item) => carry and item.status, true) %}✓{% else %}✗{% endif %} Права доступу</div>
                        {% for dir_name, dir_check in checks.dir_permissions %}
                            <div class="department-item__meta" style="padding-left: 1rem;">{% if dir_check.status %}✓{% else %}✗{% endif %} {{ dir_check.message|raw }}</div>
                        {% endfor %}
                    </article>

                    <div class="dept-category" style="margin-top: 1rem;">Крок 2: База даних</div>

                    {% if checks.db_connection is defined %}
                        <article class="department-item">
                            <div class="department-item__name">{% if checks.db_connection.status %}✓{% else %}✗{% endif %} Підключення до БД</div>
                            <div class="department-item__meta">{{ checks.db_connection.message|raw }}</div>
                        </article>
                    {% endif %}

                    {% if checks.migrations is defined %}
                        <article class="department-item">
                            <div class="department-item__name">{% if checks.migrations.status %}✓{% else %}✗{% endif %} Статус міграцій</div>
                            <div class="department-item__meta">{{ checks.migrations.message|raw }}</div>
                        </article>
                    {% endif %}

                    {% if checks.seeding is defined %}
                        <article class="department-item">
                            <div class="department-item__name">{% if checks.seeding.status %}✓{% else %}✗{% endif %} Наповнення даними (Seeding)</div>
                            <div class="department-item__meta">{{ checks.seeding.message|raw }}</div>
                        </article>
                    {% endif %}
                    
                    {% if allOk %}
                         <div class="dept-category" style="margin-top: 1rem; background: #e8f5e9;">Завершення</div>
                         <article class="department-item">
                            <div class="department-item__name">Систему успішно налаштовано!</div>
                            <div class="department-item__meta">Тепер ви можете перейти до сторінки входу.</div>
                            <div style="margin-top: 1rem;">
                                 <a class="btn btn--primary" href="/login">Перейти до входу</a>
                            </div>
                        </article>
                        <article class="department-item" style="background: #fffde7;">
                            <div class="department-item__name">Важливий крок безпеки</div>
                            <div class="department-item__meta">Для уникнення потенційних ризиків, будь ласка, видаліть файл <strong>src/Controller/InstallController.php</strong> та відповідний роут.</div>
                        </article>
                    {% else %}
                        <div class="dept-category" style="margin-top: 1rem; background: #fce8e6;">Потрібні дії</div>
                        <article class="department-item">
                            <div class="department-item__name">Не всі перевірки пройдено</div>
                            <div class="department-item__meta">Будь ласка, виконайте інструкції, зазначені вище, щоб завершити налаштування системи.</div>
                        </article>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
