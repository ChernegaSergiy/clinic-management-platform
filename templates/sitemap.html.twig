{% extends "layouts/public.html.twig" %}

{% block title %}Карта сайту — {{ clinic_name }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <header class="section__header">
                <div class="section__eyebrow">Навігація</div>
                <h1 class="section__title">Карта сайту</h1>
                <p class="section__description">Швидкі посилання на основні розділи клініки.</p>
            </header>
            <div class="about-block"> {# Using a general content block class from clinic-manager #}
                <div class="about-block__content">
                    <div class="contacts-grid" style="grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem;"> {# Using contacts-grid for a two-column layout #}
                        <article class="contact-block"> {# Using contact-block for content grouping #}
                            <div class="contact-block__title">Публічні сторінки</div>
                            <ul class="time-table"> {# Re-using time-table for list styling #}
                                <li><a href="/">Головна</a></li>
                                <li><a href="/about">Про клініку</a></li>
                                <li><a href="/contact">Контакти</a></li>
                                <li><a href="/book-appointment">Записатися</a></li>
                                <li><a href="/privacy">Політика конфіденційності</a></li>
                            </ul>
                        </article>
                        <article class="contact-block"> {# Using contact-block for content grouping #}
                            <div class="contact-block__title">Службові</div>
                            <ul class="time-table"> {# Re-using time-table for list styling #}
                                <li><a href="/login">Вхід для персоналу</a></li>
                                <li><a href="/appointments">Календар записів</a></li>
                                <li><a href="/dashboard">Панель</a></li>
                            </ul>
                        </article>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
