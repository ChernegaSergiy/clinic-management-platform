{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui padded grid">
        <div class="row">
            <div class="ten wide column">
                <h1 class="ui huge dividing header">{{ 'dashboard.panel'|trans }}</h1>
                <div class="ui mini horizontal divided list" style="margin-top:-8px;">
                    <div class="item"><i class="clock outline icon"></i>{{ 'dashboard.updated_now'|trans }}</div>
                    <div class="item"><i class="bell outline icon"></i>{{ 'dashboard.notifications'|trans }}: {{ dashboardData.quickStats.lab_pending ?? 0 }} {{ 'dashboard.lab_pending'|trans }}, {{ dashboardData.quickStats.low_stock ?? 0 }} {{ 'dashboard.low_stock'|trans }}</div>
                </div>
            </div>
            {% if canExport %}
                <div class="six wide column right aligned">
                    <div class="ui mini basic buttons">
                        <a href="{{ path('dashboard_export_csv') }}" class="ui button">{{ 'dashboard.export.csv'|trans }}</a>
                        <a href="{{ path('dashboard_export_pdf') }}" class="ui button">{{ 'dashboard.export.pdf'|trans }}</a>
                        <a href="{{ path('dashboard_export_excel') }}" class="ui button">{{ 'dashboard.export.excel'|trans }}</a>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="row">
            <div class="sixteen wide column">
                <h3 class="ui header">{{ 'dashboard.quick_stats.title'|trans }}</h3>
                <div class="ui five stackable cards">
                    <div class="blue card">
                        <div class="content">
                            <div class="header"><i class="users icon"></i> {{ 'dashboard.quick_stats.patients'|trans }}</div>
                            <div class="description"><span class="ui huge header">{{ dashboardData.quickStats.patients_total|default(0) }}</span></div>
                        </div>
                    </div>
                    <div class="teal card">
                        <div class="content">
                            <div class="header"><i class="calendar check icon"></i> {{ 'dashboard.quick_stats.appointments_today'|trans }}</div>
                            <div class="description"><span class="ui huge header">{{ dashboardData.quickStats.appointments_today|default(0) }}</span></div>
                        </div>
                    </div>
                    {% if canSeeFinance %}
                        <div class="green card">
                            <div class="content">
                                <div class="header"><i class="dollar sign icon"></i> {{ 'dashboard.quick_stats.revenue_7d'|trans }}</div>
                                <div class="description"><span class="ui huge header">{{ dashboardData.quickStats.revenue_7d|default(0)|number_format(0, '.', ',') }} ₴</span></div>
                            </div>
                        </div>
                    {% endif %}
                    <div class="orange card">
                        <div class="content">
                            <div class="header"><i class="flask icon"></i> {{ 'dashboard.quick_stats.lab_in_progress'|trans }}</div>
                            <div class="description"><span class="ui huge header">{{ dashboardData.quickStats.lab_pending|default(0) }}</span></div>
                        </div>
                    </div>
                    <div class="red card">
                        <div class="content">
                            <div class="header"><i class="warehouse icon"></i> {{ 'dashboard.quick_stats.low_stock'|trans }}</div>
                            <div class="description"><span class="ui huge header">{{ dashboardData.quickStats.low_stock|default(0) }}</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% if canSeeKpi %}
            <div class="ui hidden divider"></div>
            <div class="row">
                <div class="sixteen wide column">
                    <h3 class="ui header">{{ 'dashboard.kpi.title'|trans }}</h3>
                    {% if dashboardData.kpis is not empty %}
                        <div class="ui five statistics">
                            {% for kpi_type, kpi_data in dashboardData.kpis %}
                                <div class="ui statistic">
                                    <div class="value">
                                        <i class="chart line icon"></i>
                                        {{ kpi_data.latest_value|number_format(kpi_data.definition.unit == '₴' ? 2 : (kpi_data.definition.unit == '%' ? 1 : 0), '.', ',') }}
                                        {% if kpi_data.definition.unit == '₴' %}<small>₴</small>{% endif %}
                                        {% if kpi_data.definition.unit and kpi_data.definition.unit != '₴' %}
                                            <small>{{ kpi_data.definition.unit }}</small>
                                        {% endif %}
                                    </div>
                                    <div class="label">{{ kpi_data.definition.name }}</div>
                                    {% if kpi_data.definition.target_value is not null %}
                                        <div class="ui tiny grey sub header">{{ 'dashboard.kpi.target'|trans }}: {{ kpi_data.definition.target_value }}{% if kpi_data.definition.unit %} {{ kpi_data.definition.unit }}{% endif %}</div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="ui placeholder segment">
                            <div class="ui icon header">
                                <i class="chart bar outline icon"></i>
                                {{ 'dashboard.kpi.no_kpis'|trans }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        {% if canSeeFinance %}
            <div class="ui hidden section divider"></div>
            <div class="row">
                <h1 class="ui huge dividing header">{{ 'dashboard.kpi.revenue_7d_title'|trans }}</h1>
                <div class="sixteen wide column">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        {% endif %}

        {% if canSeeKpi %}
            <div class="ui hidden section divider"></div>
            <div class="row">
                <h1 class="ui huge dividing header">{{ 'dashboard.kpi.summary_table_title'|trans }}</h1>
            </div>
            <div class="row">
                <table class="ui celled stackable table">
                    <thead>
                    <tr>
                        <th>{{ 'dashboard.kpi.table.indicator'|trans }}</th>
                        <th>{{ 'dashboard.kpi.table.current_value'|trans }}</th>
                        <th>{{ 'dashboard.kpi.table.change'|trans }}</th>
                        <th>{{ 'dashboard.kpi.table.comment'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for kpi_type, kpi_data in dashboardData.kpis %}
                        <tr>
                            <td>{{ kpi_data.definition.name }}</td>
                            <td>
                                {{ kpi_data.latest_value|number_format(kpi_data.definition.unit == '₴' ? 2 : 0, '.', ',') }}
                                {% if kpi_data.definition.unit == '₴' %}<small>₴</small>{% endif %}
                                {% if kpi_data.definition.unit and kpi_data.definition.unit != '₴' %}
                                    <small>{{ kpi_data.definition.unit }}</small>
                                {% endif %}
                            </td>
                            <td>
                                {% if kpi_data.trend %}
                                    {% if kpi_data.trend starts with '+' %}
                                        <i class="icon arrow up green"></i>
                                    {% elseif kpi_data.trend starts with '-' %}
                                        <i class="icon arrow down red"></i>
                                    {% else %}
                                        <i class="icon minus grey"></i>
                                    {% endif %}
                                    {{ kpi_data.trend }}
                                {% else %}
                                    {{ 'dashboard.kpi.na'|trans }}
                                {% endif %}
                            </td>
                            <td>{{ kpi_data.definition.description|default('dashboard.kpi.no_description'|trans) }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="center aligned">{{ 'dashboard.kpi.no_data'|trans }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <style>
        @media (max-width: 767px) {
            .ui.mini.basic.buttons {
                display: flex;
                flex-direction: column;
                width: 100%;
                gap: 8px;
            }
            .ui.mini.basic.buttons .button {
                width: 100%;
            }
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const revenueChartData = {{ dashboardData.revenueChart|json_encode|raw }};
            const ctx = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: revenueChartData.labels,
                        datasets: [{
                            label: '{{ 'dashboard.kpi.daily_revenue_label'|trans }}',
                            data: revenueChartData.data,
                            backgroundColor: 'rgba(75, 192, 192, 0.6)',
                            borderColor: 'rgba(75, 192, 192, 1)',
                            borderWidth: 1
                        }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                        },
                        title: {
                            display: true,
                            text: '{{ 'dashboard.kpi.daily_revenue_title'|trans }}'
                        }
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: '{{ 'dashboard.kpi.date'|trans }}'
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: '{{ 'dashboard.kpi.revenue'|trans }}'
                            }
                        }
                    }
                }
            });
        });
    </script>
{% endblock %}
