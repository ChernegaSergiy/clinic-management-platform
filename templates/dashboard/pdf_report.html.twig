<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>{{ 'dashboard.pdf_report.title'|trans }}</title>
    <style>
        body { font-family: 'DejaVu Sans', 'dejavusans', sans-serif; }
        h1 {
            text-align: center;
            color: #444;
            border-bottom: 2px solid #f2f2f2;
            padding-bottom: 10px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
            font-weight: bold;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
    </style>
</head>
<body>
    <h1>{{ 'dashboard.pdf_report.title'|trans }}</h1>
    <p><strong>{{ 'dashboard.pdf_report.report_generation_date'|trans }}</strong> {{ "now"|date("Y-m-d H:i:s") }}</p>
    <table>
        <thead>
            <tr>
                <th>{{ 'dashboard.pdf_report.indicator'|trans }}</th>
                <th>{{ 'dashboard.pdf_report.value'|trans }}</th>
                <th>{{ 'dashboard.pdf_report.trend'|trans }}</th>
                <th>{{ 'dashboard.pdf_report.description'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for kpi_type, kpi_data in dashboardData %}
                <tr>
                    <td>{{ kpi_data.definition.name }}</td>
                    <td>
                        {{ kpi_data.latest_value|number_format(kpi_data.definition.unit == '₴' ? 2 : 0, '.', ',') }}
                        {% if kpi_data.definition.unit %}<small> {{ kpi_data.definition.unit }}</small>{% endif %}
                    </td>
                    <td>{{ kpi_data.trend|default('N/A') }}</td>
                    <td>{{ kpi_data.definition.description|default('') }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" style="text-align: center;">{{ 'dashboard.pdf_report.no_data_available'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
