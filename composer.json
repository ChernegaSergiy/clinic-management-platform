{
    "name": "chernegasergiy/clinical-management-platform",
    "description": "A Clinic Management Platform",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Serhii Cherneha",
            "email": "chernegasergiy3@gmail.com"
        },
        {
            "name": "Andrii Hevko",
            "email": "gevkoandrij24@gmail.com"
        },
        {
            "name": "Maksym Reminskyi",
            "email": "makztezerest@gmail.com"
        }
    ],
    "require": {
        "twig/twig": "^3.22",
        "symfony/yaml": "^7.3",
        "symfony/translation": "^7.0",
        "symfony/twig-bridge": "^7.0",
        "symfony/contracts": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "chillerlan/php-qrcode": "^5.0",
        "dompdf/dompdf": "^3.1",
        "maennchen/zipstream-php": "^3.1",
        "phpoffice/phpspreadsheet": "^5.2",
        "chernegasergiy/nk-025-2021-parser": "^0.1.0",
        "chernegasergiy/nk-026-2021-parser": "^0.1.0",
        "robmorgan/phinx": "^0.16.10",
        "league/oauth2-client": "^2.8",
        "league/oauth2-google": "^4.0",
        "league/oauth2-facebook": "^2.2",
        "league/oauth2-github": "^3.1",
        "spomky-labs/otphp": "^11.3",
        "symfony/intl": "^7.4",
        "symfony/console": "^7.4",
        "symfony/config": "^7.0",
        "symfony/finder": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/process": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/event-dispatcher": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcbf --standard=PSR12 --ignore=vendor/ public/ src/",
        "cs-check": "phpcs --standard=PSR12 --ignore=vendor/ public/ src/",
        "stan": "phpstan analyse",
        "db:migrate": "phinx migrate",
        "db:rollback": "phinx rollback",
        "db:create": "phinx create",
        "db:seed": "phinx seed:run"
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
