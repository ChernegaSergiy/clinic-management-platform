{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'medical_record.list.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'medical_record.list.title_full'|trans }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="GET" action="/medical-records">
            <div class="field">
                <div class="ui icon input">
                    <input type="text" name="search" placeholder="{{ 'medical_record.list.search_placeholder'|trans }}" value="{{ searchTerm ?? '' }}">
                    <i class="search icon"></i>
                </div>
            </div>
        </form>

        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>{{ 'medical_record.list.table.id'|trans }}</th>
                    <th>{{ 'medical_record.list.table.visit_date'|trans }}</th>
                    <th>{{ 'medical_record.list.table.diagnosis'|trans }}</th>
                    <th>{{ 'medical_record.list.table.patient'|trans }}</th>
                    <th>{{ 'medical_record.list.table.doctor'|trans }}</th>
                    <th>{{ 'medical_record.list.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for record in records %}
                    <tr>
                        <td>{{ record.id }}</td>
                        <td>{{ record.visit_date|date('Y-m-d H:i') }}</td>
                        <td>{{ record.diagnosis_code }}</td>
                        <td>{{ record.patient_name }}</td>
                        <td>{{ record.doctor_name }}</td>
                        <td>
                            <a href="/medical-records/show?id={{ record.id }}" class="ui icon button">
                                <i class="eye icon"></i>
                            </a>
                            <a href="/medical-records/edit?id={{ record.id }}" class="ui icon button">
                                <i class="edit icon"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="center aligned">{{ 'medical_record.list.no_records'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}