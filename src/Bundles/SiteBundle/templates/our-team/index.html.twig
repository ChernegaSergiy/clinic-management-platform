{% extends "layouts/public.html.twig" %}

{% block title %}Команда розробників — {{ clinic_name }}{% endblock %}

{% block body %}
        <section id="our-team" class="section">
            <div class="container">
                <header class="section__header">
                    <div class="section__eyebrow">Про нас</div>
                    <h1 class="section__title">Команда розробників проєкту</h1>
                    <p class="section__description">Студенти ВНТУ створюють клінічну систему управління з нуля, поєднуючи теоретичні знання з практичною реалізацією.</p>
                </header>
                <div class="doctors-grid">
                    <article class="doctor-card">
                         <div class="doctor-avatar">
                             <img src="/images/team/sergey.jpg" alt="Сергій Чернега">
                         </div>
                        <div class="doctor-info">
                            <div class="doctor-info__name">Сергій Чернега</div>
                            <div class="doctor-info__role">Розробник</div>
                            <div class="doctor-info__meta">Студент ВНТУ, який у рамках цього навчального проєкту виконує обов'язки розробника, відповідає за серверну реалізацію та SSO.</div>
                             <div class="doctor-tags"><span class="tag">Backend</span><span class="tag">SSO</span></div>
                        </div>
                    </article>
                    <article class="doctor-card">
                         <div class="doctor-avatar">
                             <img src="/images/team/andriy.jpg" alt="Андрій Гевко">
                         </div>
                        <div class="doctor-info">
                            <div class="doctor-info__name">Андрій Гевко</div>
                            <div class="doctor-info__role">Дизайнер</div>
                            <div class="doctor-info__meta">Студент ВНТУ, який займає позицію дизайнера, бере безпосередню участь у технічній реалізації функціоналу та наповненні сайту контентом, сторінки про команду.</div>
                            <div class="doctor-tags"><span class="tag">UI/UX</span><span class="tag">Контент</span></div>
                        </div>
                    </article>
                    <article class="doctor-card">
                         <div class="doctor-avatar">
                             <img src="/images/team/maxim.jpg" alt="Максим Ремінський">
                         </div>
                        <div class="doctor-info">
                            <div class="doctor-info__name">Максим Ремінський</div>
                            <div class="doctor-info__role">Бізнес-аналітик</div>
                            <div class="doctor-info__meta">Студент ВНТУ, що виступає бізнес-аналітиком, проєкту та відповідає за якість коду та безперервну інтеграцію.</div>
                             <div class="doctor-tags"><span class="tag">QA</span><span class="tag">CI/CD</span></div>
                        </div>
                    </article>
                </div>
            </div>
        </section>
{% endblock %}