{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'dashboard.simple.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui padded grid">
        <div class="row">
            <h1 class="ui huge dividing header">{{ 'dashboard.simple.panel'|trans }}</h1>
        </div>
        <div class="center aligned row">
            <div class="eight wide mobile four wide tablet four wide computer column">
                <img class="ui centered small circular image" src="/assets/dashboard/wireframe/square-image.png" alt="{{ 'dashboard.simple.patients'|trans }}">
                <div class="ui large basic label">{{ 'dashboard.simple.patients'|trans }}</div>
                <p>{{ 'dashboard.simple.active'|trans }}: {{ patient_count }}</p>
            </div>
            <div class="eight wide mobile four wide tablet four wide computer column">
                <img class="ui centered small circular image" src="/assets/dashboard/wireframe/square-image.png" alt="{{ 'dashboard.simple.appointments'|trans }}">
                <div class="ui large basic label">{{ 'dashboard.simple.appointments'|trans }}</div>
                <p>{{ 'dashboard.simple.upcoming'|trans }}: {{ upcoming_appointments_count }}</p>
            </div>
            <div class="eight wide mobile four wide tablet four wide computer column">
                <img class="ui centered small circular image" src="/assets/dashboard/wireframe/square-image.png" alt="{{ 'dashboard.simple.inventory'|trans }}">
                <div class="ui large basic label">{{ 'dashboard.simple.inventory'|trans }}</div>
                <p>{{ 'dashboard.simple.low_stock'|trans }}: {{ low_stock_items_count }}</p>
            </div>
            <div class="eight wide mobile four wide tablet four wide computer column">
                <img class="ui centered small circular image" src="/assets/dashboard/wireframe/square-image.png" alt="{{ 'dashboard.simple.profile'|trans }}">
                <div class="ui large basic label">{{ 'dashboard.simple.profile'|trans }}</div>
                <p>{{ 'dashboard.simple.update_profile_data'|trans }}</p>
            </div>
        </div>
        <div class="ui hidden section divider"></div>
        <div class="row">
            <h1 class="ui huge dividing header">{{ 'dashboard.simple.upcoming_appointments_and_stock'|trans }}</h1>
        </div>
        <div class="row">
            <div class="sixteen wide mobile eight wide tablet eight wide computer column">
                <h3 class="ui header">{{ 'dashboard.simple.upcoming_appointments'|trans }}</h3>
                {% if upcoming_appointments is empty %}
                    <div class="ui message">{{ 'dashboard.simple.no_upcoming_appointments'|trans }}</div>
                {% else %}
                    <table class="ui single line striped selectable unstackable table">
                        <thead>
                        <tr>
                            <th>{{ 'dashboard.simple.patient'|trans }}</th>
                            <th>{{ 'dashboard.simple.doctor'|trans }}</th>
                            <th>{{ 'dashboard.simple.time'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for appointment in upcoming_appointments %}
                            <tr>
                                <td>{{ appointment.patient_name }}</td>
                                <td>{{ appointment.doctor_name }}</td>
                                <td>{{ appointment.start_time|date('Y-m-d H:i') }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
            <div class="sixteen wide mobile eight wide tablet eight wide computer column">
                <h3 class="ui header">{{ 'dashboard.simple.low_stock_items'|trans }}</h3>
                {% if low_stock_items is empty %}
                    <div class="ui message">{{ 'dashboard.simple.no_low_stock_items'|trans }}</div>
                {% else %}
                    <table class="ui single line striped selectable unstackable table">
                        <thead>
                        <tr>
                            <th>{{ 'dashboard.simple.name'|trans }}</th>
                            <th>{{ 'dashboard.simple.quantity'|trans }}</th>
                            <th>{{ 'dashboard.simple.min_level'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for item in low_stock_items %}
                            <tr>
                                <td>{{ item.name }}</td>
                                <td>{{ item.quantity }}</td>
                                <td>{{ item.min_stock_level }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
