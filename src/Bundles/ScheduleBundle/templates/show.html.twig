{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'schedule.show.title'|trans({'%full_name%': doctor.full_name}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'schedule.show.title_full'|trans({'%full_name%': doctor.full_name}) }}</h2>

        <a href="/admin/schedules/edit?id={{ doctor.id }}" class="ui primary button">
            <i class="edit icon"></i>
            {{ 'schedule.show.edit_schedule'|trans }}
        </a>
        <a href="/admin/schedules" class="ui button">
            <i class="arrow left icon"></i>
            {{ 'schedule.show.back_to_list'|trans }}
        </a>

        <div class="ui divider"></div>

        <div class="ui stackable seven column grid">
            {% for day_num, day_name in {1: 'schedule.show.days.1'|trans, 2: 'schedule.show.days.2'|trans, 3: 'schedule.show.days.3'|trans, 4: 'schedule.show.days.4'|trans, 5: 'schedule.show.days.5'|trans, 6: 'schedule.show.days.6'|trans, 0: 'schedule.show.days.0'|trans} %}
                {% set schedule_entry = scheduleByDay[day_num] ?? null %}
                
                {% set card_color = 'grey' %}
                {% if schedule_entry and schedule_entry.is_available %}
                    {% set card_color = 'green' %}
                {% elseif schedule_entry %}
                    {% set card_color = 'red' %}
                {% endif %}

                <div class="column">
                    <div class="ui {{ card_color }} card">
                        <div class="content">
                            <div class="header">{{ day_name }}</div>
                            <div class="meta">
                                {% if schedule_entry and schedule_entry.is_available %}
                                    <i class="check circle icon"></i> Робочий день
                                {% elseif schedule_entry %}
                                    <i class="times circle icon"></i> Вихідний
                                {% else %}
                                    <i class="question circle outline icon"></i> Не встановлено
                                {% endif %}
                            </div>
                            <div class="description">
                                {% if schedule_entry and schedule_entry.is_available %}
                                    <p><i class="clock outline icon"></i> {{ schedule_entry.start_time|slice(0, 5) }} - {{ schedule_entry.end_time|slice(0, 5) }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
