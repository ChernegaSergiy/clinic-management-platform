{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.auth_configs.edit.title'|trans({'%id%': config.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.auth_configs.edit.title_full'|trans({'%id%': config.id}) }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/auth_configs/edit?id={{ config.id }}">
            <div class="field {% if errors.provider ?? null %}error{% endif %}">
                <label>{{ 'admin.auth_configs.edit.provider'|trans }}</label>
                <select name="provider" class="ui fluid dropdown" required>
                    <option value="">{{ 'admin.auth_configs.edit.select_provider'|trans }}</option>
                    {% for providerOption in supportedProviders %}
                        <option value="{{ providerOption }}" {% if (old.provider == providerOption) or (config.provider == providerOption and old.provider is not defined) %}selected{% endif %}>
                            {{ providerOption|capitalize }}
                        </option>
                    {% endfor %}
                </select>
                {% if errors.provider ?? null %}<div class="ui basic red pointing prompt label">{{ (errors.provider ?? null)[0] ?? '' }}</div>{% endif %}
            </div>
            {{ forms.input('client_id', 'admin.auth_configs.edit.client_id'|trans, old.client_id ?? config.client_id, 'text', 'admin.auth_configs.edit.client_id_placeholder'|trans, errors.client_id ?? null) }}
            {{ forms.input('client_secret', 'admin.auth_configs.edit.client_secret'|trans, old.client_secret ?? config.client_secret, 'text', 'admin.auth_configs.edit.client_secret_placeholder'|trans, errors.client_secret ?? null) }}
            {{ forms.textarea('config', 'admin.auth_configs.edit.config'|trans, old.config ?? config.config, 'admin.auth_configs.edit.config_placeholder'|trans, errors.config ?? null) }}

            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_active" {% if (old.is_active is defined and old.is_active) or (old.is_active is not defined and config.is_active) %}checked{% endif %} value="1">
                    <label>{{ 'admin.auth_configs.edit.is_active'|trans }}</label>
                </div>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('admin.auth_configs.edit.save'|trans, 'primary', '', 'save') }}
            <a href="/admin/auth_configs" class="ui button"><i class="arrow left icon"></i> {{ 'admin.auth_configs.edit.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}
