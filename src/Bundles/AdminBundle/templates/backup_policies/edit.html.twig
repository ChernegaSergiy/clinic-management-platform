{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.backup_policies.edit.title'|trans({'%id%': policy.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.backup_policies.edit.header'|trans({'%id%': policy.id}) }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/backup_policies/edit?id={{ policy.id }}">
            {{ forms.input('name', 'admin.backup_policies.new.name'|trans, old.name ?? policy.name, 'text', 'admin.backup_policies.new.name_placeholder'|trans, errors.name ?? null, {'required': 'required'}) }}
            {{ forms.textarea('description', 'admin.backup_policies.new.description'|trans, old.description ?? policy.description, 'admin.backup_policies.new.description_placeholder'|trans, errors.description ?? null) }}
            {{ forms.input('frequency', 'admin.backup_policies.new.frequency'|trans, old.frequency ?? policy.frequency, 'text', 'admin.backup_policies.new.frequency_placeholder'|trans, errors.frequency ?? null, {'required': 'required'}) }}
            {{ forms.input('retention_days', 'admin.backup_policies.new.retention_days'|trans, old.retention_days ?? policy.retention_days, 'number', 'admin.backup_policies.new.retention_days_placeholder'|trans, errors.retention_days ?? null, {'required': 'required', 'min': '1'}) }}

            <div class="field">
                <label>{{ 'admin.backup_policies.new.status_label'|trans }}</label>
                <select name="status" class="ui dropdown">
                    <option value="active" {% if (old.status is defined and old.status == 'active') or (old.status is not defined and policy.status == 'active') %}selected{% endif %}>{{ 'admin.backup_policies.new.status_active'|trans }}</option>
                    <option value="inactive" {% if (old.status is defined and old.status == 'inactive') or (old.status is not defined and policy.status == 'inactive') %}selected{% endif %}>{{ 'admin.backup_policies.new.status_inactive'|trans }}</option>
                </select>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('admin.backup_policies.edit.save_button'|trans, 'primary', '', 'save') }}
            <a href="/admin/backup_policies" class="ui button"><i class="arrow left icon"></i> {{ 'admin.backup_policies.new.cancel_button'|trans }}</a>
        </form>
    </div>
{% endblock %}