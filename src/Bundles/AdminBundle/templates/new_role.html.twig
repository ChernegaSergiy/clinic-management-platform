{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.roles.new.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.roles.new.title'|trans }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/roles/new">
            {{ forms.input('name', 'admin.roles.new.name'|trans, old.name ?? '', 'text', 'admin.roles.new.name_placeholder'|trans, errors.name ?? null, {'required': 'required'}) }}
            {{ forms.textarea('description', 'admin.roles.new.description'|trans, old.description ?? '', 'admin.roles.new.description_placeholder'|trans, errors.description ?? null) }}

            {{ ui.button('admin.roles.new.save'|trans, 'primary', 'large', 'save') }}
            <a href="/admin/roles" class="ui button">
                <i class="arrow left icon"></i> {{ 'admin.roles.new.cancel'|trans }}
            </a>
        </form>
    </div>
{% endblock %}
