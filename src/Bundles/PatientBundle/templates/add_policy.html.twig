{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'patient.add_policy.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'patient.add_policy.header'|trans({'%last_name%': patient.last_name, '%first_name%': patient.first_name}) }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" action="/patients/{{ patient.id }}/policies/store" method="POST">
            <div class="field">
                <label>{{ 'patient.add_policy.company_label'|trans }}</label>
                <select name="insurance_company_id" class="ui dropdown">
                    {% for company in insurance_companies %}
                        <option value="{{ company.id }}">{{ company.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="field">
                <label>{{ 'patient.add_policy.policy_number_label'|trans }}</label>
                <input type="text" name="policy_number" placeholder="{{ 'patient.add_policy.policy_number_placeholder'|trans }}" required>
            </div>
            <div class="field">
                <label>{{ 'patient.add_policy.group_number_label'|trans }}</label>
                <input type="text" name="group_number" placeholder="{{ 'patient.add_policy.group_number_placeholder'|trans }}">
            </div>
            <div class="two fields">
                <div class="field">
                    <label>{{ 'patient.add_policy.valid_from_label'|trans }}</label>
                    <input type="date" name="valid_from" required>
                </div>
                <div class="field">
                    <label>{{ 'patient.add_policy.valid_to_label'|trans }}</label>
                    <input type="date" name="valid_to">
                </div>
            </div>
            <div class="inline field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_active" checked>
                    <label>{{ 'patient.add_policy.is_active_label'|trans }}</label>
                </div>
            </div>

            <div class="ui divider"></div>

            <button class="ui primary button" type="submit">
                <i class="save icon"></i> {{ 'patient.add_policy.save_button'|trans }}
            </button>
            <a href="/patients/show?id={{ patient.id }}" class="ui button">
                <i class="arrow left icon"></i> {{ 'patient.add_policy.cancel_button'|trans }}
            </a>
        </form>
    </div>
{% endblock %}
