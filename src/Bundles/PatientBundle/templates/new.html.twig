{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'patient.new.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'patient.new.title'|trans }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/patients/new">
            <div class="three fields">
                {{ forms.input('last_name', 'patient.new.last_name'|trans, '', 'text', 'patient.new.last_name_placeholder'|trans, errors.last_name ?? null, {'required': 'required'}) }}
                {{ forms.input('first_name', 'patient.new.first_name'|trans, '', 'text', 'patient.new.first_name_placeholder'|trans, errors.first_name ?? null, {'required': 'required'}) }}
                {{ forms.input('middle_name', 'patient.new.middle_name'|trans, '', 'text', 'patient.new.middle_name_placeholder'|trans) }}
            </div>
            <div class="three fields">
                {{ forms.input('birth_date', 'patient.new.birth_date'|trans, '', 'date', '', errors.birth_date ?? null, {'required': 'required'}) }}
                {{ forms.select('gender', 'patient.new.gender'|trans, {'male': 'patient.new.genders.male'|trans, 'female': 'patient.new.genders.female'|trans, 'other': 'patient.new.genders.other'|trans}, '', errors.gender ?? null, {'required': 'required'}) }}
                {{ forms.input('phone', 'patient.new.phone'|trans, '', 'tel', 'patient.new.phone_placeholder'|trans, errors.phone ?? null, {'required': 'required'}) }}
            </div>
            <div class="two fields">
                {{ forms.input('email', 'patient.new.email'|trans, '', 'email', 'patient.new.email_placeholder'|trans, errors.email ?? null) }}
                {{ forms.input('address', 'patient.new.address'|trans, '', 'text', 'patient.new.address_placeholder'|trans) }}
            </div>
            <div class="three fields">
                {{ forms.input('tax_id', 'patient.new.tax_id'|trans, '', 'text', 'patient.new.tax_id_placeholder'|trans) }}
                {{ forms.input('document_id', 'patient.new.document_id'|trans, '', 'text', 'patient.new.document_id_placeholder'|trans) }}
                {{ forms.select('marital_status', 'patient.new.marital_status'|trans, {'single': 'patient.new.marital_statuses.single'|trans, 'married': 'patient.new.marital_statuses.married'|trans, 'divorced': 'patient.new.marital_statuses.divorced'|trans, 'widowed': 'patient.new.marital_statuses.widowed'|trans}, '', errors.marital_status ?? null) }}
            </div>
            <div class="ui divider"></div>

            {{ ui.button('patient.new.save'|trans, 'primary', '', 'save') }}
            <a href="/patients" class="ui button"><i class="arrow left icon"></i> {{ 'patient.new.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('.ui.dropdown').dropdown();
        });
    </script>
{% endblock %}
