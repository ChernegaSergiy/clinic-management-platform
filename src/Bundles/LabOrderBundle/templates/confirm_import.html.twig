{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'lab_order.confirm_import.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'lab_order.confirm_import.header'|trans }}</h2>
        <div class="ui divider"></div>

        {% if errors is not empty %}
            <div class="ui error message">
                <ul class="list">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if parsedData is empty %}
            <p>{{ 'lab_order.confirm_import.no_data'|trans }}</p>
        {% else %}
            <h3 class="ui header">{{ 'lab_order.confirm_import.review_header'|trans }}</h3>
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'lab_order.confirm_import.table.field'|trans }}</th>
                        <th>{{ 'lab_order.confirm_import.table.value'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ 'lab_order.confirm_import.table.file_type'|trans }}</td>
                        <td>{{ parsedData.type }}</td>
                    </tr>
                    <tr>
                        <td>{{ 'lab_order.confirm_import.table.order_code'|trans }}</td>
                        <td>{{ parsedData.parsed_data.order_code }}</td>
                    </tr>
                    {# Additional fields from parsedData can be displayed here #}
                    <tr>
                        <td>{{ 'lab_order.confirm_import.table.file_content'|trans }}</td>
                        <td><pre>{{ parsedData.content|slice(0, 500) }}...</pre></td>
                    </tr>
                </tbody>
            </table>

            <div class="ui divider"></div>

            <form class="ui form" action="/lab-orders/import/finalize" method="POST">
                <button class="ui green button" type="submit">{{ 'lab_order.confirm_import.confirm_button'|trans }}</button>
                <a href="/lab-orders/import" class="ui button">
                    <i class="arrow left icon"></i> {{ 'lab_order.confirm_import.cancel_button'|trans }}
                </a>
            </form>
        {% endif %}
    </div>
{% endblock %}
