{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'user.profile.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segments">
        <div class="ui segment">
            <h1 class="ui header">{{ 'user.profile.title_full'|trans }}</h1>
        </div>
        <div class="ui secondary segment">
            {% if successMessage %}
                <div class="ui success message" data-flash="success">
                    <i class="close icon"></i>
                    <div class="header">{{ 'user.profile.success'|trans }}</div>
                    <p>{{ successMessage }}</p>
                </div>
            {% endif %}
            {% if session.error_message %}
                <div class="ui error message" data-flash="error">
                    <i class="close icon"></i>
                    <div class="header">{{ 'user.profile.error'|trans }}</div>
                    <p>{{ session.error_message }}</p>
                </div>
                {% set _ = session.error_message is null %}
            {% endif %}

            <div class="ui grid">
                <div class="four wide column">
                    {% if user.profile_photo_path %}
                        <img class="ui medium circular image" src="{{ user.profile_photo_path }}" style="object-fit: cover; aspect-ratio: 1 / 1;" alt="{{ 'user.profile.profile_photo_alt'|trans }}">
                    {% else %}
                        <img class="ui medium circular image" src="/assets/images/default_user.png" alt="{{ 'user.profile.profile_photo_alt'|trans }}">
                    {% endif %}
                    <form action="/user/profile/upload-photo" method="POST" enctype="multipart/form-data" class="ui form" style="margin-top: 15px;">
                        <div class="field">
                            <label>{{ 'user.profile.change_photo'|trans }}</label>
                            <div class="ui action input">
                                <input type="text" id="photo-display" readonly placeholder="{{ 'user.profile.no_file_selected'|trans }}">
                                <label for="photo-upload" class="ui icon button"><i class="upload icon"></i></label>
                            </div>
                            <input type="file" id="photo-upload" name="profile_photo" style="display: none;" accept="image/*">
                        </div>
                        <button type="submit" class="ui primary button">{{ 'user.profile.upload_button'|trans }}</button>
                    </form>
                </div>
                <div class="twelve wide column">
                    <div class="ui list">
                        <div class="item">
                            <i class="user icon"></i>
                            <div class="content">
                                <strong>{{ 'user.profile.first_name_label'|trans }}</strong> {{ user.first_name }} {{ user.last_name }}
                            </div>
                        </div>
                        <div class="item">
                            <i class="envelope icon"></i>
                            <div class="content">
                                <strong>{{ 'user.profile.email_label'|trans }}</strong> {{ user.email }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if employee %}
                <div class="ui divider"></div>
                <h2 class="ui header">{{ 'user.profile.employee_info_header'|trans }}</h2>
                <div class="ui list">
                    <div class="item">
                        <i class="briefcase icon"></i>
                        <div class="content">
                            <strong>{{ 'user.profile.position_label'|trans }}</strong> {{ employee.position }}
                        </div>
                    </div>
                    <div class="item">
                        <i class="building icon"></i>
                        <div class="content">
                            <strong>{{ 'user.profile.department_label'|trans }}</strong> {{ employee.department|default('N/A') }}
                        </div>
                    </div>
                    <div class="item">
                        <i class="calendar alternate outline icon"></i>
                        <div class="content">
                            <strong>{{ 'user.profile.hire_date_label'|trans }}</strong> {{ employee.hire_date }}
                        </div>
                    </div>
                    <div class="item">
                        <i class="info circle icon"></i>
                        <div class="content">
                            <strong>{{ 'user.profile.status_label'|trans }}</strong> {{ employee.status }}
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="ui divider"></div>

            {% if mfaPolicy != 'disabled' %}
                <h2 class="ui header">{{ 'user.profile.mfa_header'|trans }}</h2>

                {% set mfaStatus = {
                    enabled: user.mfa_enabled,
                    type: user.mfa_type,
                    verified_at: user.mfa_verified_at
                } %}

                {% if mfaStatus.enabled %}
                    <div class="ui success message">
                        <i class="check circle icon"></i>
                        <div class="content">
                            <div class="header">{{ 'user.profile.mfa_enabled'|trans }}</div>
                            <p>{{ 'user.profile.mfa_type_label'|trans }}: {{ mfaStatus.type|upper }} | {{ 'user.profile.mfa_enabled_date_label'|trans }}: {{ user.mfa_verified_at|date('d.m.Y H:i') }}</p>
                        </div>
                    </div>

                    <div class="ui buttons">
                        <a href="/user/mfa/setup/{{ mfaStatus.type|lower }}?reset=1" class="ui button">{{ 'user.profile.mfa_reconfigure_button'|trans }}</a>
                        <div class="or" data-text="{{ 'user.profile.or_separator'|trans }}"></div>
                        <button type="button" class="ui red button" onclick="showDisableMfaModal()">{{ 'user.profile.mfa_disable_button'|trans }}</button>
                    </div>

                    <div class="ui divider"></div>

                    <h3 class="ui header">{{ 'user.profile.backup_codes_header'|trans }}</h3>
                    <p style="margin-bottom: 1rem;">{{ 'user.profile.backup_codes_description'|trans }}</p>

                    {% if session.new_backup_codes %}
                        <div class="ui success message">
                            <i class="check circle icon"></i>
                            <div class="header">{{ 'user.profile.backup_codes_updated_header'|trans }}</div>
                            <p>{{ 'user.profile.backup_codes_updated_message'|trans }}</p>
                        </div>

                        <div class="ui segment" style="background-color: #f8f9fa; margin-bottom: 1rem;">
                            <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                                {% for code in session.new_backup_codes %}
                                    <code style="padding: 8px 12px; background: #fff; border: 1px solid #ddd; border-radius: 4px; font-size: 14px;">{{ code }}</code>
                                {% endfor %}
                            </div>
                        </div>

                        <a href="/user/mfa/clear-backup-codes" class="ui primary button">{{ 'user.profile.understood_button'|trans }}</a>

                        <div class="ui divider"></div>
                    {% endif %}

                    <form action="/user/mfa/regenerate-backup-codes" method="POST" onsubmit="return confirm('{{ 'user.profile.regenerate_backup_codes_confirm'|trans }}');">
                        <div class="ui form">
                            <div class="required field">
                                <label for="mfa-password">{{ 'user.profile.password_confirmation_label'|trans }}</label>
                                <input type="password" id="mfa-password" name="password" placeholder="{{ 'user.profile.password_placeholder'|trans }}" required>
                            </div>
                            <button type="submit" class="ui yellow button">
                                <i class="refresh icon"></i>
                                {{ 'user.profile.regenerate_codes_button'|trans }}
                            </button>
                        </div>
                    </form>
                {% endif %}

                {% if not mfaStatus.enabled %}
                    <div class="ui warning message">
                        <i class="exclamation triangle icon"></i>
                        <div class="content">
                            <div class="header">{{ 'user.profile.mfa_disabled'|trans }}</div>
                            <p>{{ 'user.profile.mfa_disabled_recommendation'|trans }}</p>
                        </div>
                    </div>

                    <div class="ui two stackable cards">
                        <div class="card">
                            <div class="content">
                                <div class="header"><i class="clock icon"></i> {{ 'user.profile.totp_header'|trans }}</div>
                                <div class="description">
                                    <p>{{ 'user.profile.totp_description'|trans }}</p>
                                    <p><strong>{{ 'user.profile.totp_most_common'|trans }}</strong> {{ 'user.profile.totp_compatible'|trans }}</p>
                                </div>
                            </div>
                            <div class="extra content">
                                <a href="/user/mfa/setup/totp" class="ui primary fluid button">
                                    <i class="shield icon"></i>
                                    {{ 'user.profile.enable_totp_button'|trans }}
                                </a>
                            </div>
                        </div>

                        <div class="card">
                            <div class="content">
                                <div class="header"><i class="hashtag icon"></i> {{ 'user.profile.hotp_header'|trans }}</div>
                                <div class="description">
                                    <p>{{ 'user.profile.hotp_description'|trans }}</p>
                                    <p><strong>{{ 'user.profile.hotp_special_option'|trans }}</strong> {{ 'user.profile.hotp_compatible'|trans }}</p>
                                </div>
                            </div>
                            <div class="extra content">
                                <a href="/user/mfa/setup/hotp" class="ui primary fluid button">
                                    <i class="shield icon"></i>
                                    {{ 'user.profile.enable_hotp_button'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="ui divider"></div>
            {% endif %}

            <h2 class="ui header">{{ 'user.profile.linked_accounts_header'|trans }}</h2>
            <div class="ui relaxed divided list">
                {% for config in authConfigs %}
                    <div class="item">
                        <div class="right floated content">
                            {% if config.provider in linkedProviders %}
                                <form action="/user/profile/unlink-provider/{{ config.provider }}" method="POST" onsubmit="return confirm('{{ 'user.profile.unlink_confirm'|trans({'%provider%': config.provider|capitalize}) }}');">
                                    <button type="submit" class="ui small red button">{{ 'user.profile.unlink_button'|trans }}</button>
                                </form>
                            {% endif %}
                            {% if config.provider not in linkedProviders %}
                                <a href="/oauth/redirect/{{ config.provider }}" class="ui button {{ config.provider }}">
                                    <i class="{{ config.provider }} icon"></i>
                                    {{ 'user.profile.link_button'|trans({'%provider%': config.provider|capitalize}) }}
                                </a>
                            {% endif %}
                        </div>
                        <i class="large {{ config.provider }} middle aligned icon"></i>
                        <div class="content">
                            <div class="header">{{ config.provider|capitalize }}</div>
                            <div class="description">
                                {% if config.provider in linkedProviders %}
                                    {{ 'user.profile.account_linked'|trans }}
                                {% endif %}
                                {% if config.provider not in linkedProviders %}
                                    {{ 'user.profile.account_not_linked'|trans }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p>{{ 'user.profile.no_providers_available'|trans }}</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {% if mfaPolicy != 'disabled' and mfaStatus.enabled %}
    <div class="ui small modal" id="disable-mfa-modal">
        <div class="header">
            <i class="shield alternate red icon"></i>
            {{ 'user.profile.disable_mfa_modal_title'|trans }}
        </div>
        <div class="content">
            <div class="ui warning message">
                <div class="header">{{ 'user.profile.warning_header'|trans }}</div>
                <p>{{ 'user.profile.disable_mfa_warning'|trans }}</p>
            </div>
            <form action="/user/mfa/disable" method="POST" id="disable-mfa-form">
                <div class="ui form">
                    <div class="required field">
                        <label>{{ 'user.profile.modal_password_label'|trans }}</label>
                        <div class="ui input">
                            <input type="password" name="password" placeholder="{{ 'user.profile.modal_password_placeholder'|trans }}" required autofocus>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="actions">
            <div class="ui black deny button">{{ 'user.profile.cancel_button'|trans }}</div>
            <div class="ui red button" onclick="document.getElementById('disable-mfa-form').submit()">
                <i class="shield icon"></i>
                {{ 'user.profile.modal_disable_button'|trans }}
            </div>
        </div>
    </div>
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Script for file upload button
            const fileInput = document.getElementById('photo-upload');
            const displayInput = document.getElementById('photo-display');

            if (fileInput && displayInput) {
                fileInput.addEventListener('change', function() {
                    if (fileInput.files.length > 0) {
                        displayInput.value = fileInput.files[0].name;
                    } else {
                        displayInput.value = '{{ 'user.profile.no_file_selected'|trans }}';
                    }
                });
            }

            // Script to dismiss messages
            $('.message .close').on('click', function() {
                $(this).closest('.message').transition({
                    animation: 'fade',
                    duration: 300,
                    onComplete: function() {
                        $(this).remove();
                    }
                });
                fetch('/user/clear-messages', {method: 'POST'});
            });

            // Auto-hide flash messages after 5 seconds
            var flashMessages = document.querySelectorAll('[data-flash]');
            if (flashMessages.length > 0) {
                setTimeout(function() {
                    flashMessages.forEach(function(el) {
                        $(el).transition({
                            animation: 'fade',
                            duration: 300,
                            onComplete: function() {
                                $(el).remove();
                            }
                        });
                    });
                    fetch('/user/clear-messages', {method: 'POST'});
                }, 5000);
            }

            // Initialize Semantic UI modal
            $('#disable-mfa-modal').modal({
                closable: true,
                duration: 300,
                transition: 'scale'
            });
        });

        function showDisableMfaModal() {
            $('#disable-mfa-modal').modal('show');
        }
    </script>
{% endblock %}
