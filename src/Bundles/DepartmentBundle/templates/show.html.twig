{% extends "layouts/base.html.twig" %}

{% import "components/ui.html.twig" as ui %}
{% block title %}{{ 'department.show.title'|trans({'%id%': department.id}) }}{% endblock %}
{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="sixteen wide column">
                <h2 class="ui header">{{ 'department.show.title_full'|trans({'%id%': department.id}) }}</h2>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td><strong>{{ 'department.show.table.name'|trans }}</strong></td>
                    <td>{{ department.name }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'department.show.table.parent_department'|trans }}</strong></td>
                    <td>{{ department.parent_name|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'department.show.table.status'|trans }}</strong></td>
                    <td>
                        {% if department.is_active %}
                            <span class="ui green label">{{ 'department.show.table.active'|trans }}</span>
                        {% else %}
                            <span class="ui red label">{{ 'department.show.table.inactive'|trans }}</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td><strong>{{ 'department.show.table.sort_order'|trans }}</strong></td>
                    <td>{{ department.sort_order }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'department.show.table.created_at'|trans }}</strong></td>
                    <td>{{ department.created_at|date('d.m.Y H:i') }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'department.show.table.updated_at'|trans }}</strong></td>
                    <td>{{ department.updated_at|date('d.m.Y H:i')|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>{{ 'department.show.table.description'|trans }}</strong></td>
                    <td>{{ department.description|nl2br|default('—') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>

        <a href="/admin/departments/edit?id={{ department.id }}" class="ui primary button">
            <i class="edit icon"></i> {{ 'department.show.edit'|trans }}
        </a>
        <a href="/admin/departments" class="ui button">
            <i class="arrow left icon"></i> {{ 'department.show.back'|trans }}
        </a>
    </div>

    <div class="ui segment">
        <h3 class="ui header">{{ 'department.show.employees_title'|trans }} <span class="ui blue label">{{ employees|length }}</span></h3>
        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>{{ 'department.show.employees_table.name'|trans }}</th>
                    <th>{{ 'department.show.employees_table.position'|trans }}</th>
                    <th>{{ 'department.show.employees_table.email'|trans }}</th>
                    <th>{{ 'department.show.employees_table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% if employees is not empty %}
                    {% for employee in employees %}
                        <tr>
                            <td>{{ employee.last_name }} {{ employee.first_name }}</td>
                            <td>{{ employee.position }}</td>
                            <td>{{ employee.user_email|default('—') }}</td>
                            <td>
                                <a href="/hrm/show?id={{ employee.id }}" class="ui icon button">
                                    <i class="eye icon"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="4" class="center aligned">{{ 'department.show.no_employees'|trans }}</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
{% endblock %}
