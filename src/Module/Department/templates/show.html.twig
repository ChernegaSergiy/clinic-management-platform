{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ department.name }} - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="sixteen wide column">
                <h2 class="ui header">{{ department.name }}</h2>
            </div>
        </div>

        <div class="ui divider"></div>

        <div class="ui grid">
            <div class="ten wide column">
                <div class="ui card">
                    <div class="content">
                        <div class="header">Інформація про відділ</div>
                        <div class="description">
                            <table class="ui very basic table">
                                <tr>
                                    <td><strong>Назва:</strong></td>
                                    <td>{{ department.name }}</td>
                                </tr>
                                <tr>
                                    <td><strong>Батьківський відділ:</strong></td>
                                    <td>{{ department.parent_name|default('—') }}</td>
                                </tr>
                                <tr>
                                    <td><strong>Статус:</strong></td>
                                    <td>
                                        {% if department.is_active %}
                                            <span class="ui green label">Активний</span>
                                        {% else %}
                                            <span class="ui red label">Неактивний</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Порядок сортування:</strong></td>
                                    <td>{{ department.sort_order }}</td>
                                </tr>
                                <tr>
                                    <td><strong>Створено:</strong></td>
                                    <td>{{ department.created_at|date('d.m.Y H:i') }}</td>
                                </tr>
                                <tr>
                                    <td><strong>Оновлено:</strong></td>
                                    <td>{{ department.updated_at|date('d.m.Y H:i')|default('—') }}</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                {% if department.description %}
                <div class="ui card">
                    <div class="content">
                        <div class="header">Опис відділу</div>
                        <div class="description">
                            <p>{{ department.description }}</p>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>

            <div class="six wide column">
                <div class="ui card">
                    <div class="content">
                        <div class="header">
                            Співробітники відділу 
                            <span class="ui blue label">{{ employees|length }}</span>
                        </div>
                        <div class="description">
                            {% if employees is not empty %}
                                <div class="ui relaxed divided list">
                                    {% for employee in employees %}
                                        <div class="item">
                                            <div class="content">
                                                <div class="header">{{ employee.first_name }} {{ employee.last_name }}</div>
                                                <div class="description">{{ employee.position }}</div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="ui info message">У цьому відділі немає співробітників</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ui divider"></div>

        <a href="/admin/departments/edit?id={{ department.id }}" class="ui primary button">
            <i class="edit icon"></i> Редагувати
        </a>
        <a href="/admin/departments" class="ui button">
            <i class="arrow left icon"></i> Повернутися до списку
        </a>
    </div>
{% endblock %}