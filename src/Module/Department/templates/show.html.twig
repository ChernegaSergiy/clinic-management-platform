{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Відділ #{{ department.id }} - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="sixteen wide column">
                <h2 class="ui header">Відділ #{{ department.id }}</h2>
            </div>
        </div>

        <div class="ui divider"></div>

        <h3>Інформація про відділ</h3>
        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td><strong>Назва:</strong></td>
                    <td>{{ department.name }}</td>
                </tr>
                <tr>
                    <td><strong>Батьківський відділ:</strong></td>
                    <td>{{ department.parent_name|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>Статус:</strong></td>
                    <td>
                        {% if department.is_active %}
                            <span class="ui green label">Активний</span>
                        {% else %}
                            <span class="ui red label">Неактивний</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td><strong>Порядок сортування:</strong></td>
                    <td>{{ department.sort_order }}</td>
                </tr>
                <tr>
                    <td><strong>Створено:</strong></td>
                    <td>{{ department.created_at|date('d.m.Y H:i') }}</td>
                </tr>
                <tr>
                    <td><strong>Оновлено:</strong></td>
                    <td>{{ department.updated_at|date('d.m.Y H:i')|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>Опис:</strong></td>
                    <td>{{ department.description|nl2br|default('—') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>
        <h3>Співробітники відділу <span class="ui blue label">{{ employees|length }}</span></h3>
        {% if employees is not empty %}
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>Ім'я</th>
                        <th>Посада</th>
                        <th>Email</th>
                        <th>Дії</th>
                    </tr>
                </thead>
                <tbody>
                    {% for employee in employees %}
                        <tr>
                            <td>{{ employee.last_name }} {{ employee.first_name }}</td>
                            <td>{{ employee.position }}</td>
                            <td>{{ employee.user_email|default('—') }}</td>
                            <td>
                                <a href="/hrm/show?id={{ employee.id }}" class="ui icon button">
                                    <i class="eye icon"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="ui info message">У цьому відділі немає співробітників</p>
        {% endif %}

        <div class="ui divider"></div>

        <a href="/admin/departments/edit?id={{ department.id }}" class="ui primary button">
            <i class="edit icon"></i> Редагувати
        </a>
        <a href="/admin/departments" class="ui button">
            <i class="arrow left icon"></i> Повернутися до списку
        </a>
    </div>
{% endblock %}