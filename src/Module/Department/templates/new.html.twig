{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'department.new.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'department.new.header'|trans }}</h2>
        
        <div class="ui divider"></div>
        
        {% if errors is defined and errors is not empty %}
            <div class="ui error message">
                <div class="header">{{ 'department.new.validation_error'|trans }}</div>
                <ul class="list">
                    {% for field, messages in errors %}
                        {% for message in messages %}
                            <li>{{ message }}</li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form class="ui form {% if errors is defined %}error{% endif %}" method="POST" action="/admin/departments/new">
            <div class="field">
                <label>{{ 'department.new.name_label'|trans }} *</label>
                <input type="text" name="name" placeholder="{{ 'department.new.name_placeholder'|trans }}" 
                       value="{{ old.name ?? '' }}" required>
            </div>

            <div class="field">
                <label>{{ 'department.new.description_label'|trans }}</label>
                <textarea name="description" rows="4" placeholder="{{ 'department.new.description_placeholder'|trans }}">{{ old.description ?? '' }}</textarea>
            </div>

            <div class="field">
                <label>{{ 'department.new.parent_label'|trans }}</label>
                <select name="parent_id" class="ui dropdown">
                    <option value="">{{ 'department.new.parent_placeholder'|trans }}</option>
                    {% for department in parentOptions %}
                        <option value="{{ department.id }}" 
                                {% if old.parent_id is defined and old.parent_id == department.id %}selected{% endif %}>
                            {{ department.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="two fields">
                <div class="field">
                    <label>{{ 'department.new.status_label'|trans }}</label>
                    <select name="is_active" class="ui dropdown">
                        <option value="1" {% if old.is_active is defined and old.is_active %}selected{% endif %}>{{ 'department.new.active'|trans }}</option>
                        <option value="0" {% if old.is_active is defined and not old.is_active %}selected{% endif %}>{{ 'department.new.inactive'|trans }}</option>
                    </select>
                </div>

                <div class="field">
                    <label>{{ 'department.new.sort_order_label'|trans }}</label>
                    <input type="number" name="sort_order" value="{{ old.sort_order ?? 0 }}" min="0">
                </div>
            </div>

            <div class="ui divider"></div>

            <button type="submit" class="ui primary button">
                <i class="save icon"></i> {{ 'department.new.save_button'|trans }}
            </button>
            <a href="/admin/departments" class="ui button">
                <i class="arrow left icon"></i> {{ 'department.new.cancel_button'|trans }}
            </a>
        </form>
    </div>
{% endblock %}