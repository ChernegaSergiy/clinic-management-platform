{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Новий відділ - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Створення нового відділу</h2>
        
        <div class="ui divider"></div>
        
        {% if errors is defined and errors is not empty %}
            <div class="ui error message">
                <div class="header">Помилка валідації</div>
                <ul class="list">
                    {% for field, messages in errors %}
                        {% for message in messages %}
                            <li>{{ message }}</li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form class="ui form {% if errors is defined %}error{% endif %}" method="POST" action="/admin/departments/new">
            <div class="field">
                <label>Назва відділу *</label>
                <input type="text" name="name" placeholder="напр. Терапевтичне відділення" 
                       value="{{ old.name ?? '' }}" required>
            </div>

            <div class="field">
                <label>Опис</label>
                <textarea name="description" rows="4" placeholder="Опис функцій відділення">{{ old.description ?? '' }}</textarea>
            </div>

            <div class="field">
                <label>Батьківський відділ</label>
                <select name="parent_id" class="ui dropdown">
                    <option value="">Оберіть батьківський відділ (необов'язково)</option>
                    {% for department in parentOptions %}
                        <option value="{{ department.id }}" 
                                {% if old.parent_id is defined and old.parent_id == department.id %}selected{% endif %}>
                            {{ department.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="two fields">
                <div class="field">
                    <label>Статус</label>
                    <select name="is_active" class="ui dropdown">
                        <option value="1" {% if old.is_active is defined and old.is_active %}selected{% endif %}>Активний</option>
                        <option value="0" {% if old.is_active is defined and not old.is_active %}selected{% endif %}>Неактивний</option>
                    </select>
                </div>

                <div class="field">
                    <label>Порядок сортування</label>
                    <input type="number" name="sort_order" value="{{ old.sort_order ?? 0 }}" min="0">
                </div>
            </div>

            <div class="ui divider"></div>

            <button type="submit" class="ui primary button">
                <i class="save icon"></i> Створити відділ
            </button>
            <a href="/admin/departments" class="ui button">
                <i class="arrow left icon"></i> Скасувати
            </a>
        </form>
    </div>
{% endblock %}