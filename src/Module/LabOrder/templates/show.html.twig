{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'lab_order.show.title'|trans({'%id%': order.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'lab_order.show.title_full'|trans({'%id%': order.id}) }}</h2>
        <div class="ui divider"></div>

        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td>{{ 'lab_order.show.table.id'|trans }}</td>
                    <td>{{ order.id }}</td>
                </tr>
                <tr>
                    <td>{{ 'lab_order.show.table.patient'|trans }}</td>
                    <td><a href="/patients/show?id={{ order.patient_id }}">{{ order.patient_name }}</a></td>
                </tr>
                <tr>
                    <td>{{ 'lab_order.show.table.doctor'|trans }}</td>
                    <td>{{ order.doctor_name }}</td>
                </tr>
                <tr>
                    <td>{{ 'lab_order.show.table.medical_record_id'|trans }}</td>
                    <td><a href="/medical-records/show?id={{ order.medical_record_id }}">{{ order.medical_record_id }}</a></td>
                </tr>
                <tr>
                    <td>{{ 'lab_order.show.table.order_code'|trans }}</td>
                    <td>{{ order.order_code }}</td>
                </tr>
                <tr>
                    <td>{{ 'lab_order.show.table.status'|trans }}</td>
                    <td>{{ order.status }}</td>
                </tr>
                <tr>
                    <td>{{ 'lab_order.show.table.qr_code_hash'|trans }}</td>
                    <td>{{ order.qr_code_hash|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'lab_order.show.table.results'|trans }}</td>
                    <td>{{ order.results|nl2br|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'lab_order.show.table.notes'|trans }}</td>
                    <td>{{ order.notes|nl2br|default('—') }}</td>
                </tr>
                <tr>
                    <td>{{ 'lab_order.show.table.created_at'|trans }}</td>
                    <td>{{ order.created_at|date('Y-m-d H:i') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui segment basic center aligned">
            <h3 class="ui header">{{ 'lab_order.show.qr_code_title'|trans }}</h3>
            {% if qrCodeImage %}
                <img src="{{ qrCodeImage }}" alt="{{ 'lab_order.show.qr_code_alt'|trans({'%id%': order.id}) }}" class="ui centered image small">
            {% else %}
                <p>{{ 'lab_order.show.qr_code_unavailable'|trans }}</p>
            {% endif %}
        </div>


        <div class="ui divider"></div>

        <a href="/lab-orders/edit?id={{ order.id }}" class="ui primary button">
            <i class="edit icon"></i> {{ 'lab_order.show.edit'|trans }}
        </a>
        <a href="/medical-records/show?id={{ order.medical_record_id }}" class="ui button">{{ 'lab_order.show.back'|trans }}</a>
    </div>
{% endblock %}
