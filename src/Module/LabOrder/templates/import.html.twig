{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'lab_order.import.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'lab_order.import.header'|trans }}</h2>
        <div class="ui divider"></div>

        {% if errors is not empty %}
            <div class="ui error message">
                <ul class="list">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if success_message %}
            <div class="ui success message">
                <div class="header">{{ 'lab_order.import.success_header'|trans }}</div>
                <p>{{ success_message }}</p>
            </div>
        {% endif %}

        <form class="ui form" action="/lab-orders/import/process" method="POST" enctype="multipart/form-data">
            <div class="field">
                <label>{{ 'lab_order.import.file_label'|trans }}</label>
                <div class="ui action input">
                    <input type="text" id="hl7-file-display" readonly placeholder="{{ 'lab_order.import.file_placeholder'|trans }}">
                    <label for="hl7-file-input" class="ui button">{{ 'lab_order.import.choose_file_button'|trans }}</label>
                </div>
                <input type="file" id="hl7-file-input" name="hl7_dicom_file" accept=".hl7,.dcm,.txt,.xml" style="display: none;">
            </div>
            <button class="ui primary button" type="submit">{{ 'lab_order.import.submit_button'|trans }}</button>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fileInput = document.getElementById('hl7-file-input');
            const display = document.getElementById('hl7-file-display');

            if (fileInput && display) {
                fileInput.addEventListener('change', function() {
                    display.value = fileInput.files.length ? fileInput.files[0].name : '{{ 'lab_order.import.file_placeholder'|trans }}';
                });
            }
        });
    </script>
{% endblock %}
