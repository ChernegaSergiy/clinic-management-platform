{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Категорії послуг - Адмін-панель{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">Список категорій послуг</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="/admin/service-categories/new" class="ui primary button">
                    <i class="plus icon"></i> Додати категорію
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Назва</th>
                    <th>Опис</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td>{{ category.name }}</td>
                        <td>{{ category.description ?? '-' }}</td>
                        <td>
                            <a href="/admin/service-categories/edit?id={{ category.id }}" class="ui icon button">
                                <i class="edit icon"></i>
                            </a>
                            <form action="/admin/service-categories/delete" method="POST" style="display: inline;" onsubmit="return confirm('Ви впевнені, що хочете видалити цю категорію послуг?');">
                                <input type="hidden" name="id" value="{{ category.id }}">
                                <button type="submit" class="ui icon button red">
                                    <i class="trash icon"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="center aligned">Немає категорій послуг для відображення.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}