{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Додати нову категорію послуг - Адмін-панель{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Додати нову категорію послуг</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/service-categories/new">
            {{ forms.input('name', 'Назва категорії', old.name ?? null, 'text', 'Назва категорії', errors.name ?? null, {'required': 'required'}) }}
            {{ forms.textarea('description', 'Опис', old.description ?? null, 'Опис категорії', errors.description ?? null) }}
            
            {{ ui.button('Зберегти категорію', 'primary', 'large', 'save') }}
            <a href="/admin/service-categories" class="ui button"><i class="arrow left icon"></i> Скасувати</a>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('.ui.dropdown').dropdown();
        });
    </script>
{% endblock %}
