{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.dictionaries.edit.title'|trans({'%id%': dictionary.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.dictionaries.edit.header'|trans({'%id%': dictionary.id}) }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/dictionaries/edit?id={{ dictionary.id }}">
            {{ forms.input('name', 'admin.dictionaries.edit.name'|trans, old.name ?? dictionary.name, 'text', 'admin.dictionaries.edit.name_placeholder'|trans, errors.name ?? null, {'required': 'required'}) }}
            {{ forms.textarea('description', 'admin.dictionaries.edit.description'|trans, old.description ?? dictionary.description, 'admin.dictionaries.edit.description_placeholder'|trans, errors.description ?? null) }}
            {{ forms.input('type', 'admin.dictionaries.edit.type'|trans, old.type ?? dictionary.type, 'text', 'admin.dictionaries.edit.type_placeholder'|trans, errors.type ?? null) }}

            {{ ui.button('admin.dictionaries.edit.save_button'|trans, 'primary', '', 'save') }}
            <a href="/admin/dictionaries" class="ui button"><i class="arrow left icon"></i> {{ 'admin.dictionaries.edit.cancel_button'|trans }}</a>
        </form>
    </div>
{% endblock %}
