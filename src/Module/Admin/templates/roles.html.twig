{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.roles.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">{{ 'admin.roles.title'|trans }}</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="/admin/roles/new" class="ui primary button">
                    <i class="plus icon"></i> {{ 'admin.roles.add'|trans }}
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        {% if roles is empty %}
            <p>{{ 'admin.roles.no_roles'|trans }}</p>
        {% else %}
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'admin.roles.table.id'|trans }}</th>
                        <th>{{ 'admin.roles.table.name'|trans }}</th>
                        <th>{{ 'admin.roles.table.description'|trans }}</th>
                        <th>{{ 'admin.roles.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for role in roles %}
                        <tr>
                            <td>{{ role.id }}</td>
                            <td>{{ role.name }}</td>
                            <td>{{ role.description }}</td>
                            <td>
                                <a href="/admin/roles/edit?id={{ role.id }}" class="ui icon button">
                                    <i class="edit icon"></i>
                                </a>
                                <form action="/admin/roles/delete" method="POST" style="display: inline;" onsubmit="return confirm('{{ 'admin.roles.delete_confirm'|trans }}');">
                                    <input type="hidden" name="id" value="{{ role.id }}">
                                    <button type="submit" class="ui icon button red">
                                        <i class="trash icon"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
