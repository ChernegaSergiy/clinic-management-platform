{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'admin.backup_policies.new.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'admin.backup_policies.new.header'|trans }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/backup_policies/new">
            {{ forms.input('name', 'admin.backup_policies.new.name'|trans, old.name ?? '', 'text', 'admin.backup_policies.new.name_placeholder'|trans, errors.name ?? null, {'required': 'required'}) }}
            {{ forms.textarea('description', 'admin.backup_policies.new.description'|trans, old.description ?? '', 'admin.backup_policies.new.description_placeholder'|trans, errors.description ?? null) }}
            {{ forms.input('frequency', 'admin.backup_policies.new.frequency'|trans, old.frequency ?? 'daily', 'text', 'admin.backup_policies.new.frequency_placeholder'|trans, errors.frequency ?? null, {'required': 'required'}) }}
            {{ forms.input('retention_days', 'admin.backup_policies.new.retention_days'|trans, old.retention_days ?? 30, 'number', 'admin.backup_policies.new.retention_days_placeholder'|trans, errors.retention_days ?? null, {'required': 'required', 'min': '1'}) }}

            <div class="field">
                <label>{{ 'admin.backup_policies.new.status_label'|trans }}</label>
                <select name="status" class="ui dropdown">
                    <option value="active" {% if old.status is defined and old.status == 'active' %}selected{% endif %}>{{ 'admin.backup_policies.new.status_active'|trans }}</option>
                    <option value="inactive" {% if old.status is not defined or old.status == 'inactive' %}selected{% endif %}>{{ 'admin.backup_policies.new.status_inactive'|trans }}</option>
                </select>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('admin.backup_policies.new.save_button'|trans, 'primary', '', 'save') }}
            <a href="/admin/backup_policies" class="ui button"><i class="arrow left icon"></i> {{ 'admin.backup_policies.new.cancel_button'|trans }}</a>
        </form>
    </div>
{% endblock %}