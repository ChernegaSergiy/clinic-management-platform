{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'inventory.edit.title'|trans({'%id%': item.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'inventory.edit.header'|trans({'%id%': item.id}) }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/inventory/edit?id={{ item.id }}">
            <div class="two fields">
                {{ forms.input('name', 'inventory.new.name_label'|trans, old.name ?? item.name, 'text', 'inventory.new.name_placeholder'|trans, errors.name ?? null, {'required': 'required'}) }}
                {{ forms.input('inn', 'inventory.new.inn_label'|trans, old.inn ?? item.inn, 'text', 'inventory.new.inn_placeholder'|trans, errors.inn ?? null) }}
            </div>
            {{ forms.textarea('description', 'inventory.new.description_label'|trans, old.description ?? item.description, 'inventory.new.description_placeholder'|trans, errors.description ?? null) }}
            <div class="three fields">
                {{ forms.input('batch_number', 'inventory.new.batch_number_label'|trans, old.batch_number ?? item.batch_number, 'text', 'inventory.new.batch_number_placeholder'|trans, errors.batch_number ?? null) }}
                {{ forms.input('expiry_date', 'inventory.new.expiry_date_label'|trans, old.expiry_date ?? item.expiry_date, 'date', '', errors.expiry_date ?? null) }}
                {{ forms.input('supplier', 'inventory.new.supplier_label'|trans, old.supplier ?? item.supplier, 'text', 'inventory.new.supplier_placeholder'|trans, errors.supplier ?? null) }}
            </div>
            <div class="three fields">
                {{ forms.input('cost', 'inventory.new.cost_label'|trans, old.cost ?? item.cost, 'number', 'inventory.new.cost_placeholder'|trans, errors.cost ?? null, {'step': '0.01'}) }}
                {{ forms.input('quantity', 'inventory.new.quantity_label'|trans, old.quantity ?? item.quantity, 'number', 'inventory.new.quantity_placeholder'|trans, errors.quantity ?? null, {'required': 'required'}) }}
                {{ forms.input('min_stock_level', 'inventory.new.min_stock_level_label'|trans, old.min_stock_level ?? item.min_stock_level, 'number', 'inventory.new.min_stock_level_placeholder'|trans, errors.min_stock_level ?? null) }}
            </div>
            <div class="field">
                {{ forms.input('max_stock_level', 'inventory.new.max_stock_level_label'|trans, old.max_stock_level ?? item.max_stock_level, 'number', 'inventory.new.max_stock_level_placeholder'|trans, errors.max_stock_level ?? null) }}
            </div>
            {{ forms.input('location', 'inventory.new.location_label'|trans, old.location ?? item.location, 'text', 'inventory.new.location_placeholder'|trans, errors.location ?? null) }}

            <div class="ui divider"></div>

            {{ ui.button('inventory.edit.save_button'|trans, 'primary', '', 'save') }}
            <a href="/inventory/show?id={{ item.id }}" class="ui button"><i class="arrow left icon"></i> {{ 'inventory.edit.cancel_button'|trans }}</a>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('.ui.dropdown').dropdown();
        });
    </script>
{% endblock %}
