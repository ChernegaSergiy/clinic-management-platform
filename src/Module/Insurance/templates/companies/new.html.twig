{% extends "layouts/base.html.twig" %}

{% block title %}Нова страхова компанія - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Нова страхова компанія</h2>
        <div class="ui divider"></div>

        <form class="ui form" action="/insurance/companies/new" method="POST">
            <div class="field">
                <label>Назва</label>
                <input type="text" name="name" placeholder="Назва компанії" value="{{ old.name }}" required>
            </div>
            <div class="field">
                <label>Контактна особа</label>
                <input type="text" name="contact_person" placeholder="ПІБ контактної особи" value="{{ old.contact_person }}">
            </div>
            <div class="field">
                <label>Телефон</label>
                <input type="text" name="phone" placeholder="Телефон" value="{{ old.phone }}">
            </div>
            <div class="field">
                <label>Email</label>
                <input type="email" name="email" placeholder="Email" value="{{ old.email }}">
            </div>
            <div class="field">
                <label>Нотатки</label>
                <textarea name="notes" rows="3">{{ old.notes }}</textarea>
            </div>

            <button class="ui primary button" type="submit">Зберегти</button>
            <a href="/insurance/companies" class="ui button">Скасувати</a>
        </form>
    </div>
{% endblock %}
