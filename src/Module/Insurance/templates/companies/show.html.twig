{% extends "layouts/base.html.twig" %}

{% block title %}Страхова компанія #{{ company.id }} - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="sixteen wide column">
                <h2 class="ui header">Деталі компанії #{{ company.id }}</h2>
            </div>
        </div>
        <div class="ui divider"></div>

        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td class="three wide">Назва</td>
                    <td>{{ company.name }}</td>
                </tr>
                <tr>
                    <td>Контактна особа</td>
                    <td>{{ company.contact_person|default('Не вказано') }}</td>
                </tr>
                <tr>
                    <td>Телефон</td>
                    <td>{{ company.phone|default('Не вказано') }}</td>
                </tr>
                <tr>
                    <td>Email</td>
                    <td>{{ company.email|default('Не вказано') }}</td>
                </tr>
                <tr>
                    <td>Примітки</td>
                    <td>{{ company.notes|nl2br|default('Немає') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>

        <a href="/insurance/companies/edit?id={{ company.id }}" class="ui primary button">
            <i class="edit icon"></i> Редагувати
        </a>
        <a href="/insurance/companies" class="ui secondary button">Повернутися до списку</a>
    </div>
{% endblock %}
