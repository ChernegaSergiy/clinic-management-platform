{% extends 'layouts/base.html.twig' %}

{% block title %}Профіль співробітника - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="sixteen wide column">
                <h2 class="ui header">Профіль: {{ employee.first_name }} {{ employee.last_name }}</h2>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td><strong>ID</strong></td>
                    <td>{{ employee.id }}</td>
                </tr>
                <tr>
                    <td><strong>Повне ім'я</strong></td>
                    <td>{{ employee.last_name }} {{ employee.first_name }} {{ employee.middle_name|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>Посада</strong></td>
                    <td>{{ employee.position }}</td>
                </tr>
                <tr>
                    <td><strong>Департамент</strong></td>
                    <td>{{ employee.department_name|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>Дата найму</strong></td>
                    <td>{{ employee.hire_date }}</td>
                </tr>
                <tr>
                    <td><strong>Контактний телефон</strong></td>
                    <td>{{ employee.contact_phone|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>Зарплата</strong></td>
                    <td>{{ employee.salary ? employee.salary|number_format(2, ',', ' ') : '—' }}</td>
                </tr>
                <tr>
                    <td><strong>Статус</strong></td>
                    <td>{{ employee.status }}</td>
                </tr>
                <tr>
                    <td><strong>Дата звільнення</strong></td>
                    <td>{{ employee.fire_date|default('—') }}</td>
                </tr>
                <tr>
                    <td><strong>Прив'язаний користувач системи</strong></td>
                    <td>{{ employee.user_id|default('—') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>
        
        <form action="/hrm/toggle-status" method="POST" style="display: inline-block;">
            <input type="hidden" name="id" value="{{ employee.id }}">
            <button class="ui {{ employee.status == 'active' ? 'negative' : 'positive' }} button" type="submit">
                <i class="user {{ employee.status == 'active' ? 'times' : 'check' }} icon"></i>
                {{ employee.status == 'active' ? 'Деактивувати' : 'Активувати' }}
            </button>
        </form>
        <a href="/hrm/edit?id={{ employee.id }}" class="ui primary button">
            <i class="edit icon"></i> Редагувати
        </a>
        <a href="/hrm" class="ui button">
            <i class="arrow left icon"></i> До списку
        </a>
    </div>
{% endblock %}
