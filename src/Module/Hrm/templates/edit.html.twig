{% extends 'layouts/base.html.twig' %}

{% block title %}Редагувати профіль співробітника - Клініка{% endblock %}

{% block body %}
<div class="ui segment">
    <h2 class="ui header">Редагувати: {{ employee.first_name }} {{ employee.last_name }}</h2>

    <div class="ui divider"></div>

    {% if errors is defined and errors is not empty %}
    <div class="ui error message">
        <div class="header">Помилка валідації</div>
        <ul class="list">
            {% for field, messages in errors %}
                {% for message in messages %}
                    <li>{{ message }}</li>
                {% endfor %}
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <form class="ui form {% if errors is defined %}error{% endif %}" method="POST" action="/dashboard/hrm/edit?id={{ employee.id }}">
        <div class="two fields">
            <div class="field">
                <label>Ім'я</label>
                <input type="text" name="first_name" placeholder="Ім'я" value="{{ employee.first_name ?? '' }}" required>
            </div>
            <div class="field">
                <label>Прізвище</label>
                <input type="text" name="last_name" placeholder="Прізвище" value="{{ employee.last_name ?? '' }}" required>
            </div>
        </div>
        <div class="two fields">
            <div class="field">
                <label>По-батькові</label>
                <input type="text" name="middle_name" placeholder="По-батькові" value="{{ employee.middle_name ?? '' }}">
            </div>
            <div class="field">
                <label>Посада</label>
                <input type="text" name="position" placeholder="Напр. Лікар, Медсестра" value="{{ employee.position ?? '' }}" required>
            </div>
        </div>
        <div class="two fields">
            <div class="field">
                <label>Департамент</label>
                <input type="text" name="department" placeholder="Напр. Кардіологія" value="{{ employee.department ?? '' }}">
            </div>
             <div class="field">
                <label>Дата найму</label>
                <input type="date" name="hire_date" value="{{ employee.hire_date ?? '' }}" required>
            </div>
        </div>
        <div class="three fields">
            <div class="field">
                <label>Зарплата</label>
                <input type="number" name="salary" step="0.01" placeholder="0.00" value="{{ employee.salary ?? '' }}">
            </div>
            <div class="field">
                <label>Контактний телефон</label>
                <input type="text" name="contact_phone" placeholder="+380" value="{{ employee.contact_phone ?? '' }}">
            </div>
            <div class="field">
                <label>Статус</label>
                <select name="status" class="ui dropdown">
                    <option value="active" {{ (employee.status ?? 'active') == 'active' ? 'selected' : '' }}>Активний</option>
                    <option value="on_leave" {{ (employee.status ?? '') == 'on_leave' ? 'selected' : '' }}>У відпустці</option>
                    <option value="terminated" {{ (employee.status ?? '') == 'terminated' ? 'selected' : '' }}>Звільнений</option>
                </select>
            </div>
        </div>
        
        <div class="field">
            <label>Дата звільнення</label>
            <input type="date" name="fire_date" value="{{ employee.fire_date ?? '' }}">
        </div>

        <div class="field">
            <label>Прив'язаний користувач системи</label>
            <select name="user_id" class="ui dropdown">
                <option value="">Не прив'язано</option>
                {% for user in users %}
                    <option value="{{ user.id }}" {{ (employee.user_id ?? '') == user.id ? 'selected' : '' }}>
                        {{ user.last_name }} {{ user.first_name }} ({{ user.email }})
                    </option>
                {% endfor %}
            </select>
        </div>

        <button class="ui primary button" type="submit">Оновити</button>
        <a href="/dashboard/hrm/show?id={{ employee.id }}" class="ui button">Скасувати</a>
    </form>
</div>
{% endblock %}
