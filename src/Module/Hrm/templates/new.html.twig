{% extends 'layouts/base.html.twig' %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Додати співробітника - Клініка{% endblock %}

{% block body %}
<div class="ui segment">
    <h2 class="ui header">Додати нового співробітника</h2>

    <div class="ui divider"></div>

    {% if errors is defined and errors is not empty %}
    <div class="ui error message">
        <div class="header">Помилка валідації</div>
        <ul class="list">
            {% for field, messages in errors %}
                {% for message in messages %}
                    <li>{{ message }}</li>
                {% endfor %}
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <form class="ui form {% if errors is defined %}error{% endif %}" method="POST" action="/hrm/new">
        <div class="two fields">
            <div class="field">
                <label>Ім'я</label>
                <input type="text" name="first_name" placeholder="Ім'я" value="{{ old.first_name ?? '' }}" required>
            </div>
            <div class="field">
                <label>Прізвище</label>
                <input type="text" name="last_name" placeholder="Прізвище" value="{{ old.last_name ?? '' }}" required>
            </div>
        </div>
        <div class="two fields">
            <div class="field">
                <label>По-батькові</label>
                <input type="text" name="middle_name" placeholder="По-батькові" value="{{ old.middle_name ?? '' }}">
            </div>
            <div class="field">
                <label>Посада</label>
                <input type="text" name="position" placeholder="Напр. Лікар, Медсестра" value="{{ old.position ?? '' }}" required>
            </div>
        </div>
        <div class="two fields">
            <div class="field">
                <label>Департамент</label>
                <select name="department_id" class="ui dropdown">
                    <option value="">Не обрано</option>
                    {% for department in departments %}
                        <option value="{{ department.id }}" {{ (old.department_id ?? '') == department.id ? 'selected' : '' }}>
                            {{ department.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
             <div class="field">
                <label>Дата найму</label>
                <input type="date" name="hire_date" value="{{ old.hire_date ?? '' }}" required>
            </div>
        </div>
        <div class="three fields">
            <div class="field">
                <label>Зарплата</label>
                <input type="number" name="salary" step="0.01" placeholder="0.00" value="{{ old.salary ?? '' }}">
            </div>
            <div class="field">
                <label>Контактний телефон</label>
                <input type="text" name="contact_phone" placeholder="+380" value="{{ old.contact_phone ?? '' }}">
            </div>
            <div class="field">
                <label>Статус</label>
                <select name="status" class="ui dropdown">
                    <option value="active" {{ (old.status ?? 'active') == 'active' ? 'selected' : '' }}>Активний</option>
                    <option value="on_leave" {{ (old.status ?? '') == 'on_leave' ? 'selected' : '' }}>У відпустці</option>
                    <option value="terminated" {{ (old.status ?? '') == 'terminated' ? 'selected' : '' }}>Звільнений</option>
                </select>
            </div>
        </div>
        
        <div class="field">
            <label>Прив'язаний користувач системи</label>
            <select name="user_id" class="ui dropdown">
                <option value="">Не прив'язано</option>
                {% for user in users %}
                    <option value="{{ user.id }}" {{ (old.user_id ?? '') == user.id ? 'selected' : '' }}>
                        {{ user.last_name }} {{ user.first_name }} ({{ user.email }})
                    </option>
                {% endfor %}
            </select>
        </div>

        <button class="ui primary button" type="submit">Зберегти</button>
        <a href="/hrm" class="ui button"><i class="arrow left icon"></i> Скасувати</a>
    </form>
</div>
{% endblock %}