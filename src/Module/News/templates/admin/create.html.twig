{% extends "layouts/dashboard.html.twig" %}

{% block title %}Створити Новину — Адмінпанель{% endblock %}

{% block content %}
    <h1 class="ui header">Створити Нову Новину</h1>

    {% if errors %}
        <div class="ui negative message">
            <ul class="list">
                {% for field, messages in errors %}
                    {% for message in messages %}
                        <li>{{ message }}</li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form class="ui form" method="POST" action="/admin/news/new">
        <div class="field">
            <label>Заголовок</label>
            <input type="text" name="title" value="{{ old.title ?? '' }}" placeholder="Заголовок новини" required>
        </div>
        <div class="field">
            <label>Мета-опис (короткий опис)</label>
            <textarea name="meta" rows="2" placeholder="Короткий опис або підсумок">{{ old.meta ?? '' }}</textarea>
        </div>
        <div class="field">
            <label>Вміст (HTML)</label>
            <textarea name="content" rows="10" placeholder="Повний текст новини (дозволяється HTML)" required>{{ old.content ?? '' }}</textarea>
        </div>
        <div class="two fields">
            <div class="field">
                <label>Дата публікації</label>
                <input type="datetime-local" name="published_at" value="{{ (old.published_at is defined ? old.published_at|date('Y-m-d\\TH:i') : 'now'|date('Y-m-d\\TH:i')) }}" required>
            </div>
            <div class="field">
                <label>Автор</label>
                <select name="author_id" class="ui fluid dropdown" required>
                    <option value="">Оберіть автора</option>
                    {% for author in authors %}
                        <option value="{{ author.id }}" {% if old.author_id is defined and old.author_id == author.id %}selected{% endif %}>{{ author.full_name }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <div class="field">
            <div class="ui checkbox">
                <input type="checkbox" name="is_published" tabindex="0" class="hidden" {% if old.is_published is defined ? old.is_published : true %}checked{% endif %}>
                <label>Опублікувати негайно</label>
            </div>
        </div>
        <button class="ui primary button" type="submit">Зберегти Новину</button>
        <a href="/admin/news" class="ui button">Відмінити</a>
    </form>
{% endblock %}
