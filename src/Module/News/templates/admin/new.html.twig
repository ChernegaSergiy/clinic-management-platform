{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Створити новину{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Створити новину</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/news/new">
            {{ forms.input('title', 'Заголовок', old.title, 'text', 'Введіть заголовок', errors.title, {'required': 'required'}) }}
            {{ forms.textarea('meta', 'Мета-опис (короткий опис)', old.meta, 'Короткий опис або підсумок', errors.meta) }}
            {{ forms.textarea('content', 'Вміст (HTML)', old.content, 'Повний текст новини (дозволяється HTML)', errors.content, {'required': 'required'}) }}
            <div class="two fields">
                {{ forms.input('published_at', 'Дата публікації', (old.published_at is defined ? old.published_at|date('Y-m-d\\TH:i') : 'now'|date('Y-m-d\\TH:i')), 'datetime-local', '', errors.published_at, {'required': 'required'}) }}
                {{ forms.select('author_id', 'Автор', authors, old.author_id, errors.author_id, {'required': 'required'}) }}
            </div>
            <div class="field">
                <div class="ui checkbox">
                    <input type="checkbox" name="is_published" tabindex="0" class="hidden" {% if old.is_published is defined ? old.is_published : true %}checked{% endif %}>
                    <label>Опублікувати негайно</label>
                </div>
            </div>

            {{ ui.button('Зберегти новину', 'primary', '', 'save') }}
            <a href="/admin/news" class="ui button">Скасувати</a>
        </form>
    </div>
{% endblock %}
