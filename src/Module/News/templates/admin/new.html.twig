{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'news.admin.new.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'news.admin.new.header'|trans }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/news/new">
            {{ forms.input('title', 'news.admin.new.title_field'|trans, old.title, 'text', 'news.admin.new.title_placeholder'|trans, errors.title, {'required': 'required'}) }}
            {{ forms.textarea('meta', 'news.admin.new.meta'|trans, old.meta, 'news.admin.new.meta_placeholder'|trans, errors.meta) }}
            {{ forms.textarea('content', 'news.admin.new.content'|trans, old.content, 'news.admin.new.content_placeholder'|trans, errors.content, {'required': 'required'}) }}
            <div class="two fields">
                {{ forms.input('published_at', 'news.admin.new.published_at'|trans, (old.published_at is defined ? old.published_at|date('Y-m-d\\TH:i') : 'now'|date('Y-m-d\\TH:i')), 'datetime-local', '', errors.published_at, {'required': 'required'}) }}
                {{ forms.select('author_id', 'news.admin.new.author'|trans, authors, old.author_id, errors.author_id, {'required': 'required'}) }}
            </div>
            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_published" tabindex="0" class="hidden" {% if old.is_published is defined ? old.is_published : true %}checked{% endif %}>
                    <label>{{ 'news.admin.new.is_published'|trans }}</label>
                </div>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('news.admin.new.save'|trans, 'primary', '', 'save') }}
            <a href="/admin/news" class="ui button"><i class="arrow left icon"></i> {{ 'news.admin.new.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}
