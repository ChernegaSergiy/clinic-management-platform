{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Редагування новини #{{ newsArticle.id }} - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Редагування новини #{{ newsArticle.id }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/news/edit/{{ newsArticle.id }}">
            {{ forms.input('title', 'Заголовок', old.title ?? newsArticle.title, 'text', 'Введіть заголовок', errors.title, {'required': 'required'}) }}
            {{ forms.textarea('meta', 'Мета-опис (короткий опис)', old.meta ?? newsArticle.meta, 'Короткий опис або підсумок', errors.meta) }}
            {{ forms.textarea('content', 'Вміст (HTML)', old.content ?? newsArticle.content, 'Повний текст новини (дозволяється HTML)', errors.content, {'required': 'required'}) }}
            <div class="two fields">
                {{ forms.input('published_at', 'Дата публікації', (old.published_at is defined ? old.published_at|date('Y-m-d\\TH:i') : newsArticle.published_at|date('Y-m-d\\TH:i')), 'datetime-local', '', errors.published_at, {'required': 'required'}) }}
                {{ forms.select('author_id', 'Автор', authors, old.author_id ?? newsArticle.author_id, errors.author_id, {'required': 'required'}) }}
            </div>
            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_published" tabindex="0" class="hidden" {% if (old.is_published is defined and old.is_published) or (newsArticle.is_published is defined and newsArticle.is_published and old.is_published is not defined) %}checked{% endif %}>
                    <label>Опубліковано</label>
                </div>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('Оновити новину', 'primary', '', 'save') }}
            <a href="/admin/news" class="ui button"><i class="arrow left icon"></i> Скасувати</a>
        </form>
    </div>
{% endblock %}
