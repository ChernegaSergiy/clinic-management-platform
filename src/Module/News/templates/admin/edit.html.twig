{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'news.admin.edit.title'|trans({'%id%': newsArticle.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'news.admin.edit.title_full'|trans({'%id%': newsArticle.id}) }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/news/edit/{{ newsArticle.id }}">
            {{ forms.input('title', 'news.admin.edit.title_field'|trans, old.title ?? newsArticle.title, 'text', 'news.admin.edit.title_placeholder'|trans, errors.title, {'required': 'required'}) }}
            {{ forms.textarea('meta', 'news.admin.edit.meta'|trans, old.meta ?? newsArticle.meta, 'news.admin.edit.meta_placeholder'|trans, errors.meta) }}
            {{ forms.textarea('content', 'news.admin.edit.content'|trans, old.content ?? newsArticle.content, 'news.admin.edit.content_placeholder'|trans, errors.content, {'required': 'required'}) }}
            <div class="two fields">
                {{ forms.input('published_at', 'news.admin.edit.published_at'|trans, (old.published_at is defined ? old.published_at|date('Y-m-d\\TH:i') : newsArticle.published_at|date('Y-m-d\\TH:i')), 'datetime-local', '', errors.published_at, {'required': 'required'}) }}
                {{ forms.select('author_id', 'news.admin.edit.author'|trans, authors, old.author_id ?? newsArticle.author_id, errors.author_id, {'required': 'required'}) }}
            </div>
            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_published" tabindex="0" class="hidden" {% if (old.is_published is defined and old.is_published) or (newsArticle.is_published is defined and newsArticle.is_published and old.is_published is not defined) %}checked{% endif %}>
                    <label>{{ 'news.admin.edit.is_published'|trans }}</label>
                </div>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('news.admin.edit.update'|trans, 'primary', '', 'save') }}
            <a href="/admin/news" class="ui button"><i class="arrow left icon"></i> {{ 'news.admin.edit.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}
