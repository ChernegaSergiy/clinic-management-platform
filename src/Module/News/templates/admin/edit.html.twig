{% extends "layouts/base.html.twig" %}

{% block title %}Редагувати Новину — Адмінпанель{% endblock %}

{% block body %}
    <h1 class="ui header">Редагувати Новину: {{ newsArticle.title }}</h1>

    {% if errors %}
        <div class="ui negative message">
            <ul class="list">
                {% for field, messages in errors %}
                    {% for message in messages %}
                        <li>{{ message }}</li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form class="ui form" method="POST" action="/admin/news/edit/{{ newsArticle.id }}">
        <div class="field">
            <label>Заголовок</label>
            <input type="text" name="title" value="{{ old.title ?? newsArticle.title }}" placeholder="Заголовок новини" required>
        </div>
        <div class="field">
            <label>Мета-опис (короткий опис)</label>
            <textarea name="meta" rows="2" placeholder="Короткий опис або підсумок">{{ old.meta ?? newsArticle.meta }}</textarea>
        </div>
        <div class="field">
            <label>Вміст (HTML)</label>
            <textarea name="content" rows="10" placeholder="Повний текст новини (дозволяється HTML)" required>{{ old.content ?? newsArticle.content }}</textarea>
        </div>
        <div class="two fields">
            <div class="field">
                <label>Дата публікації</label>
                <input type="datetime-local" name="published_at" value="{{ (old.published_at is defined ? old.published_at|date('Y-m-d\\TH:i') : newsArticle.published_at|date('Y-m-d\\TH:i')) }}" required>
            </div>
            <div class="field">
                <label>Автор</label>
                <select name="author_id" class="ui fluid dropdown" required>
                    <option value="">Оберіть автора</option>
                    {% for author in authors %}
                        <option value="{{ author.id }}" {% if (old.author_id is defined and old.author_id == author.id) or (newsArticle.author_id is defined and newsArticle.author_id == author.id and old.author_id is not defined) %}selected{% endif %}>{{ author.full_name }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <div class="field">
            <div class="ui checkbox">
                <input type="checkbox" name="is_published" tabindex="0" class="hidden" {% if (old.is_published is defined and old.is_published) or (newsArticle.is_published is defined and newsArticle.is_published and old.is_published is not defined) %}checked{% endif %}>
                <label>Опубліковано</label>
            </div>
        </div>
        <button class="ui primary button" type="submit">Оновити Новину</button>
        <a href="/admin/news" class="ui button">Відмінити</a>
    </form>
{% endblock %}
