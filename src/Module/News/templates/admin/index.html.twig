{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Керування новинами{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">Керування новинами</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="/admin/news/new" class="ui primary button">
                    <i class="plus icon"></i> Створити новину
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui celled unstackable table">
            <thead>
            <tr>
                <th>ID</th>
                <th>Заголовок</th>
                <th>Дата створення</th>
                <th>Статус</th>
                <th>Дії</th>
            </tr>
            </thead>
            <tbody>
            {% for article in newsArticles %}
                <tr>
                    <td>{{ article.id }}</td>
                    <td>{{ article.title }}</td>
                    <td>{{ article.published_at|date('Y-m-d H:i') }}</td>
                    <td>{{ article.is_published ? 'Опубліковано' : 'Чернетка' }}</td>
                    <td>
                        <a href="/admin/news/edit/{{ article.id }}" class="ui icon button">
                            <i class="edit icon"></i>
                        </a>
                        <form action="/admin/news/delete/{{ article.id }}" method="post" style="display: inline;">
                            <button type="submit" class="ui icon button" onclick="return confirm('Ви впевнені, що хочете видалити цю новину?');">
                                <i class="trash icon"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="center aligned">Новин не знайдено.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
