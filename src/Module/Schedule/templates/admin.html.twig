{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Управління графіками лікарів{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Управління графіками лікарів</h2>
        
        <div class="ui info message">
            <div class="header">Оберіть лікаря</div>
            <p>Використовуйте форму нижче для вибору лікаря, щоб переглянути або відредагувати його робочий графік.</p>
        </div>

        <div class="ui divider"></div>

        <div class="ui form">
            <div class="field">
                <label>Оберіть лікаря для перегляду графіка</label>
                <select class="ui fluid search dropdown" id="doctor_select">
                    <option value="">Оберіть лікаря...</option>
                    {% for doctor in allDoctors %}
                        <option value="{{ doctor.id }}">{{ doctor.full_name }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('#doctor_select').on('change', function() {
                var doctorId = $(this).val();
                if (doctorId) {
                    window.location.href = '/admin/schedules/show?id=' + doctorId;
                }
            });
        });
    </script>
{% endblock %}