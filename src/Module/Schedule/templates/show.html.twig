{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Графік роботи: {{ doctor.full_name }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Графік роботи: {{ doctor.full_name }}</h2>
        
        <a href="/admin/schedules/edit/{{ doctor.id }}" class="ui primary button">
            <i class="edit icon"></i>
            Редагувати графік
        </a>
        <a href="/admin/schedules" class="ui button">
            <i class="arrow left icon"></i>
            Повернутися до списку
        </a>

        <div class="ui divider"></div>
        
        <div class="ui grid">
            <div class="sixteen wide column">
                <div class="ui seven column grid">
                    {% for day_num, day_name in {1: 'Понеділок', 2: 'Вівторок', 3: 'Середа', 4: 'Четвер', 5: 'П\'ятниця', 6: 'Субота', 0: 'Неділя'} %}
                        {% set schedule_entry = scheduleByDay[day_num] ?? null %}
                        <div class="column">
                            <div class="ui segment">
                                <h4 class="ui header">{{ day_name }}</h4>
                                {% if schedule_entry and schedule_entry.is_available %}
                                    <p><strong>Час роботи:</strong> {{ schedule_entry.start_time|slice(0, 5) }} - {{ schedule_entry.end_time|slice(0, 5) }}</p>
                                {% elseif schedule_entry %}
                                    <p class="ui red text">Вихідний</p>
                                {% else %}
                                    <p class="ui grey text">Не встановлено</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
