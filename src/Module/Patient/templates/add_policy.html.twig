{% extends "layouts/base.html.twig" %}

{% block title %}Додати страховий поліс - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Додати страховий поліс для пацієнта: {{ patient.last_name }} {{ patient.first_name }}</h2>
        <div class="ui divider"></div>

        <form class="ui form" action="/patients/{{ patient.id }}/policies/store" method="POST">
            <div class="field">
                <label>Страхова компанія</label>
                <select name="insurance_company_id" class="ui dropdown">
                    {% for company in insurance_companies %}
                        <option value="{{ company.id }}">{{ company.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="field">
                <label>Номер полісу</label>
                <input type="text" name="policy_number" placeholder="Номер полісу" required>
            </div>
            <div class="field">
                <label>Номер групи</label>
                <input type="text" name="group_number" placeholder="Номер групи">
            </div>
            <div class="two fields">
                <div class="field">
                    <label>Дійсний з</label>
                    <input type="date" name="valid_from" required>
                </div>
                <div class="field">
                    <label>Дійсний до</label>
                    <input type="date" name="valid_to">
                </div>
            </div>
            <div class="inline field">
                <div class="ui checkbox">
                    <input type="checkbox" name="is_active" checked>
                    <label>Активний</label>
                </div>
            </div>

            <button class="ui primary button" type="submit">
                <i class="save icon"></i> Зберегти
            </button>
            <a href="/patients/show?id={{ patient.id }}" class="ui button">
                <i class="arrow left icon"></i> Скасувати
            </a>
        </form>
    </div>
{% endblock %}
