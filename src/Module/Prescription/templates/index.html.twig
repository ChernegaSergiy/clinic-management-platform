{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'prescription.list.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="sixteen wide column">
                <h2 class="ui header">{{ 'prescription.list.title_full'|trans }}</h2>
            </div>
        </div>

        <div class="ui divider"></div>

        <form class="ui form" method="GET" action="/prescriptions">
            <div class="field">
                <div class="ui icon input">
                    <input type="text" name="search" placeholder="{{ 'prescription.list.search_placeholder'|trans }}" value="{{ searchTerm ?? '' }}">
                    <i class="search icon"></i>
                </div>
            </div>
        </form>

        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>{{ 'prescription.list.table.id'|trans }}</th>
                    <th>{{ 'prescription.list.table.patient'|trans }}</th>
                    <th>{{ 'prescription.list.table.doctor'|trans }}</th>
                    <th>{{ 'prescription.list.table.issue_date'|trans }}</th>
                    <th>{{ 'prescription.list.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for prescription in prescriptions %}
                    <tr>
                        <td>{{ prescription.id }}</td>
                        <td>{{ prescription.patient_name }}</td>
                        <td>{{ prescription.doctor_name }}</td>
                        <td>{{ prescription.issue_date|date('Y-m-d') }}</td>
                        <td>
                            <a href="/prescriptions/show?id={{ prescription.id }}" class="ui icon button">
                                <i class="eye icon"></i>
                            </a>
                            <a href="/prescriptions/edit?id={{ prescription.id }}" class="ui icon button">
                                <i class="edit icon"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="center aligned">{{ 'prescription.list.no_prescriptions'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
