{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Кімната #{{ room.id }} - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="sixteen wide column">
                <h2 class="ui header">Кімната #{{ room.id }}</h2>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td><strong>Тип кімнати</strong></td>
                    <td>{{ room.type }}</td>
                </tr>
                <tr>
                    <td><strong>Місткість</strong></td>
                    <td>{{ room.capacity }} осіб</td>
                </tr>
                {% if room.location %}
                <tr>
                    <td><strong>Розташування</strong></td>
                    <td>{{ room.location }}</td>
                </tr>
                {% endif %}
                {% if room.equipment %}
                <tr>
                    <td><strong>Обладнання</strong></td>
                    <td>{{ room.equipment|nl2br }}</td>
                </tr>
                {% endif %}
                <tr>
                    <td><strong>Статус</strong></td>
                    <td>
                        {% if room.is_available %}
                            <span class="ui green label">Доступна</span>
                        {% else %}
                            <span class="ui red label">Недоступна</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>
        
        <a href="/admin/rooms/edit?id={{ room.id }}" class="ui primary button">
            <i class="edit icon"></i> Редагувати
        </a>
        <a href="/admin/rooms" class="ui button">
            <i class="arrow left icon"></i> Повернутись
        </a>
    </div>
{% endblock %}