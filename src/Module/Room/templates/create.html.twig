{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Додати нову кімнату - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Додати нову кімнату</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/admin/rooms/new">
            {{ forms.input('name', 'Назва кімнати', old.name ?? null, 'text', 'Назва кімнати', errors.name ?? null, {'required': 'required'}) }}
            {{ forms.input('type', 'Тип кімнати', old.type ?? null, 'text', 'Напр: кабінет, операційна, лабораторія', errors.type ?? null, {'required': 'required'}) }}
            <div class="two fields">
                {{ forms.input('capacity', 'Місткість', old.capacity ?? null, 'number', 'Кількість місць', errors.capacity ?? null, {'required': 'required', 'min': '1'}) }}
                {{ forms.input('location', 'Розташування', old.location ?? null, 'text', 'Поверх, номер', errors.location ?? null) }}
            </div>
            {{ forms.textarea('equipment', 'Обладнання', old.equipment ?? null, 'Перелік обладнання в кімнаті', errors.equipment ?? null) }}
            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_available" {{ old.is_available is defined and old.is_available == 0 ? '' : 'checked' }}>
                    <label>Доступна для бронювання</label>
                </div>
            </div>

            {{ ui.button('Зберегти кімнату', 'primary', 'large', 'save') }}
            <a href="/admin/rooms" class="ui button"><i class="arrow left icon"></i> Скасувати</a>
        </form>
    </div>
{% endblock %}