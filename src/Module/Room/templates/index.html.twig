{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Кімнати - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">Список кімнат</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="/admin/rooms/new" class="ui primary button">
                    <i class="plus icon"></i> Додати кімнату
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        <table class="ui celled unstackable table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Назва</th>
                    <th>Тип</th>
                    <th>Місткість</th>
                    <th>Розташування</th>
                    <th>Доступна</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                {% for room in rooms %}
                    <tr>
                        <td>{{ room.id }}</td>
                        <td>{{ room.name }}</td>
                        <td>{{ room.type }}</td>
                        <td>{{ room.capacity }}</td>
                        <td>{{ room.location ?? '-' }}</td>
                        <td>
                            {% if room.is_available %}
                                <i class="check icon green"></i> Так
                            {% else %}
                                <i class="times icon red"></i> Ні
                            {% endif %}
                        </td>
                        <td>
                            <a href="/admin/rooms/show?id={{ room.id }}" class="ui icon button">
                                <i class="eye icon"></i>
                            </a>
                            <a href="/admin/rooms/edit?id={{ room.id }}" class="ui icon button">
                                <i class="edit icon"></i>
                            </a>
                            <form action="/admin/rooms/delete" method="POST" style="display: inline;" onsubmit="return confirm('Ви впевнені, що хочете видалити цю кімнату?');">
                                <input type="hidden" name="id" value="{{ room.id }}">
                                <button type="submit" class="ui icon button red">
                                    <i class="trash icon"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="center aligned">Немає кімнат для відображення.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}