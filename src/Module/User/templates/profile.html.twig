{% extends "layouts/base.html.twig" %}

{% block title %}Мій профіль - Клініка{% endblock %}

{% block body %}
    <div class="ui segments">
        <div class="ui segment">
            <h1 class="ui header">Мій профіль</h1>
        </div>
        <div class="ui secondary segment">
            {% if successMessage %}
                <div class="ui success message" data-flash="success">
                    <i class="close icon"></i>
                    <div class="header">Успіх!</div>
                    <p>{{ successMessage }}</p>
                </div>
            {% endif %}
            {% if session.error_message %}
                <div class="ui error message" data-flash="error">
                    <i class="close icon"></i>
                    <div class="header">Помилка!</div>
                    <p>{{ session.error_message }}</p>
                </div>
                {% set _ = session.error_message is null %}
            {% endif %}

            <div class="ui grid">
                <div class="four wide column">
                    {% if user.profile_photo_path %}
                        <img class="ui medium circular image" src="{{ user.profile_photo_path }}" style="object-fit: cover; aspect-ratio: 1 / 1;" alt="Профільне фото">
                    {% else %}
                        <img class="ui medium circular image" src="/assets/images/default_user.png" alt="Профільне фото">
                    {% endif %}
                    <form action="/user/profile/upload-photo" method="POST" enctype="multipart/form-data" class="ui form" style="margin-top: 15px;">
                        <div class="field">
                            <label>Змінити фото</label>
                            <div class="ui action input">
                                <input type="text" id="photo-display" readonly placeholder="Файл не обрано">
                                <label for="photo-upload" class="ui icon button"><i class="upload icon"></i></label>
                            </div>
                            <input type="file" id="photo-upload" name="profile_photo" style="display: none;" accept="image/*">
                        </div>
                        <button type="submit" class="ui primary button">Завантажити</button>
                    </form>
                </div>
                <div class="twelve wide column">
                    <div class="ui list">
                        <div class="item">
                            <i class="user icon"></i>
                            <div class="content">
                                <strong>Ім'я:</strong> {{ user.first_name }} {{ user.last_name }}
                            </div>
                        </div>
                        <div class="item">
                            <i class="envelope icon"></i>
                            <div class="content">
                                <strong>Email:</strong> {{ user.email }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if employee %}
                <div class="ui divider"></div>
                <h2 class="ui header">Інформація про співробітника</h2>
                <div class="ui list">
                    <div class="item">
                        <i class="briefcase icon"></i>
                        <div class="content">
                            <strong>Посада:</strong> {{ employee.position }}
                        </div>
                    </div>
                    <div class="item">
                        <i class="building icon"></i>
                        <div class="content">
                            <strong>Департамент:</strong> {{ employee.department|default('N/A') }}
                        </div>
                    </div>
                    <div class="item">
                        <i class="calendar alternate outline icon"></i>
                        <div class="content">
                            <strong>Дата найму:</strong> {{ employee.hire_date }}
                        </div>
                    </div>
                    <div class="item">
                        <i class="info circle icon"></i>
                        <div class="content">
                            <strong>Статус:</strong> {{ employee.status }}
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="ui divider"></div>

            <h2 class="ui header">Двофакторна автентифікація (2FA)</h2>

            {% set mfaStatus = {
                enabled: user.mfa_enabled,
                type: user.mfa_type,
                verified_at: user.mfa_verified_at
            } %}

            {% if mfaStatus.enabled %}
                <div class="ui success message">
                    <i class="check circle icon"></i>
                    <div class="content">
                        <div class="header">2FA увімкнено</div>
                        <p>Тип: {{ mfaStatus.type|upper }} | Увімкнено: {{ user.mfa_verified_at|date('d.m.Y H:i') }}</p>
                    </div>
                </div>

                <div class="ui buttons">
                    <a href="/user/mfa/setup?reset=1" class="ui button">Переналаштувати 2FA</a>
                    <div class="or" data-text="або"></div>
                    <button type="button" class="ui red button" onclick="showDisableMfaModal()">Вимкнути 2FA</button>
                </div>

                <div class="ui divider"></div>

                <h3 class="ui header">Коди відновлення</h3>
                <p style="margin-bottom: 1rem;">Коди відновлення використовуються для входу, якщо ви втратите доступ до додатку автентифікатора.</p>

                {% if session.new_backup_codes %}
                    <div class="ui success message">
                        <i class="check circle icon"></i>
                        <div class="header">Коди оновлено!</div>
                        <p>Збережіть нові коди. Старі коди більше не діють.</p>
                    </div>

                    <div class="ui segment" style="background-color: #f8f9fa; margin-bottom: 1rem;">
                        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                            {% for code in session.new_backup_codes %}
                                <code style="padding: 8px 12px; background: #fff; border: 1px solid #ddd; border-radius: 4px; font-size: 14px;">{{ code }}</code>
                            {% endfor %}
                        </div>
                    </div>

                    <a href="/user/mfa/clear-backup-codes" class="ui primary button">Зрозуміло</a>

                    <div class="ui divider"></div>
                {% endif %}

                <form action="/user/mfa/regenerate-backup-codes" method="POST" onsubmit="return confirm('Ви впевнені, що хочете згенерувати нові коди відновлення? Старі коди перестануть працювати.');">
                    <div class="ui form">
                        <div class="required field">
                            <label for="mfa-password">Введіть пароль для підтвердження</label>
                            <input type="password" id="mfa-password" name="password" placeholder="Ваш пароль" required>
                        </div>
                        <button type="submit" class="ui yellow button">
                            <i class="refresh icon"></i>
                            Оновити коди
                        </button>
                    </div>
                </form>
            {% else %}
                <div class="ui warning message">
                    <i class="exclamation triangle icon"></i>
                    <div class="content">
                        <div class="header">2FA не увімкнено</div>
                        <p>Рекомендуємо увімкнути двофакторну автентифікацію для захисту вашого акаунту.</p>
                    </div>
                </div>

                <div class="ui cards" style="margin-top: 1rem;">
                    <div class="card" style="width: 48%; display: inline-block; vertical-align: top;">
                        <div class="content">
                            <div class="header"><i class="clock icon"></i> TOTP</div>
                            <div class="description">
                                <p>На основі часу. Код змінюється кожні 30 секунд.</p>
                                <p><strong>Найпоширеніший варіант</strong> - сумісний з Google Authenticator, Authy, 1Password.</p>
                            </div>
                        </div>
                        <div class="extra content">
                            <a href="/user/mfa/setup" class="ui primary fluid button">
                                <i class="shield icon"></i>
                                Увімкнути TOTP
                            </a>
                        </div>
                    </div>

                    <div class="card" style="width: 48%; display: inline-block; vertical-align: top;">
                        <div class="content">
                            <div class="header"><i class="hashtag icon"></i> HOTP</div>
                            <div class="description">
                                <p>На основі лічильника. Новий код генерується при кожному запиті.</p>
                                <p><strong>Спеціальний варіант</strong> - не залежить від часу, підходить для офлайн сценаріїв.</p>
                            </div>
                        </div>
                        <div class="extra content">
                            <a href="/user/mfa/hotp/setup" class="ui primary fluid button">
                                <i class="shield icon"></i>
                                Увімкнути HOTP
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="ui divider"></div>

            <h2 class="ui header">Зв'язані акаунти</h2>
            <div class="ui relaxed divided list">
                {% for config in authConfigs %}
                    <div class="item">
                        <div class="right floated content">
                            {% if config.provider in linkedProviders %}
                                <form action="/user/profile/unlink-provider/{{ config.provider }}" method="POST" onsubmit="return confirm('Ви впевнені, що хочете відв\'язати свій {{ config.provider|capitalize }} акаунт?');">
                                    <button type="submit" class="ui small red button">Відв'язати</button>
                                </form>
                            {% else %}
                                <a href="/oauth/redirect/{{ config.provider }}" class="ui button {{ config.provider }}">
                                    <i class="{{ config.provider }} icon"></i>
                                    Прив'язати {{ config.provider|capitalize }}
                                </a>
                            {% endif %}
                        </div>
                        <i class="large {{ config.provider }} middle aligned icon"></i>
                        <div class="content">
                            <div class="header">{{ config.provider|capitalize }}</div>
                            <div class="description">
                                {% if config.provider in linkedProviders %}
                                    Акаунт прив'язано
                                {% else %}
                                    Не прив'язано
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p>Немає доступних провайдерів для прив'язки.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {% if mfaStatus.enabled %}
    <div class="ui small modal" id="disable-mfa-modal">
        <div class="header">
            <i class="shield alternate red icon"></i>
            Вимкнути двофакторну автентифікацію
        </div>
        <div class="content">
            <div class="ui warning message">
                <div class="header">Увага!</div>
                <p>Після вимкнення 2FA ваш акаунт буде менш захищений.</p>
            </div>
            <form action="/user/mfa/disable" method="POST" id="disable-mfa-form">
                <div class="ui form">
                    <div class="required field">
                        <label>Введіть ваш пароль для підтвердження</label>
                        <div class="ui input">
                            <input type="password" name="password" placeholder="Ваш пароль" required autofocus>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="actions">
            <div class="ui black deny button">Скасувати</div>
            <div class="ui red deny button" form="disable-mfa-form" onclick="document.getElementById('disable-mfa-form').submit()">
                <i class="shield icon"></i>
                Вимкнути 2FA
            </div>
        </div>
    </div>
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Script for file upload button
            const fileInput = document.getElementById('photo-upload');
            const displayInput = document.getElementById('photo-display');

            if (fileInput && displayInput) {
                fileInput.addEventListener('change', function() {
                    if (fileInput.files.length > 0) {
                        displayInput.value = fileInput.files[0].name;
                    } else {
                        displayInput.value = 'Файл не обрано';
                    }
                });
            }

            // Script to dismiss messages
            $('.message .close').on('click', function() {
                $(this).closest('.message').transition({
                    animation: 'fade',
                    duration: 300,
                    onComplete: function() {
                        $(this).remove();
                    }
                });
                fetch('/user/clear-messages', {method: 'POST'});
            });

            // Auto-hide flash messages after 5 seconds
            var flashMessages = document.querySelectorAll('[data-flash]');
            if (flashMessages.length > 0) {
                setTimeout(function() {
                    flashMessages.forEach(function(el) {
                        $(el).transition({
                            animation: 'fade',
                            duration: 300,
                            onComplete: function() {
                                $(el).remove();
                            }
                        });
                    });
                    fetch('/user/clear-messages', {method: 'POST'});
                }, 5000);
            }

            // Initialize Semantic UI modal
            $('#disable-mfa-modal').modal({
                closable: true,
                duration: 300,
                transition: 'scale'
            });
        });

        function showDisableMfaModal() {
            $('#disable-mfa-modal').modal('show');
        }
    </script>
{% endblock %}