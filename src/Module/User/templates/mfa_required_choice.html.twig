{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'user.mfa.mfa_required_choice.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segments">
        <div class="ui segment">
            <h1 class="ui header">{{ 'user.mfa.mfa_required_choice.header'|trans }}</h1>
        </div>
        <div class="ui segment">
            <div class="ui warning message">
                <div class="header">{{ 'user.mfa.mfa_required_choice.security_requirement_header'|trans }}</div>
                <p>{{ 'user.mfa.mfa_required_choice.security_requirement_message'|trans }}</p>
            </div>

            <div class="ui two stackable cards">
                <div class="card">
                    <div class="content">
                        <div class="header"><i class="clock icon"></i> {{ 'user.mfa.mfa_required_choice.totp_header'|trans }}</div>
                        <div class="description">
                            <p>{{ 'user.mfa.mfa_required_choice.totp_description'|trans }}</p>
                            <p style="color: #666;">{{ 'user.mfa.mfa_required_choice.totp_compatible'|trans }}</p>
                        </div>
                    </div>
                    <div class="extra content">
                        <a href="/user/mfa/required/totp" class="ui primary fluid button">{{ 'user.mfa.mfa_required_choice.totp_button'|trans }}</a>
                    </div>
                </div>

                <div class="card">
                    <div class="content">
                        <div class="header"><i class="hashtag icon"></i> {{ 'user.mfa.mfa_required_choice.hotp_header'|trans }}</div>
                        <div class="description">
                            <p>{{ 'user.mfa.mfa_required_choice.hotp_description'|trans }}</p>
                            <p style="color: #666;">{{ 'user.mfa.mfa_required_choice.hotp_compatible'|trans }}</p>
                        </div>
                    </div>
                    <div class="extra content">
                        <a href="/user/mfa/required/hotp" class="ui primary fluid button">{{ 'user.mfa.mfa_required_choice.hotp_button'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
