{% extends "layouts/base.html.twig" %}

{% block title %}Обов'язкове налаштування 2FA - Клініка{% endblock %}

{% block body %}
    <div class="ui segments">
        <div class="ui segment">
            <h1 class="ui header">Обов'язкове налаштування двофакторної автентифікації</h1>
        </div>
        <div class="ui secondary segment">
            <div class="ui warning message">
                <div class="header">Вимога безпеки</div>
                <p>Двофакторна автентифікація обов'язкова для вашої ролі. Оберіть метод 2FA для налаштування:</p>
            </div>

            <div class="ui two column stackable grid" style="margin-top: 1.5rem;">
                <div class="column">
                    <div class="ui card">
                        <div class="content">
                            <div class="header"><i class="clock icon"></i> TOTP (Time-based)</div>
                            <div class="meta">На основі часу</div>
                            <div class="description">
                                <p>Код змінюється кожні 30 секунд.</p>
                                <ul style="list-style-type: disc; margin-left: 1.5rem;">
                                    <li>Найпоширеніший варіант</li>
                                    <li>Сумісний з Google Authenticator, Authy, 1Password</li>
                                    <li>Автоматична синхронізація часу</li>
                                </ul>
                            </div>
                        </div>
                        <div class="extra content">
                            <a href="/user/mfa/required/totp" class="ui primary fluid button">
                                <i class="shield icon"></i>
                                Обрати TOTP
                            </a>
                        </div>
                    </div>
                </div>

                <div class="column">
                    <div class="ui card">
                        <div class="content">
                            <div class="header"><i class="hashtag icon"></i> HOTP (Counter-based)</div>
                            <div class="meta">На основі лічильника</div>
                            <div class="description">
                                <p>Новий код генерується при кожному запиті.</p>
                                <ul style="list-style-type: disc; margin-left: 1.5rem;">
                                    <li>Не залежить від синхронізації часу</li>
                                    <li>Підходить для офлайн сценаріїв</li>
                                    <li>Менша ймовірність помилок синхронізації</li>
                                </ul>
                            </div>
                        </div>
                        <div class="extra content">
                            <a href="/user/mfa/required/hotp" class="ui primary fluid button">
                                <i class="shield icon"></i>
                                Обрати HOTP
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
