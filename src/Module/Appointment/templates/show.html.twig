{% extends "layouts/base.html.twig" %}

{% block title %}{{ 'appointment.show.title'|trans({'%id%': appointment.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'appointment.show.title_full'|trans({'%id%': appointment.id}) }}</h2>
        <div class="ui divider"></div>

        <table class="ui unstackable definition table">
            <tbody>
                <tr>
                    <td>{{ 'appointment.show.table.id'|trans }}</td>
                    <td>{{ appointment.id }}</td>
                </tr>
                <tr>
                    <td>{{ 'appointment.show.table.patient'|trans }}</td>
                    <td><a href="/patients/show?id={{ appointment.patient_id }}">{{ appointment.patient_name }}</a></td>
                </tr>
                <tr>
                    <td>{{ 'appointment.show.table.doctor'|trans }}</td>
                    <td>{{ appointment.doctor_name }}</td>
                </tr>
                <tr>
                    <td>{{ 'appointment.show.table.start_time'|trans }}</td>
                    <td>{{ appointment.start_time|date('Y-m-d H:i') }}</td>
                </tr>
                <tr>
                    <td>{{ 'appointment.show.table.end_time'|trans }}</td>
                    <td>{{ appointment.end_time|date('Y-m-d H:i') }}</td>
                </tr>
                <tr>
                    <td>{{ 'appointment.show.table.status'|trans }}</td>
                    <td>{{ appointment.status }}</td>
                </tr>
                <tr>
                    <td>{{ 'appointment.show.table.notes'|trans }}</td>
                    <td>{{ appointment.notes|nl2br|default('—') }}</td>
                </tr>
            </tbody>
        </table>

        <div class="ui divider"></div>

        <a href="/appointments/edit?id={{ appointment.id }}" class="ui primary button">
            <i class="edit icon"></i> {{ 'appointment.show.edit'|trans }}
        </a>
        {% if appointment.status == 'scheduled' %}
            <a href="/medical-records/new?appointment_id={{ appointment.id }}" class="ui green button">{{ 'appointment.show.create_medical_record'|trans }}</a>
            <form action="/appointments/cancel" method="POST" style="display: inline;">
                <input type="hidden" name="id" value="{{ appointment.id }}">
                <button type="submit" class="ui negative button">{{ 'appointment.show.cancel'|trans }}</button>
            </form>
        {% endif %}
        <a href="/appointments" class="ui button">
            <i class="arrow left icon"></i> {{ 'appointment.show.back'|trans }}
        </a>
    </div>
{% endblock %}
