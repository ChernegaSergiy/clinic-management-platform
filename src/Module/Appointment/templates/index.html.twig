{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Календар записів - Клініка{% endblock %}

{% block body %}
    <div class="ui segment">
        <div class="ui grid">
            <div class="eight wide column">
                <h2 class="ui header">Календар записів</h2>
            </div>
            <div class="eight wide column right aligned">
                <a href="/appointments/waitlist" class="ui orange button" style="margin-right: 0.5rem;">
                    <i class="list icon"></i> Заявки ({{ waitlist|length }})
                </a>
                <a href="/appointments/new" class="ui primary button">
                    <i class="plus icon"></i> Створити запис
                </a>
            </div>
        </div>

        <div class="ui divider"></div>

        <div id='calendar'></div>

        <div class="ui divider"></div>
        <h3 class="ui header">Легенда</h3>
        <div class="ui labels">
            <div class="ui header">Статуси записів:</div>
            <a class="ui label blue">Заплановано</a>
            <a class="ui label green">Виконано</a>
            <a class="ui label red">Скасовано</a>
            <a class="ui label yellow">Не з'явився</a>
            <a class="ui label grey">Інше</a>
        </div>
        <div class="ui labels" style="margin-top: 10px;">
            <div class="ui header">Типи ресурсів:</div>
            <a class="ui label">👨‍⚕️ Лікарі</a>
            <a class="ui label">🏥 Кімнати</a>
        </div>

        <div class="ui segment">
            <h3 class="ui header">Список записів</h3>
                <table class="ui celled unstackable table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Пацієнт</th>
                            <th>Лікар</th>
                            <th>Початок</th>
                            <th>Статус</th>
                            <th>Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for appt in appointments %}
                            <tr>
                                <td>{{ appt.id }}</td>
                                <td>{{ appt.patient_name }}</td>
                                <td>{{ appt.doctor_name }}</td>
                                <td>{{ appt.start_time|date('Y-m-d H:i') }}</td>
                                <td>{{ appt.status }}</td>
                                <td>
                                    <a class="ui tiny button" href="/appointments/show?id={{ appt.id }}">Переглянути</a>
                                    <a class="ui tiny primary button" href="/appointments/edit?id={{ appt.id }}">Редагувати</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="center aligned">Немає записів.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar-scheduler@6.1.15/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            
            // Load rooms via API
            fetch('/api/calendar/rooms')
                .then(response => response.json())
                .then(rooms => {
                    // Combine doctors and rooms as resources
                    var doctorResources = {{ doctors|map(d => {'id': d.id, 'title': d.title, 'type': 'doctor'})|json_encode|raw }} || [];
                    var roomResources = rooms || [];
                    var allResources = doctorResources.concat(roomResources);
                    
                    var calendar = new FullCalendar.Calendar(calendarEl, {
                        schedulerLicenseKey: 'CC-Attribution-NonCommercial-NoDerivatives',
                        initialView: 'resourceTimelineDay',
                        headerToolbar: {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'resourceTimelineDay,resourceTimelineWeek,resourceTimelineMonth'
                        },
                        resourceAreaHeaderContent: 'Ресурси',
                        resources: allResources,
                        events: '/api/appointments',
                        resourceLabelContent: function(arg) {
                            var resource = arg.resource;
                            var typeIcon = resource.extendedProps.type === 'room' ? '🏥' : '👨‍⚕️';
                            return typeIcon + ' ' + resource.title;
                        },
                        resourceGroupField: 'type',
                        resourceAreaWidth: '250px'
                    });
                    calendar.render();
                })
                .catch(error => console.error('Error loading rooms:', error));
        });
    </script>
{% endblock %}
