{% extends "layouts/base.html.twig" %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'appointment.analytics.title'|trans }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'appointment.analytics.header'|trans }}</h2>

        <div class="ui divider"></div>

        <form class="ui form" action="/appointments/analytics" method="GET">
            <div class="field">
                <label>{{ 'appointment.analytics.date_label'|trans }}</label>
                <input type="date" name="date" value="{{ date }}">
            </div>
            <button class="ui primary button" type="submit">{{ 'appointment.analytics.show_button'|trans }}</button>
        </form>

        <div class="ui divider"></div>

        <h3 class="ui header">{{ 'appointment.analytics.subheader'|trans({'%date%': date}) }}</h3>
        {% if doctorLoad is empty %}
            <p>{{ 'appointment.analytics.no_data'|trans }}</p>
        {% else %}
            <table class="ui celled unstackable table">
                <thead>
                    <tr>
                        <th>{{ 'appointment.analytics.table.doctor'|trans }}</th>
                        <th>{{ 'appointment.analytics.table.total_appointments'|trans }}</th>
                        <th>{{ 'appointment.analytics.table.total_hours_booked'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in doctorLoad %}
                        <tr>
                            <td>{{ entry.doctor_name }}</td>
                            <td>{{ entry.total_appointments }}</td>
                            <td>{{ entry.total_hours_booked | number_format(2) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
