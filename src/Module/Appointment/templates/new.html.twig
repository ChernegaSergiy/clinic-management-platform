{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}Створити Запис{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">Створити новий запис</h2>
        <div class="ui divider"></div>

        <form class="ui form" method="POST" action="/appointments/new">
            {% if old.waitlist_id %}
                <input type="hidden" name="waitlist_id" value="{{ old.waitlist_id }}">
            {% endif %}

            {# Filters for finding slots #}
            <h4 class="ui dividing header">1. Оберіть параметри для пошуку</h4>
            <div class="three fields">
                {{ forms.select('doctor_id', 'Лікар', doctors, old.doctor_id ?? null, errors.doctor_id ?? null, {'id': 'doctor_selector', 'required': 'required'}) }}
                {{ forms.select('service_id', 'Послуга', services, old.service_id ?? null, errors.service_id ?? null, {'id': 'service_selector', 'required': 'required'}) }}
                {{ forms.input('date', 'Дата', old.date ?? selectedDate, 'date', '', errors.date ?? null, {'id': 'date_selector', 'required': 'required'}) }}
            </div>
            
            <div id="slot-loader" class="ui active inverted dimmer" style="display: none;">
                <div class="ui text loader">Завантаження...</div>
            </div>
            
            <div id="slots-container" class="field" style="margin-top: 2rem;">
                {# Slots will be loaded here via AJAX #}
            </div>
            
            <div class="ui hidden divider"></div>

            {# Patient and notes #}
            <h4 class="ui dividing header">2. Оберіть пацієнта та час</h4>

            {# Hidden fields for selected slot times #}
            <input type="hidden" name="start_time" id="start_time_hidden" value="{{ old.start_time ?? '' }}">
            <input type="hidden" name="end_time" id="end_time_hidden" value="{{ old.end_time ?? '' }}">

            <div class="two fields">
                {{ forms.select('patient_id', 'Пацієнт', patients, old.patient_id ?? null, errors.patient_id ?? null, {'required': 'required'}) }}
                <div class="field">
                    <label>Обраний час</label>
                    <input type="text" id="selected_slot_display" readonly placeholder="Оберіть годину зі списку вище">
                 </div>
            </div>
            
            {{ forms.textarea('notes', 'Примітки', old.notes ?? null, 'Додаткові примітки до запису') }}

            <div style="margin-top: 2rem;">
                {{ ui.button('Зберегти запис', 'primary', 'large', 'save', { 'type': 'submit', 'id': 'save-button', 'class': 'disabled' }) }}
                <a href="/appointments" class="ui button">Скасувати</a>
            </div>

        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            const doctorField = $('#doctor_id');
            const serviceField = $('#service_id');
            const dateField = $('#date');
            const slotsContainer = $('#slots-container');
            const slotLoader = $('#slot-loader');
            const saveButton = $('#save-button');
            const selectedSlotDisplay = $('#selected_slot_display');
            const startTimeHidden = $('#start_time_hidden');
            const endTimeHidden = $('#end_time_hidden');

// Store services data to get duration on the fly
            const servicesData = {
                {% for service in servicesForJs %}
                    "{{ service.id }}": { duration: {{ service.duration_minutes }} }
                    {% if not loop.last %},{% endif %}
                {% endfor %}
            };

            function fetchAvailableSlots() {
                const doctorId = $('#doctor_id').dropdown('get value');
                const serviceId = $('#service_id').dropdown('get value');
                const date = $('#date').val();

                

                if (!doctorId || !serviceId || !date) {
                    slotsContainer.html('<div class="ui message"><p>Будь ласка, оберіть лікаря, послугу та дату для пошуку вільних годин.</p></div>');
                    return;
                }

                slotLoader.show();
                slotsContainer.empty();
                resetSelection();

                $.ajax({
                    url: '/api/appointments/available-slots',
                    data: {
                        doctor_id: doctorId,
                        service_id: serviceId,
                        date: date
                    },
                    success: function(slots) {
                        slotLoader.hide();
                        if (slots.length > 0) {
                            let content = '<label>Доступні години на ' + new Date(date + 'T00:00:00').toLocaleDateString() + '</label>';
                            content += '<div class="ui five column grid">';
                            slots.forEach(function(slot) {
                                let buttonClass = 'ui basic button slot-button';
                                if (!slot.available) {
                                    buttonClass += ' disabled';
                                }
                                if (slot.is_in_past) {
                                    buttonClass += ' grey';
                                } else if (slot.is_booked) {
                                    buttonClass += ' red';
                                }
                                content += '<div class="column"><button class="' + buttonClass + '" data-slot-time="' + slot.value + '" data-available="' + slot.available + '">' + slot.label + '</button></div>';
                            });
                            content += '</div>';
                             if (slots.length > 15) { // Add a tip for many slots
                                content += '<div class="ui mini message" style="margin-top:1em;">Порада: доступно багато годин, скористайтесь прокруткою, щоб побачити всі.</div>';
                            }
                            slotsContainer.html(content);
                        } else {
                            slotsContainer.html('<div class="ui warning message"><p>На жаль, на обрану дату немає вільних годин. Спробуйте обрати інший день, лікаря або послугу.</p></div>');
                        }
                    },
                    error: function() {
                        slotLoader.hide();
                        slotsContainer.html('<div class="ui negative message"><p>Помилка при завантаженні годин. Спробуйте оновити сторінку.</p></div>');
                    }
                });
            }
            
            function resetSelection() {
                selectedSlotDisplay.val('');
                startTimeHidden.val('');
                endTimeHidden.val('');
                saveButton.addClass('disabled');
            }

            // Initialize dropdowns and bind events
            $('#doctor_id').dropdown({
                onChange: fetchAvailableSlots
            });
            $('#service_id').dropdown({
                onChange: fetchAvailableSlots
            });
            dateField.on('change', fetchAvailableSlots);

            // Event delegation for dynamically added slot buttons
            $(document).on('click', '.slot-button', function(e) {
                e.preventDefault();
                
                const isAvailable = $(this).data('available');
                if (isAvailable === false || isAvailable === 'false') {
                    return; // Don't allow selection of unavailable slots
                }
                
                const startTimeStr = $(this).data('slot-time');
                const serviceId = serviceField.val();

                if (!serviceId || !servicesData[serviceId]) {
                    alert('Please select a service first.');
                    return;
                }
                const duration = servicesData[serviceId].duration;
                const startTime = new Date(startTimeStr.replace(/-/g, "/"));
                let endTime = new Date(startTime.getTime() + duration * 60000);

                const formatForHidden = (date) => {
                    const pad = (num) => num.toString().padStart(2, '0');
                    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
                };

                startTimeHidden.val(formatForHidden(startTime));
                endTimeHidden.val(formatForHidden(endTime));

                selectedSlotDisplay.val(startTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));

                $('.slot-button').removeClass('primary');
                $(this).addClass('primary');

                saveButton.removeClass('disabled');
            });
            
            // Initial fetch if data is pre-filled
            if ($('#doctor_id').dropdown('get value') && $('#service_id').dropdown('get value') && dateField.val()) {
                fetchAvailableSlots();
            } else {
                slotsContainer.html('<div class="ui message"><p>Будь ласка, оберіть лікаря для пошуку вільних годин.</p></div>');
            }
        });
    </script>
{% endblock %}