{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'kpi.definitions.edit.title'|trans({'%id%': definition.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'kpi.definitions.edit.title_full'|trans({'%id%': definition.id}) }}</h2>
        <div class="ui divider"></div>

        {% set kpi_options = {
            'revenue_generated': 'kpi.definitions.edit.kpi_types.revenue_generated'|trans,
            'appointments_count': 'kpi.definitions.edit.kpi_types.appointments_count'|trans,
            'doctor_utilization': 'kpi.definitions.edit.kpi_types.doctor_utilization'|trans,
            'readmission_rate': 'kpi.definitions.edit.kpi_types.readmission_rate'|trans,
            'patient_satisfaction': 'kpi.definitions.edit.kpi_types.patient_satisfaction'|trans,
            'custom': 'kpi.definitions.edit.kpi_types.custom'|trans
        } %}
        {% set selected_type = old.kpi_type ?? definition.kpi_type %}
        {% if selected_type is not empty and (selected_type not in kpi_options|keys) %}
            {% set kpi_options = kpi_options|merge({ (selected_type): selected_type ~ ' (custom)' }) %}
        {% endif %}

        {% set period_options = {
            'day': 'kpi.definitions.edit.periods.day'|trans,
            'week': 'kpi.definitions.edit.periods.week'|trans,
            'month': 'kpi.definitions.edit.periods.month'|trans
        } %}
        {% set selected_period = old.period ?? definition.period ?? 'day' %}

        <form class="ui form" method="POST" action="/kpi/definitions/edit?id={{ definition.id }}">
            {{ forms.input('name', 'Назва', old.name ?? definition.name, 'text', 'Наприклад, Patient Wait Time', errors.name ?? null, {'required': 'required'}) }}
            {{ forms.textarea('description', 'Опис', old.description ?? definition.description, 'Детальний опис KPI', errors.description ?? null) }}
            {{ forms.select('kpi_type', 'Тип KPI', kpi_options, selected_type, errors.kpi_type ?? null, {'required': 'required'}) }}
            {{ forms.select('period', 'Період розрахунку', period_options, selected_period, errors.period ?? null, {'required': 'required'}) }}
            {{ forms.input('target_value', 'Цільове значення', old.target_value ?? definition.target_value, 'text', 'Наприклад, 15, 95%, 100', errors.target_value ?? null) }}
            {{ forms.input('unit', 'Одиниця виміру', old.unit ?? definition.unit, 'text', 'Наприклад, minutes, %, patients', errors.unit ?? null) }}

            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_active" {% if (old.is_active is defined and old.is_active) or (old.is_active is not defined and definition.is_active) %}checked{% endif %} value="1">
                    <label>Активне визначення</label>
                </div>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('Зберегти зміни', 'primary', '', 'save') }}
            <a href="/kpi/definitions" class="ui button"><i class="arrow left icon"></i> Скасувати</a>
        </form>
    </div>
{% endblock %}
