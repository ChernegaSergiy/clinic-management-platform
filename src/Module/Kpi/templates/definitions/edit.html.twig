{% extends "layouts/base.html.twig" %}
{% import "components/forms.html.twig" as forms %}
{% import "components/ui.html.twig" as ui %}

{% block title %}{{ 'kpi.definitions.edit.title'|trans({'%id%': definition.id}) }}{% endblock %}

{% block body %}
    <div class="ui segment">
        <h2 class="ui header">{{ 'kpi.definitions.edit.title_full'|trans({'%id%': definition.id}) }}</h2>
        <div class="ui divider"></div>

        {% set kpi_options = {
            'revenue_generated': 'kpi.definitions.edit.kpi_types.revenue_generated'|trans,
            'appointments_count': 'kpi.definitions.edit.kpi_types.appointments_count'|trans,
            'doctor_utilization': 'kpi.definitions.edit.kpi_types.doctor_utilization'|trans,
            'readmission_rate': 'kpi.definitions.edit.kpi_types.readmission_rate'|trans,
            'patient_satisfaction': 'kpi.definitions.edit.kpi_types.patient_satisfaction'|trans,
            'custom': 'kpi.definitions.edit.kpi_types.custom'|trans
        } %}
        {% set selected_type = old.kpi_type ?? definition.kpi_type %}
        {% if selected_type is not empty and (selected_type not in kpi_options|keys) %}
            {% set kpi_options = kpi_options|merge({ (selected_type): selected_type ~ ' (custom)' }) %}
        {% endif %}

        {% set period_options = {
            'day': 'kpi.definitions.edit.periods.day'|trans,
            'week': 'kpi.definitions.edit.periods.week'|trans,
            'month': 'kpi.definitions.edit.periods.month'|trans
        } %}
        {% set selected_period = old.period ?? definition.period ?? 'day' %}

        <form class="ui form" method="POST" action="/kpi/definitions/edit?id={{ definition.id }}">
            {{ forms.input('name', 'kpi.definitions.new.name'|trans, old.name ?? definition.name, 'text', 'kpi.definitions.new.name_placeholder'|trans, errors.name ?? null, {'required': 'required'}) }}
            {{ forms.textarea('description', 'kpi.definitions.new.description'|trans, old.description ?? definition.description, 'kpi.definitions.new.description_placeholder'|trans, errors.description ?? null) }}
            {{ forms.select('kpi_type', 'kpi.definitions.new.kpi_type'|trans, kpi_options, selected_type, errors.kpi_type ?? null, {'required': 'required'}) }}
            {{ forms.select('period', 'kpi.definitions.new.period'|trans, period_options, selected_period, errors.period ?? null, {'required': 'required'}) }}
            {{ forms.input('target_value', 'kpi.definitions.new.target_value'|trans, old.target_value ?? definition.target_value, 'text', 'kpi.definitions.new.target_value_placeholder'|trans, errors.target_value ?? null) }}
            {{ forms.input('unit', 'kpi.definitions.new.unit'|trans, old.unit ?? definition.unit, 'text', 'kpi.definitions.new.unit_placeholder'|trans, errors.unit ?? null) }}

            <div class="field">
                <div class="ui toggle checkbox">
                    <input type="checkbox" name="is_active" {% if (old.is_active is defined and old.is_active) or (old.is_active is not defined and definition.is_active) %}checked{% endif %} value="1">
                    <label>{{ 'kpi.definitions.new.is_active'|trans }}</label>
                </div>
            </div>
            <div class="ui divider"></div>

            {{ ui.button('kpi.definitions.edit.save'|trans, 'primary', '', 'save') }}
            <a href="/kpi/definitions" class="ui button"><i class="arrow left icon"></i> {{ 'kpi.definitions.edit.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}
